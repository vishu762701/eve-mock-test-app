rules_version = '2';

// EVE Mock Test App — Firestore Security Rules
//
// Access patterns & least privilege rules audited against actual Android client
// and Cloud Functions implementation.
//
// Highlights:
// - Questions/Exams: Signed-in students can read, only verified admins can write.
// - Attempt Locks: Safe read access for user/admin; client writes disabled.
// - Attempts: Client writes disabled (Cloud Function submitAttempt writes verified data);
//   users read only their own attempts, admins can read all.
// - Users: Users read/write only their own document; admins can read collection for stats.
// - Leaderboards & Analytics: Public read for signed-in users, client writes disabled.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return isSignedIn() && 'email' in request.auth.token ? request.auth.token.email.lower() : '';
    }

    // Must stay synchronized with Constants.kt ADMIN_EMAILS
    function isHardcodedAdmin() {
      return userEmail() in [
        'pronlike9@gmail.com',
        'own.keni@gmail.com',
        'anyqueairdrop@gmail.com',
        'ghatisarkar56@gmail.com'
      ];
    }

    // Dynamic Admins (documents in 'admins' collection are stored with lowercase email as ID)
    function isDynamicAdmin() {
      return userEmail() != '' &&
        exists(/databases/$(database)/documents/admins/$(userEmail()));
    }

    function isAdmin() {
      return isHardcodedAdmin() || isDynamicAdmin();
    }

    // Exams: signed-in users can browse; only admin can create, update, or delete
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Deterministic lock created by submitAttempt Cloud Function.
    // Safe null check prevents rule evaluation failure when checking unattempted tests.
    match /attempt_locks/{lockId} {
      allow read: if isSignedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Questions: signed-in users can read (mock tests, practice mode, PYQ); only admin can write.
    // Duplicate test submissions are prevented server-side by submitAttempt Cloud Function.
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // App Content (Privacy Policy, Terms of Service, Contact Us): signed-in read, admin write
    match /app_content/{contentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admins whitelist: signed-in users can read to verify admin status; only admin can add/remove
    match /admins/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Attempts: only submitAttempt Cloud Function (Admin SDK) writes verified results.
    // Students can read only their own attempts; admins can read any attempt.
    match /attempts/{attemptId} {
      allow create: if false;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // User profile & stats: users read/write their own document; admins read for analytics counters
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;

      // Pinned exams per user (Task 4)
      match /pinned_exams/{examId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Leaderboard (per-exam top scorers)
    match /leaderboard/{entryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Overall Leaderboard (aggregate across all exams)
    match /overall_leaderboard/{entryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Pre-aggregated exam analytics for Admin Dashboard
    match /admin_analytics_exams/{examId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Pre-aggregated question difficulty analytics for Admin Dashboard
    match /admin_analytics_questions/{questionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Notifications: all signed-in users can read, only admin can create/delete, no edits
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // AI Generated Tests: signed-in students can read live/published tests; admins can read all and manage status/delete
    match /generated_tests/{testId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.status in ["live", "published"]);
      allow write: if isAdmin();

      match /questions/{questionId} {
        allow read: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/generated_tests/$(testId)).data.status in ["live", "published"]);
        allow write: if isAdmin();
      }
    }

    // AI Generation Logs: admin-only read, client writes disabled (Cloud Functions write via Admin SDK)
    match /generation_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // System configuration (e.g. API key rotation state). Cloud Functions Admin SDK access only.
    match /system_config/{configId} {
      allow read, write: if false;
    }

    // Internal marker collection used only by Cloud Function triggers. No client access.
    match /admin_analytics_exam_users/{markerId} {
      allow read, write: if false;
    }

    // Community Polls: signed-in users can read; only admins can create, delete, or manage polls.
    // Signed-in users can only update voteCounts during an atomic vote submission.
    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCounts'])
      );

      // Single vote enforcement: user can only create their own vote doc once, never update or delete.
      match /votes/{uid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // Student Feedback Messages (Task 2): normal users create their own; only admins read/update/delete
    match /feedback_messages/{messageId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
