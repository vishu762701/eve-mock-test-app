<?xml version="1.0" encoding="utf-8"?>
<!-- Verification fixture; every component uses its production shared style. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp" android:background="@color/eve_canvas">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Eve · shared foundation" android:textAppearance="@style/TextAppearance.Eve.Title2" />
    <TextView android:id="@+id/fixtureSecondary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingVertical="8dp" android:text="Supplemental details remain readable."
        android:textAppearance="@style/TextAppearance.Eve.Subheadline" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Clear content. Confident controls." android:textAppearance="@style/TextAppearance.Eve.Body" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:text="Unavailable item description" android:textAppearance="@style/TextAppearance.Eve.Tertiary" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingVertical="8dp" android:text="Low priority watermark" android:textAppearance="@style/TextAppearance.Eve.Quaternary" />
    <com.google.android.material.button.MaterialButton android:id="@+id/fixturePrimary"
        style="@style/Widget.Eve.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Continue" />
    <com.google.android.material.button.MaterialButton android:id="@+id/fixtureRecovery"
        style="@style/Widget.Eve.RecoveryPrimary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Save selection" />
    <com.google.android.material.button.MaterialButton android:id="@+id/fixtureNeutral"
        style="@style/Widget.Eve.Button.Neutral" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Secondary action" />
    <com.google.android.material.button.MaterialButton android:id="@+id/fixtureSoft"
        style="@style/Widget.Eve.Button.Soft" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Soft action" />
    <com.google.android.material.button.MaterialButton android:id="@+id/fixtureOutlined"
        style="@style/Widget.Eve.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Outlined action" />
    <com.google.android.material.button.MaterialButton android:id="@+id/fixtureDisabled"
        style="@style/Widget.Eve.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Unavailable action" android:enabled="false" />
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Eve.TextInput.Filled"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:hint="Search practice tests">
        <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="General knowledge" android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/fixtureToggle" android:layout_width="match_parent"
        android:layout_height="56dp" android:text="Study reminders" android:checked="true" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/fixtureCard" style="@style/Widget.Eve.Card"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp"
            android:text="Content stays on an opaque surface" android:textAppearance="@style/TextAppearance.Eve.BodySmall" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
