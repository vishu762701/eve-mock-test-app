<?xml version="1.0" encoding="utf-8"?>
<!-- Verification fixture; every component uses its production shared style. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="@dimen/design_screen_margin" android:background="@color/bg_app">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Eve · shared foundation" android:textAppearance="@style/TextAppearance.Eve.Token.Title" />
    <TextView android:id="@+id/fixtureSecondary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingVertical="8dp" android:text="Supplemental details remain readable."
        android:textAppearance="@style/TextAppearance.Eve.Token.Secondary" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Clear content. Confident controls." android:textAppearance="@style/TextAppearance.Eve.Token.Body" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:text="Unavailable item description" android:textAppearance="@style/TextAppearance.Eve.Token.Secondary" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingVertical="8dp" android:text="Low priority watermark" android:textAppearance="@style/TextAppearance.Eve.Token.Secondary" />
    <com.google.android.material.button.MaterialButton android:id="@+id/fixturePrimary"
        style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Continue" />
    <com.google.android.material.button.MaterialButton android:id="@+id/fixtureRecovery"
        style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Save selection" />
    <com.google.android.material.button.MaterialButton android:id="@+id/fixtureNeutral"
        style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Secondary action" />
    <com.google.android.material.button.MaterialButton android:id="@+id/fixtureSoft"
        style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Soft action" />
    <com.google.android.material.button.MaterialButton android:id="@+id/fixtureOutlined"
        style="@style/Widget.Eve.Token.Button.Destructive" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Delete item" />
    <com.google.android.material.button.MaterialButton android:id="@+id/fixtureDisabled"
        style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Unavailable action" android:enabled="false" />
    <com.eve.app.designsystem.DesignInputLayout android:id="@+id/fixtureField" style="@style/Widget.Eve.Token.TextInput"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:hint="Search practice tests">
        <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="General knowledge" android:inputType="text" />
    </com.eve.app.designsystem.DesignInputLayout>
    <com.eve.app.designsystem.DesignSwitch android:id="@+id/fixtureToggle" android:layout_width="match_parent"
        android:layout_height="@dimen/design_touch_min" android:text="Study reminders" android:checked="true" />
    <com.eve.app.designsystem.DesignCardView android:id="@+id/fixtureCard" style="@style/Widget.Eve.Token.Card"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Content stays on an opaque surface" android:textAppearance="@style/TextAppearance.Eve.Token.Secondary" />
    </com.eve.app.designsystem.DesignCardView>
</LinearLayout>
