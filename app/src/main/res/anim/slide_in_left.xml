<?xml version="1.0" encoding="utf-8"?>
<!-- Apple iOS stack pop: previous screen returns from left with scale restoration -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/ios_standard_curve"
    android:shareInterpolator="true">
    <translate
        android:duration="300"
        android:fromXDelta="-25%p"
        android:toXDelta="0" />
    <scale
        android:duration="300"
        android:fromXScale="0.96"
        android:fromYScale="0.96"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.0"
        android:toYScale="1.0" />
    <alpha
        android:duration="300"
        android:fromAlpha="0.88"
        android:toAlpha="1.0" />
</set>
