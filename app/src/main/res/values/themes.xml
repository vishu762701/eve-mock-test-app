<resources>
    <style name="Theme.Eve.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/eve_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Eve</item>
    </style>

    <style name="Theme.Eve" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/eve_primary</item><item name="colorOnPrimary">@color/eve_on_primary</item>
        <item name="colorSecondary">@color/eve_accent</item><item name="colorSurface">@color/eve_surface</item>
        <item name="colorOnSurface">@color/eve_text</item><item name="colorOutline">@color/eve_stroke</item>
        <item name="android:windowBackground">@color/eve_bg</item><item name="android:statusBarColor">@color/eve_bg</item>
        <item name="android:navigationBarColor">@color/eve_bg</item><item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Eve.M3.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Eve.M3.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Eve.M3.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Eve.M3.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Eve.M3.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Eve.M3.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Eve.M3.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Eve.M3.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Eve.M3.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Eve.M3.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Eve.M3.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Eve.M3.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Eve.M3.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Eve.M3.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Eve.M3.LabelSmall</item>
        <item name="materialButtonStyle">@style/Widget.Eve.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Eve.Card</item>
        <!-- Phase 25: Telegram-style push/pop screen transition, app-wide (koi per-Activity
             code nahi chahiye — har startActivity()/finish() par khud-ba-khud apply hoti hai). -->
        <item name="android:windowAnimationStyle">@style/Eve.WindowAnimation</item>
    </style>

    <style name="ThemeOverlay.Eve.DeviceFont" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Eve.DeviceFont.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Eve.DeviceFont.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Eve.DeviceFont.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Eve.DeviceFont.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Eve.DeviceFont.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Eve.DeviceFont.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Eve.DeviceFont.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Eve.DeviceFont.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Eve.DeviceFont.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Eve.DeviceFont.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Eve.DeviceFont.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Eve.DeviceFont.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Eve.DeviceFont.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Eve.DeviceFont.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Eve.DeviceFont.LabelSmall</item>
    </style>
    <style name="ShapeCircle" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">50%</item></style>
    <style name="ShapeRounded14" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">14dp</item></style>

    <style name="Eve.WindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/stay_visible</item>
        <item name="android:activityCloseEnterAnimation">@anim/stay_visible</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="Eve.WindowAnimation.ProfileLeft" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityOpenExitAnimation">@anim/stay_visible</item>
        <item name="android:activityCloseEnterAnimation">@anim/stay_visible</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_left</item>
    </style>

    <style name="Theme.Eve.Profile" parent="Theme.Eve">
        <item name="android:windowAnimationStyle">@style/Eve.WindowAnimation.ProfileLeft</item>
    </style>
</resources>
