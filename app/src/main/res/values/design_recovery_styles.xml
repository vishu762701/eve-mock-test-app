<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Eve.RecoveryInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/eve_bg</item>
        <item name="boxStrokeColor">@color/selector_recovery_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeErrorColor">@color/eve_red</item>
        <item name="hintTextColor">@color/eve_recovery_accent</item>
        <item name="boxCornerRadiusTopStart">@dimen/eve_radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/eve_radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/eve_radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/eve_radius_input</item>
    </style>
    <style name="Widget.Eve.RecoveryChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/eve_radius_input</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipBackgroundColor">@color/selector_recovery_chip_bg</item>
        <item name="android:textColor">@color/selector_recovery_chip_text</item>
        <item name="checkedIconTint">@color/eve_recovery_accent</item>
        <item name="chipMinHeight">40dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipMinTouchTargetSize">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="chipStartPadding">@dimen/eve_space_12</item>
        <item name="chipEndPadding">@dimen/eve_space_12</item>
    </style>
    <style name="Widget.Eve.RecoveryPrimary" parent="Widget.Eve.Button.Primary">
        <item name="android:minHeight">52dp</item><item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Eve.RecoverySecondary" parent="Widget.Eve.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/selector_eve_accent_text</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Theme.Eve.RecoverySheet" parent="Theme.Eve.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Eve.RecoverySheet</item>
    </style>
    <style name="Widget.Eve.RecoverySheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/eve_card_bg</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Eve.RecoverySheet</item>
    </style>
    <style name="ShapeAppearance.Eve.RecoverySheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/eve_radius_bottom_sheet</item>
        <item name="cornerSizeTopRight">@dimen/eve_radius_bottom_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
