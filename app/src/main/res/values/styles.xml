<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Phase 24: premium "bubble" buttons — taller, rounder (pill-ish), matching the
         Telegram-style redesign. -->
    <style name="Widget.Eve.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/eve_button_bg</item>
        <item name="android:textColor">@color/eve_button_text</item>
        <item name="cornerRadius">@dimen/eve_radius_md</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>
    <style name="Widget.Eve.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/eve_radius_md</item>
        <item name="strokeWidth">1.4dp</item>
        <item name="strokeColor">@color/eve_stroke</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>
    <style name="Widget.Eve.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="cornerRadius">@dimen/eve_radius_sm</item>
    </style>
    <!-- Flat, borderless "bubble" card — the Phase 24 default. Corner radius bumped up,
         stroke removed (separation now comes from the surface-vs-page color contrast in
         colors.xml), and a whisper of elevation for a subtle premium lift. -->
    <style name="Widget.Eve.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/eve_radius_md</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/eve_surface</item>
        <!-- Sirf clickable cards par visible hota hai — non-clickable cards kabhi
             "pressed" state me jaate hi nahi, isliye unke liye ye no-op hai. -->
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>
    <style name="Eve.TopBar" parent="">
        <item name="android:background">@color/eve_surface</item><item name="android:minHeight">64dp</item>
        <item name="android:elevation">0dp</item><item name="android:paddingStart">16dp</item><item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Eve.Screen" parent=""><item name="android:background">@color/eve_bg</item></style>
    <style name="Eve.Title" parent=""><item name="android:textColor">@color/eve_text</item><item name="android:textSize">23sp</item><item name="android:fontFamily">@font/poppins_semibold</item><item name="fontFamily">@font/poppins_semibold</item><item name="android:textStyle">bold</item></style>
    <style name="Eve.Body" parent=""><item name="android:textColor">@color/eve_text</item><item name="android:textSize">15sp</item><item name="android:fontFamily">@font/poppins</item><item name="fontFamily">@font/poppins</item></style>
    <style name="Eve.Secondary" parent=""><item name="android:textColor">@color/eve_text_secondary</item><item name="android:textSize">13sp</item><item name="android:fontFamily">@font/poppins</item><item name="fontFamily">@font/poppins</item></style>
</resources>
