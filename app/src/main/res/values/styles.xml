<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Eve Shared Styles — Apple iOS 26 Visual Design System -->
    <!-- Buttons:
         Primary = blue rounded control
         Neutral = secondary surface with rounded corners
         Outlined = 1dp border with rounded corners
         Soft = surface-2 fill without border pill
         All 48dp min height (or 44dp compact), tactile press scale 0.98. -->

    <style name="Widget.Eve.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/eve_control_min_touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/selector_eve_button_neutral</item>
        <item name="android:textColor">@color/selector_eve_neutral_text</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Eve.Capsule</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="rippleColor">@color/eve_ripple</item>
    </style>

    <style name="Widget.Eve.Button.Primary" parent="Widget.Eve.Button">
        <item name="backgroundTint">@color/selector_eve_button_primary</item>
        <item name="android:textColor">@color/selector_eve_on_primary</item>
        <item name="iconTint">@color/selector_eve_on_primary</item>
    </style>

    <style name="Widget.Eve.Button.Neutral" parent="Widget.Eve.Button">
        <item name="backgroundTint">@color/selector_eve_button_neutral</item>
        <item name="android:textColor">@color/selector_eve_neutral_text</item>
        <item name="iconTint">@color/selector_eve_neutral_text</item>
    </style>

    <style name="Widget.Eve.Button.Soft" parent="Widget.Eve.Button">
        <item name="backgroundTint">@color/selector_eve_button_soft</item>
        <item name="android:textColor">@color/selector_eve_accent_text</item>
        <item name="iconTint">@color/selector_eve_accent_text</item>
    </style>


    <style name="Widget.Eve.Button.LilacPill" parent="Widget.Eve.Button.Soft">
        <item name="android:minHeight">@dimen/eve_control_min_touch</item>
        <item name="android:textSize">13sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Eve.Button.OrangePill" parent="Widget.Eve.Button.Primary">
        <item name="strokeWidth">0dp</item>
        <item name="android:minHeight">@dimen/eve_control_min_touch</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Eve.Button.Orange" parent="Widget.Eve.Button.Primary">
        <item name="strokeWidth">0dp</item>
        <item name="android:minHeight">@dimen/eve_control_min_touch</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Eve.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
