<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Eve Shared Styles — Apple iOS 26 Visual Design System -->
    <!-- Buttons:
         Primary = blue rounded control
         Neutral = secondary surface with rounded corners
         Outlined = 1dp border with rounded corners
         Soft = surface-2 fill without border pill
         All 48dp min height (or 44dp compact), tactile press scale 0.98. -->

    <style name="Widget.Eve.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/eve_control_min_touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/selector_eve_button_neutral</item>
        <item name="android:textColor">@color/selector_eve_neutral_text</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Eve.Capsule</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="rippleColor">@color/eve_ripple</item>
    </style>

    <style name="Widget.Eve.Button.Primary" parent="Widget.Eve.Button">
        <item name="backgroundTint">@color/selector_eve_button_primary</item>
        <item name="android:textColor">@color/selector_eve_on_primary</item>
        <item name="iconTint">@color/selector_eve_on_primary</item>
    </style>

    <style name="Widget.Eve.Button.Neutral" parent="Widget.Eve.Button">
        <item name="backgroundTint">@color/selector_eve_button_neutral</item>
        <item name="android:textColor">@color/selector_eve_neutral_text</item>
        <item name="iconTint">@color/selector_eve_neutral_text</item>
    </style>

    <style name="Widget.Eve.Button.Soft" parent="Widget.Eve.Button">
        <item name="backgroundTint">@color/selector_eve_button_soft</item>
        <item name="android:textColor">@color/selector_eve_accent_text</item>
        <item name="iconTint">@color/selector_eve_accent_text</item>
    </style>


    <style name="Widget.Eve.Button.LilacPill" parent="Widget.Eve.Button.Soft">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Eve.Button.OrangePill" parent="Widget.Eve.Button.Primary">
        <item name="strokeWidth">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Eve.Button.Orange" parent="Widget.Eve.Button.Primary">
        <item name="strokeWidth">0dp</item>
        <item name="android:minHeight">@dimen/eve_control_min_touch</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Eve.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/eve_control_min_touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Eve.Capsule</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/eveControlOutline</item>
        <item name="android:textColor">@color/selector_eve_accent_text</item>
        <item name="iconTint">@color/selector_eve_accent_text</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Eve.Button.Outlined" parent="Widget.Eve.OutlinedButton" />

    <style name="Widget.Eve.TextInput.Filled" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/eve_input_fill</item>
        <item name="hintTextColor">?attr/eveAccentText</item>
        <item name="boxStrokeColor">@color/selector_eve_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/eve_radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/eve_radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/eve_radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/eve_radius_input</item>
    </style>

    <style name="Widget.Eve.TextInput.Filled.ExposedDropdownMenu" parent="Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/eve_input_fill</item>
        <item name="hintTextColor">?attr/eveAccentText</item>
        <item name="boxStrokeColor">@color/selector_eve_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/eve_radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/eve_radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/eve_radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/eve_radius_input</item>
    </style>

    <style name="Widget.Eve.ChipButton.Delete" parent="Widget.Eve.OutlinedButton">
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/selector_eve_destructive_text</item>
        <item name="iconTint">@color/selector_eve_destructive_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="strokeColor">@color/eve_shape_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/eve_radius_input</item>
    </style>

    <style name="Widget.Eve.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Eve.Capsule</item>
        <item name="android:textColor">@color/selector_eve_accent_text</item>
        <item name="iconTint">@color/selector_eve_accent_text</item>
    </style>

    <!-- Cards: 20dp radius, 0.5dp subtle border, soft elevation in light, 0dp in dark -->
    <style name="Widget.Eve.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/eve_radius_card</item>
        <item name="cardElevation">@dimen/eve_card_elevation_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/eve_shape_border</item>
        <item name="cardBackgroundColor">@color/eve_card_bg</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <!-- Tiles (semantic variants): 20dp surface radius -->
    <style name="Widget.Eve.Tile" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/eve_radius_tile</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/eve_shape_border</item>
        <item name="cardBackgroundColor">@color/eve_surface_2</item>
    </style>

    <style name="Widget.Eve.Tile.Right" parent="Widget.Eve.Tile">
        <item name="cardBackgroundColor">@color/eve_tile_right_fill</item>
        <item name="strokeColor">@color/eve_shape_border</item>
    </style>

    <style name="Widget.Eve.Tile.Wrong" parent="Widget.Eve.Tile">
        <item name="cardBackgroundColor">@color/eve_tile_wrong_fill</item>
        <item name="strokeColor">@color/eve_shape_border</item>
    </style>

    <style name="Widget.Eve.Tile.Medium" parent="Widget.Eve.Tile">
        <item name="cardBackgroundColor">@color/eve_tile_medium_fill</item>
        <item name="strokeColor">@color/eve_shape_border</item>
    </style>

    <style name="TextAppearance.Eve.TabSegment" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Eve.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackDecoration">@drawable/eve_switch_track_outline</item>
        <item name="trackDecorationTint">@color/selector_switch_outline</item>
        <item name="trackTint">@color/selector_eve_switch_track</item>
        <item name="thumbTint">@color/selector_eve_switch_thumb</item>
    </style>

    <style name="TextAppearance.Eve.ResultTabSegment" parent="TextAppearance.Eve.TabSegment">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Eve.TopBar" parent="">
        <item name="android:background">@color/eve_bg</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <style name="Eve.Screen" parent=""><item name="android:background">@color/eve_bg</item></style>
    <style name="Eve.Title" parent="">
        <item name="android:textColor">@color/eve_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Eve.Text.Title" parent="Eve.Title" />
    <style name="Eve.Body" parent="">
        <item name="android:textColor">@color/eve_text</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Eve.Secondary" parent="">
        <item name="android:textColor">?attr/eveLabelSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.Eve.CutoffChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">30dp</item>
        <item name="chipMinHeight">30dp</item>
        <item name="android:textSize">13sp</item>
        <item name="chipCornerRadius">@dimen/eve_radius_pill</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/selector_category_chip_stroke</item>
        <item name="android:textColor">@color/cutoff_chip_text</item>
        <item name="chipBackgroundColor">@color/cutoff_chip_bg</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.Eve.CategoryChip" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Eve.Capsule</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/selector_category_chip_stroke</item>
        <item name="chipBackgroundColor">@color/selector_category_chip_bg</item>
        <item name="android:textColor">@color/selector_category_chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textSize">13sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Material3 Assist chips already have a 1dp outline, including runtime chips. -->
    <style name="Widget.Eve.AssistChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipStrokeColor">@color/selector_category_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

    <!-- ScreenTitle: 20sp, sans-serif-medium bold, eve_text -->
    <style name="TextAppearance.Eve.ScreenTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/eve_text</item>
    </style>
    <style name="ShapeAppearance.Eve.Capsule" parent="">
        <item name="cornerFamily">rounded</item><item name="cornerSize">50%</item>
    </style>
    <style name="Widget.Eve.IconButton" parent="Widget.Eve.Button.Neutral">
        <item name="android:minWidth">48dp</item><item name="android:padding">12dp</item>
        <item name="iconPadding">0dp</item><item name="iconGravity">textStart</item>
    </style>
    <style name="Widget.Eve.AssistChip.Inset" parent="Widget.Eve.RecoveryChip">
        <item name="chipBackgroundColor">@color/selector_eve_inset_chip_bg</item>
    </style>
    <style name="Widget.Eve.Card.Group" parent="Widget.Eve.Card">
        <item name="cardBackgroundColor">@color/eve_secondary_system_grouped_background</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Eve.Card.Inset" parent="Widget.Eve.Card.Group">
        <item name="cardBackgroundColor">@color/eve_tertiary_system_grouped_background</item>
    </style>
    <style name="Widget.Eve.Card.Content" parent="Widget.Eve.Card.Group">
        <item name="cardBackgroundColor">@color/eve_secondary_background</item>
    </style>
    <style name="Widget.Eve.TextInput.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/eve_input_fill</item>
        <item name="boxStrokeColor">@color/selector_eve_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/eve_destructive_text</item>
        <item name="hintTextColor">?attr/eveAccentText</item>
        <item name="boxStrokeWidth">1dp</item><item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/eve_radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/eve_radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/eve_radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/eve_radius_input</item>
    </style>
</resources>
