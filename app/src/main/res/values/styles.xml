<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Eve Shared Styles — MASTER_TASK_V3 Approved -->
    <!-- Buttons:
         Primary = inverting pill (light: black fill/white text, dark: white fill/black text)
         Neutral = inverting pill
         Outlined = 1dp border pill
         Soft = surface-2 fill without border pill
         All 48dp min height (or 44dp compact), press scale 0.97, ripple clipped to shape. -->

    <style name="Widget.Eve.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="backgroundTint">@color/eve_button_bg</item>
        <item name="android:textColor">@color/eve_button_text</item>
        <item name="cornerRadius">@dimen/eve_radius_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="Widget.Eve.Button.Primary" parent="Widget.Eve.Button">
        <item name="backgroundTint">@color/eve_button_primary_bg</item>
        <item name="android:textColor">@color/eve_button_primary_text</item>
        <item name="iconTint">@color/eve_button_primary_text</item>
    </style>

    <style name="Widget.Eve.Button.Neutral" parent="Widget.Eve.Button">
        <item name="backgroundTint">@color/eve_button_neutral_bg</item>
        <item name="android:textColor">@color/eve_button_neutral_text</item>
        <item name="iconTint">@color/eve_button_neutral_text</item>
    </style>

    <style name="Widget.Eve.Button.Soft" parent="Widget.Eve.Button">
        <item name="backgroundTint">@color/eve_button_soft_bg</item>
        <item name="android:textColor">@color/eve_button_soft_text</item>
        <item name="iconTint">@color/eve_button_soft_text</item>
        <item name="cornerRadius">@dimen/eve_radius_pill</item>
    </style>

    <style name="Widget.Eve.Button.LilacPill" parent="Widget.Eve.Button">
        <item name="backgroundTint">@color/eve_chip_hi_bg</item>
        <item name="android:textColor">@color/eve_chip_hi_text</item>
        <item name="iconTint">@color/eve_chip_hi_text</item>
        <item name="cornerRadius">@dimen/eve_radius_pill</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.Eve.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="cornerRadius">@dimen/eve_radius_button</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/eve_stroke</item>
        <item name="android:textColor">@color/eve_text</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Eve.Button.Outlined" parent="Widget.Eve.OutlinedButton" />

    <style name="Widget.Eve.ChipButton.Delete" parent="Widget.Eve.OutlinedButton">
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/eve_red</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="strokeColor">@color/eve_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/eve_radius_input</item>
    </style>

    <style name="Widget.Eve.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="cornerRadius">@dimen/eve_radius_button</item>
        <item name="android:textColor">@color/eve_text</item>
    </style>

    <!-- Cards: 28dp radius, 1dp border, soft elevation in light, 0dp in dark -->
    <style name="Widget.Eve.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/eve_radius_card</item>
        <item name="cardElevation">@dimen/eve_card_elevation_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/eve_stroke</item>
        <item name="cardBackgroundColor">@color/eve_surface</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <!-- Tiles (semantic variants): 24dp radius -->
    <style name="Widget.Eve.Tile" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/eve_radius_tile</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/eve_border</item>
        <item name="cardBackgroundColor">@color/eve_surface_2</item>
    </style>

    <style name="Widget.Eve.Tile.Right" parent="Widget.Eve.Tile">
        <item name="cardBackgroundColor">@color/eve_tile_right_fill</item>
        <item name="strokeColor">@color/eve_tile_right_border</item>
    </style>

    <style name="Widget.Eve.Tile.Wrong" parent="Widget.Eve.Tile">
        <item name="cardBackgroundColor">@color/eve_tile_wrong_fill</item>
        <item name="strokeColor">@color/eve_tile_wrong_border</item>
    </style>

    <style name="Widget.Eve.Tile.Medium" parent="Widget.Eve.Tile">
        <item name="cardBackgroundColor">@color/eve_tile_medium_fill</item>
        <item name="strokeColor">@color/eve_tile_medium_border</item>
    </style>

    <style name="TextAppearance.Eve.TabSegment" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Eve.TopBar" parent="">
        <item name="android:background">@color/eve_bg</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <style name="Eve.Screen" parent=""><item name="android:background">@color/eve_bg</item></style>
    <style name="Eve.Title" parent="">
        <item name="android:textColor">@color/eve_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>
    <style name="Eve.Text.Title" parent="Eve.Title" />
    <style name="Eve.Body" parent="">
        <item name="android:textColor">@color/eve_text</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <style name="Eve.Secondary" parent="">
        <item name="android:textColor">@color/eve_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>

    <style name="Widget.Eve.CutoffChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">30dp</item>
        <item name="chipMinHeight">30dp</item>
        <item name="android:textSize">13sp</item>
        <item name="chipCornerRadius">@dimen/eve_radius_pill</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/cutoff_chip_stroke</item>
        <item name="android:textColor">@color/cutoff_chip_text</item>
        <item name="chipBackgroundColor">@color/cutoff_chip_bg</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.Eve.CategoryChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/eve_radius_pill</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="chipStrokeColor">@color/selector_category_chip_stroke</item>
        <item name="chipBackgroundColor">@color/selector_category_chip_bg</item>
        <item name="android:textColor">@color/selector_category_chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textSize">13sp</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>
</resources>
