<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Derived EVE text roles. See docs/telegram-typography-mission-01.md. No Telegram source copied. -->
    <style name="TextAppearance.Eve.Telegram.NavigationTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/telegram_roboto_medium</item>
        <item name="fontFamily">@font/telegram_roboto_medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/telegram_type_primary</item>
    </style>
    <!-- ActionBar.java:1445-1452: paired title/subtitle = phone 18/14dp, tablet 20/16dp.
         EVE uses sp to preserve Android font scaling. -->
    <style name="TextAppearance.Eve.Telegram.NavigationTitle.WithSubtitle" parent="TextAppearance.Eve.Telegram.NavigationTitle">
        <item name="android:textSize">18sp</item>
    </style>
    <style name="TextAppearance.Eve.Telegram.NavigationSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/telegram_type_secondary</item>
    </style>
    <!-- Telegram DialogCell.java:1252-1254 + Theme.java:7812,7897: 17/16/12dp list roles. -->
