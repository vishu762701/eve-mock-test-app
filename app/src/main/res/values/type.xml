    </style>

    <!-- Overline: 12sp, Medium, ALL CAPS, letterSpacing 0.06 -->
    <style name="TextAppearance.Eve.Overline" parent="TextAppearance.Eve">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/eve_label_secondary</item>
    </style>

    <style name="TextAppearance.Eve.Overline.Secondary" parent="TextAppearance.Eve.Overline">
        <item name="android:textColor">@color/eve_label_secondary</item>
    </style>

