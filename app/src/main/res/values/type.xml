    <style name="TextAppearance.Eve.M3.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium"><item name="android:fontFamily">sans-serif</item><item name="fontFamily">sans-serif</item><item name="android:textStyle">bold</item></style>
