        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/eve_label_tertiary</item>
    </style>

    <!-- Existing Semantic Aliases for backward compatibility -->
    <!-- Heading: 20sp, Bold -->
    <style name="TextAppearance.Eve.Heading" parent="TextAppearance.Eve">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/eve_label_primary</item>
    </style>

    <!-- QuestionText: 17sp, Regular, lineSpacingMultiplier 1.25 -->
    <style name="TextAppearance.Eve.QuestionText" parent="TextAppearance.Eve">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:textColor">@color/eve_label_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Subheading: 17sp, Medium -->
    <style name="TextAppearance.Eve.Subheading" parent="TextAppearance.Eve">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/eve_label_primary</item>
    </style>

    <!-- Button: 15sp, Medium -->
    <style name="TextAppearance.Eve.Button" parent="TextAppearance.Eve">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
