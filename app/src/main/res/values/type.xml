        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/eve_label_primary</item>
    </style>

    <!-- Body: 17sp, Regular -->
    <style name="TextAppearance.Eve.Body" parent="TextAppearance.Eve">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/eve_label_primary</item>
    </style>

    <style name="TextAppearance.Eve.Subhead" parent="TextAppearance.Eve.Subheadline" />

    <!-- Callout: 16sp, Regular -->
    <style name="TextAppearance.Eve.Callout" parent="TextAppearance.Eve">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/eve_label_primary</item>
    </style>

    <!-- Subheadline: 15sp, Regular -->
    <style name="TextAppearance.Eve.Subheadline" parent="TextAppearance.Eve">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/eve_label_secondary</item>
    </style>

    <!-- Footnote: 13sp, Regular -->
    <style name="TextAppearance.Eve.Footnote" parent="TextAppearance.Eve">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/eve_label_secondary</item>
    </style>

    <!-- Caption: 12sp, Regular -->
    <style name="TextAppearance.Eve.Caption" parent="TextAppearance.Eve">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
