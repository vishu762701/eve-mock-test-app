<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base text appearance -->
    <style name="TextAppearance.Eve" parent="">
        <item name="android:textColor">@color/eve_label_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Apple iOS 26 System Typography Roles (Platform-native sans-serif stack) -->
    <!-- Display / Large Title: 34sp, Bold, tighter tracking -->
    <style name="TextAppearance.Eve.Display" parent="TextAppearance.Eve">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/eve_label_primary</item>
    </style>

    <style name="TextAppearance.Eve.LargeTitle" parent="TextAppearance.Eve.Display" />

    <!-- Title 1: 28sp, Bold -->
    <style name="TextAppearance.Eve.Title1" parent="TextAppearance.Eve">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">@color/eve_label_primary</item>
    </style>

    <!-- Title 2: 22sp, Bold -->
    <style name="TextAppearance.Eve.Title2" parent="TextAppearance.Eve">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/eve_label_primary</item>
    </style>

    <!-- Title 3: 20sp, Semibold / Medium -->
    <style name="TextAppearance.Eve.Title3" parent="TextAppearance.Eve">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/eve_label_primary</item>
    </style>

    <!-- Headline: 17sp, Semibold / Medium -->
    <style name="TextAppearance.Eve.Headline" parent="TextAppearance.Eve">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/eve_label_primary</item>
    </style>

