<?xml version="1.0" encoding="utf-8"?>
<!-- Stateful even with identical colors: Material TextInputLayout otherwise changes focus only. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/eve_shape_border" />
    <item android:state_focused="true" android:color="@color/eve_shape_border" />
    <item android:state_hovered="true" android:color="@color/eve_shape_border" />
    <item android:color="@color/eve_shape_border" />
</selector>
