<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:ns2="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Screen">
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.ToolbarRow">
            <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="@color/text_primary" style="@style/Widget.Eve.Token.IconButton" />
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
            <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressBarTop" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:indeterminate="true" android:visibility="gone" style="@style/Widget.Eve.Token.Ring" />
        </LinearLayout>
    </com.eve.app.ui.common.EveGlassToolbar>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.LargeTitleBlock">
        <TextView style="@style/TextAppearance.Eve.Token.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manage Syllabus" />
        <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Upload, assign and manage syllabus PDFs" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <com.eve.app.designsystem.DesignCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" style="@style/Widget.Eve.Token.Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                    <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add / Upload New Syllabus" />
                    <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Associate a syllabus PDF (max 20MB) with an exam." />
                    <com.eve.app.designsystem.UiArcUploadStepperView android:id="@+id/stepperNewSyllabus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" />
                    <com.eve.app.designsystem.UiArcMorphSelectView android:id="@+id/morphSelectExam" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" />
                    <com.eve.app.designsystem.DesignInputLayout android:id="@+id/tilSelectExam" style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:hint="Select Exam" android:visibility="gone">
                        <com.eve.app.designsystem.DesignAutoComplete style="@style/Widget.Eve.Token.Input" android:id="@+id/actvSelectExam" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="none" />
                    </com.eve.app.designsystem.DesignInputLayout>
                    <com.eve.app.designsystem.UiArcFileUploadView android:id="@+id/fileUploadView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnChoosePdf" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:text="Choose PDF Document" app:icon="@drawable/ic_upload" />
                        <LinearLayout android:id="@+id/layoutSelectedPdf" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Tile">
                            <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="PDF file" android:src="@drawable/ic_description" app:tint="@color/system_blue" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_card_gap" android:layout_weight="1" android:orientation="vertical">
                                <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:id="@+id/tvNewPdfName" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="middle" android:maxLines="1" ns2:text="sample_syllabus.pdf" />
                                <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:id="@+id/tvNewPdfSize" android:layout_width="match_parent" android:layout_height="wrap_content" ns2:text="2.4 MB · Ready" />
                            </LinearLayout>
                            <ImageView android:id="@+id/ivUploadCheckDone" android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Uploaded" android:src="@drawable/ic_check_circle" app:tint="@color/system_green" android:visibility="gone" />
                            <ImageButton android:id="@+id/btnClearSelectedPdf" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Clear" android:src="@drawable/ic_close" app:tint="@color/text_secondary" style="@style/Widget.Eve.Token.IconButton" />
                        </LinearLayout>
                    </com.eve.app.designsystem.UiArcFileUploadView>
                    <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressBarUpload" style="@style/Widget.Eve.Token.Ring" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:layout_marginTop="@dimen/design_card_gap" android:indeterminate="true" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnUploadSyllabus" style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="@dimen/design_screen_margin" android:text="Upload &amp; Assign Syllabus" />
                </LinearLayout>
            </com.eve.app.designsystem.DesignCardView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/design_screen_margin" android:layout_marginTop="@dimen/design_icon_size" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                <TextView style="@style/TextAppearance.Eve.Token.Heading" android:id="@+id/tvExistingHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Existing Syllabuses" />
                <TextView style="@style/TextAppearance.Eve.Token.Secondary.blue" android:id="@+id/tvSyllabusCount" android:layout_width="wrap_content" android:layout_height="wrap_content" ns2:text="3 Active" />
            </LinearLayout>
            <com.eve.app.designsystem.DesignInputLayout android:id="@+id/tilSearch" style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/design_screen_margin" android:layout_marginTop="@dimen/design_card_padding" android:hint="Search syllabus by exam name..." app:startIconDrawable="@drawable/ic_search">
                <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Eve.Token.Input" android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="text" />
            </com.eve.app.designsystem.DesignInputLayout>
            <LinearLayout android:id="@+id/layoutEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_icon_size" android:gravity="center" android:orientation="vertical" android:visibility="gone" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Empty" android:src="@drawable/ic_syllabus" app:tint="@color/text_secondary" />
                <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:text="No Syllabuses Uploaded" />
                <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Choose an exam above to upload and attach its syllabus PDF." android:textAlignment="center" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSyllabuses" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:nestedScrollingEnabled="false" ns2:listitem="@layout/item_admin_syllabus" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll.Inner" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>