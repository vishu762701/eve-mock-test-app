<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content Container -->
    <LinearLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/eve_bg"
        android:orientation="vertical">

    <!-- Top Bar Container / Header-Ink Zone -->
    <FrameLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eve_header_ink">

        <!-- Normal Top Bar -->
        <LinearLayout
            android:id="@+id/normalTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="36dp">

            <!-- Row 1: avatar left, bare search, bell, overflow right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:contentDescription="Profile"
                    android:padding="8dp"
                    android:src="@drawable/ic_user_profile"
                    android:stateListAnimator="@animator/press_scale"
                    app:shapeAppearanceOverlay="@style/ShapeCircle" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Search Icon -->
                <ImageButton
                    android:id="@+id/btnSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:background="@android:color/transparent"
                    android:stateListAnimator="@animator/press_scale"
                    android:contentDescription="Search exams"
                    android:padding="14dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/eve_header_ink_icon" />

                <!-- Bell (Notifications) Icon -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:background="@android:color/transparent"
                    android:stateListAnimator="@animator/press_scale">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/btnNotification"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:contentDescription="Notifications"
                        android:focusable="true"
                        android:padding="10dp"
                        app:lottie_autoPlay="false"
                        app:lottie_loop="false"
                        app:lottie_rawRes="@raw/notification_bell" />

                    <View
                        android:id="@+id/dotUnread"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_dot_red"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- 3-Dot Overflow Menu Icon -->
                <ImageButton
                    android:id="@+id/btnOverflow"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:stateListAnimator="@animator/press_scale"
                    android:contentDescription="@string/home_menu"
                    android:padding="14dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/eve_header_ink_icon" />
            </LinearLayout>

            <!-- Row 2: tiny 'Eve' label above large bold greeting -->
            <LinearLayout
                android:id="@+id/titleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:text="EVE"
                    android:textColor="@color/eve_header_ink_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvWelcome"
                    style="@style/TextAppearance.Eve.M3.HeadlineLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Hi, Student"
                    android:textColor="@color/eve_header_ink_text"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Expanded Telegram-Style Search Bar -->
        <LinearLayout
            android:id="@+id/searchTopBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="56dp"
            android:background="@color/eve_header_ink"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnSearchBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_translucent"
                android:stateListAnimator="@animator/press_scale"
                android:contentDescription="Close search"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="@color/eve_header_ink_icon" />

            <LinearLayout
                android:id="@+id/layoutSearchFieldContainer"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="sans-serif"
                    android:hint="Search exams..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/eve_header_ink_text"
                    android:textColorHint="@color/eve_header_ink_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_translucent"
                android:stateListAnimator="@animator/press_scale"
                android:contentDescription="Clear search"
                android:padding="11dp"
                android:src="@drawable/ic_close"
                app:tint="@color/eve_header_ink_icon"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- Content Sheet: 32dp top corners overlapping the header by 24dp -->
    <LinearLayout
        android:id="@+id/contentSheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="-24dp"
        android:background="@drawable/bg_content_sheet"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOfflineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/eve_offline_bg"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="@string/offline_banner_text"
            android:textColor="@color/eve_offline_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Single Home Banner surface; hidden when no active banners are published. -->
        <FrameLayout
            android:id="@+id/panelHomeBanner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/eve_home_banner_height"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:background="@android:color/transparent"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:visibility="gone">

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurHomeBannerMaterial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpHomeBanners"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.88"
                android:overScrollMode="never" />

            <View
                android:id="@+id/homeBannerMatte"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/eve_home_banner_matte"
                android:clickable="false"
                android:focusable="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHomeBannerCta"
                style="@style/Widget.Eve.Button.Neutral"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:contentDescription="Open Home banner link"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="40dp"
                android:paddingHorizontal="14dp"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layoutStreakPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_streak_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="@dimen/eve_space_16"
            android:paddingVertical="@dimen/eve_space_8"
            android:visibility="gone">

            <com.eve.app.ui.common.FlameAnimationView
                android:id="@+id/flameStreakAnimation"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvStreakSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:textColor="@color/eve_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdmin"
            style="@style/Widget.Eve.Button.Neutral"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:cornerRadius="18dp"
            android:text="Admin Dashboard"
            android:visibility="gone" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExams"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/layout_enter"
                android:paddingHorizontal="16dp"
                android:paddingBottom="96dp" />

        <!-- Upgrade 3: Telegram-style shimmer skeleton placeholder (LoadingDrawable pattern) -->
        <com.eve.app.ui.common.ShimmerSkeletonView
            android:id="@+id/shimmerSkeletonHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/progressGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Loading exams…"
                android:textColor="@color/eve_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/messageGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/ivMessageIcon"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@android:color/transparent"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/error_404" />

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/eve_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMessageSub"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/eve_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.Eve.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Try again"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Floating Airplane Chip (T7) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFloatingAirplane"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="36dp"
            app:cardElevation="0dp"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieFloatingAirplane"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:contentDescription="Open community link"
                app:lottie_autoPlay="false"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/man_flying_on_paper_airplane" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
    </LinearLayout>
    </LinearLayout>

    <!-- Left Profile Navigation Drawer Panel -->
    <FrameLayout
        android:id="@+id/navDrawerPanel"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer_glass"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true">

        <!-- Layer 1: Heavily blurred background slice of content directly behind drawer -->
        <ImageView
            android:id="@+id/ivDrawerGlassBlurBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <!-- Layer 2: Frosted glass tint overlay ensuring perfect contrast -->
        <View
            android:id="@+id/viewDrawerGlassTintOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/eve_drawer_glass_tint" />

        <!-- Layer 3: Drawer Content -->
        <LinearLayout
            android:id="@+id/navDrawerContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            android:orientation="vertical">

        <!-- Drawer Header with Avatar, Name, Email -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDrawerAvatar"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_translucent"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Profile photo"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_user_profile"
                android:stateListAnimator="@animator/press_scale"
                app:shapeAppearanceOverlay="@style/ShapeCircle" />

            <TextView
                android:id="@+id/tvDrawerUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Student"
                android:textColor="@color/eve_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDrawerUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="student@eve.app"
                android:textColor="@color/eve_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDrawerPremiumStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/eve_status_success"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Frosted Glass Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/eve_menu_glass_divider" />

        <!-- Drawer Menu Items (Order: 1. Profile, 2. Premium, 3. Performance, 4. Overall Leaderboard, 5. Syllabus) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- 1. Profile -->
            <LinearLayout
                android:id="@+id/layoutDrawerProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:stateListAnimator="@animator/press_scale"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Profile"
                    android:src="@drawable/ic_person"
                    app:tint="@color/eve_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="Profile"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 2. Premium -->
            <LinearLayout
                android:id="@+id/layoutDrawerPremium"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:stateListAnimator="@animator/press_scale"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="-6dp">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottieDrawerPremiumStarFallback"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="Premium"
                        android:visibility="gone"
                        app:lottie_autoPlay="false"
                        app:lottie_loop="false"
                        app:lottie_rawRes="@raw/premium_star" />

                    <com.eve.app.ui.premium.gl.Telegram3DStarView
                        android:id="@+id/lottieDrawerPremiumStar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Premium" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Premium"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 3. Performance -->
            <LinearLayout
                android:id="@+id/layoutDrawerPerformance"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:stateListAnimator="@animator/press_scale"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Performance"
                    android:src="@drawable/ic_performance_increase"
                    app:tint="@color/eve_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="Performance"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 3. Overall Leaderboard -->
            <LinearLayout
                android:id="@+id/layoutDrawerLeaderboard"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:stateListAnimator="@animator/press_scale"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Overall Leaderboard"
                    android:src="@drawable/ic_leaderboard_star"
                    app:tint="@color/eve_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="Overall Leaderboard"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 4. Syllabus -->
            <LinearLayout
                android:id="@+id/layoutDrawerSyllabus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:stateListAnimator="@animator/press_scale"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Syllabus"
                    android:src="@drawable/ic_syllabus"
                    app:tint="@color/eve_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="Syllabus"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 5. About -->
            <LinearLayout
                android:id="@+id/layoutDrawerAbout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:stateListAnimator="@animator/press_scale"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="About"
                    android:src="@drawable/ic_info"
                    app:tint="@color/eve_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="About"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 6. Settings -->
            <LinearLayout
                android:id="@+id/layoutDrawerSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:stateListAnimator="@animator/press_scale"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/eve_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="Settings"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Full-Screen Non-Dismissable Maintenance Mode Overlay -->
    <FrameLayout
        android:id="@+id/maintenanceOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/eve_bg"
        android:clickable="true"
        android:elevation="30dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:src="@drawable/ic_maintenance"
                app:tint="@color/eve_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Scheduled Maintenance"
                android:textColor="@color/eve_text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvMaintenanceMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Eve Mock Test is currently undergoing scheduled maintenance. Please check back shortly."
                android:textColor="@color/eve_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckMaintenanceAgain"
                style="@style/Widget.Eve.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Check Again" />
        </LinearLayout>
    </FrameLayout>

    <!-- Full-Screen Non-Dismissable Force Update Overlay -->
    <FrameLayout
        android:id="@+id/forceUpdateOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/eve_bg"
        android:clickable="true"
        android:elevation="30dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/eve_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Update Required"
                android:textColor="@color/eve_text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvForceUpdateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="A newer version of Eve Mock Test is required to continue. Please update to the latest version for improved stability, questions, and security."
                android:textColor="@color/eve_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnForceUpdateNow"
                style="@style/Widget.Eve.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Update App Now" />
        </LinearLayout>
    </FrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>
