<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eve_bg"
    android:orientation="vertical">

    <!-- Top Bar Container -->
    <FrameLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/eve_surface">

        <!-- Normal Top Bar -->
        <LinearLayout
            android:id="@+id/normalTopBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfile"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_translucent"
                android:contentDescription="Profile"
                android:padding="9dp"
                android:src="@drawable/ic_user_profile"
                app:shapeAppearanceOverlay="@style/ShapeCircle" />

            <LinearLayout
                android:id="@+id/titleGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eve"
                    android:textColor="@color/eve_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi, Student"
                    android:textColor="@color/eve_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Search Icon (placed immediately left of bell icon) -->
            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search exams"
                android:padding="10dp"
                android:src="@drawable/ic_search"
                android:tint="@color/eve_text" />

            <!-- Bell (Notifications) Icon -->
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="2dp">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/btnNotification"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Notifications"
                    android:focusable="true"
                    android:padding="4dp"
                    app:lottie_autoPlay="false"
                    app:lottie_loop="false"
                    app:lottie_rawRes="@raw/notification_bell" />

                <View
                    android:id="@+id/dotUnread"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_dot_red"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 3-Dot Overflow Menu Icon -->
            <ImageButton
                android:id="@+id/btnOverflow"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_menu"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/eve_text" />
        </LinearLayout>

        <!-- Expanded Telegram-Style Search Bar -->
        <LinearLayout
            android:id="@+id/searchTopBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/eve_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnSearchBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close search"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                android:tint="@color/eve_text" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search exams..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/eve_text"
                android:textColorHint="@color/eve_text_secondary"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear search"
                android:padding="11dp"
                android:src="@drawable/ic_close"
                android:tint="@color/eve_text"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eve_offline_bg"
        android:gravity="center"
        android:paddingVertical="7dp"
        android:text="@string/offline_banner_text"
        android:textColor="@color/eve_offline_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find your next test"
            android:textColor="@color/eve_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Choose an exam to begin practicing."
            android:textColor="@color/eve_text_secondary"
            android:textSize="14sp" />

        <!-- Task A: Home Banner Image Carousel (Horizontal Swipeable Strip) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHomeBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/eve_card_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/eve_stroke">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpHomeBanners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Dot Indicators for Banner Carousel -->
        <LinearLayout
            android:id="@+id/layoutBannerDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Admin Dashboard"
            android:visibility="gone" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExams"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_enter"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:id="@+id/progressGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Loading exams…"
                android:textColor="@color/eve_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/messageGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/ivMessageIcon"
                android:layout_width="160dp"
                android:layout_height="160dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/error_404" />

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/eve_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMessageSub"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/eve_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.Eve.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Try again"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
