<?xml version='1.0' encoding='utf-8'?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/drawerLayout" android:layout_width="match_parent" android:layout_height="match_parent" style="@style/Widget.Eve.Token.Screen">
    <LinearLayout android:id="@+id/mainContentContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false" android:orientation="vertical" style="@style/Widget.Eve.Token.Column">
        <FrameLayout android:id="@+id/topBarContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <LinearLayout android:id="@+id/normalTopBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.ToolbarRow">
                        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivProfile" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Profile" android:src="@drawable/ic_user_profile" android:stateListAnimator="@animator/design_press_scale" app:shapeAppearanceOverlay="@style/ShapeCircle" />
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <ImageButton android:id="@+id/btnSearch" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:layout_marginEnd="@dimen/design_row_gap" android:contentDescription="Search exams" android:src="@drawable/ic_search" app:tint="@color/text_primary" style="@style/Widget.Eve.Token.IconButton" />
                        <FrameLayout android:id="@+id/notificationAction" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:layout_marginEnd="@dimen/design_row_gap" android:stateListAnimator="@animator/design_press_scale" android:clipChildren="true" android:clipToPadding="true" android:clickable="true" android:focusable="true" android:contentDescription="Notifications" style="@style/Widget.Eve.Token.Column">
                            <ImageView android:id="@+id/ivNotificationIdle" android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:layout_gravity="center" android:src="@drawable/ic_notification" app:tint="@color/text_primary" android:importantForAccessibility="no" />
                            <com.airbnb.lottie.LottieAnimationView android:id="@+id/btnNotification" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" android:alpha="0" app:lottie_autoPlay="false" app:lottie_loop="false" app:lottie_rawRes="@raw/notification_bell" android:layout_gravity="center" style="@style/Widget.Eve.Token.IconButton" />
                            <View android:id="@+id/dotUnread" android:layout_width="@dimen/design_card_gap" android:layout_height="@dimen/design_card_gap" android:layout_gravity="top|end" android:layout_marginTop="5dp" android:layout_marginEnd="5dp" android:visibility="gone" />
                        </FrameLayout>
                        <ImageButton android:id="@+id/btnOverflow" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="@string/home_menu" android:src="@drawable/ic_more_vert" app:tint="@color/text_primary" style="@style/Widget.Eve.Token.IconButton" />
                    </LinearLayout>
                </com.eve.app.ui.common.EveGlassToolbar>
                <LinearLayout android:id="@+id/titleGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.LargeTitleBlock">
                    <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EVE" />
                    <TextView android:id="@+id/tvWelcome" style="@style/TextAppearance.Eve.Token.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Hi, Student" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/searchTopBar" android:layout_width="match_parent" android:layout_height="match_parent" android:minHeight="@dimen/design_tab_height" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <ImageButton android:id="@+id/btnSearchBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Close search" android:src="@drawable/ic_back" app:tint="@color/text_primary" style="@style/Widget.Eve.Token.IconButton" />
                <LinearLayout android:id="@+id/layoutSearchFieldContainer" android:layout_width="0dp" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="@dimen/design_card_gap" android:layout_marginEnd="@dimen/design_card_gap" android:layout_weight="1" android:gravity="center_vertical" style="@style/Widget.Eve.Token.Tile" android:clipChildren="false" android:clipToPadding="false">
                    <EditText android:id="@+id/etSearch" style="@style/Widget.Eve.Token.Input.TelegramSearch" android:tag="eve_telegram_type" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:hint="Search exams..." android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1" />
                </LinearLayout>
                <ImageButton android:id="@+id/btnClearSearch" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Clear search" android:src="@drawable/ic_close" app:tint="@color/text_primary" android:visibility="gone" style="@style/Widget.Eve.Token.IconButton" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:id="@+id/contentSheet" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <com.eve.app.designsystem.UiArcAlertView android:id="@+id/tvOfflineBanner" style="@style/TextAppearance.Eve.Token.Secondary.orange" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/offline_banner_text" android:visibility="gone" />
            <FrameLayout android:id="@+id/panelHomeBanner" android:layout_width="match_parent" android:layout_height="@dimen/design_banner_height" android:layout_marginHorizontal="@dimen/design_screen_margin" android:layout_marginTop="@dimen/design_row_gap" android:layout_marginBottom="@dimen/design_row_gap" android:clipChildren="false" android:clipToPadding="false" android:visibility="gone" style="@style/Widget.Eve.Token.Column">
                <View android:id="@+id/blurHomeBannerMaterial" android:layout_width="match_parent" android:layout_height="match_parent" />
                <androidx.viewpager2.widget.ViewPager2 android:id="@+id/vpHomeBanners" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false" android:alpha="1" android:overScrollMode="never" />
                <View android:id="@+id/homeBannerMatte" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="false" android:focusable="false" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnHomeBannerCta" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:layout_gravity="bottom|end" android:contentDescription="Open Home banner link" android:ellipsize="end" android:maxLines="1" android:visibility="gone" />
                </FrameLayout>
            </FrameLayout>
            <LinearLayout android:id="@+id/layoutStreakPill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/design_screen_margin" android:gravity="center" android:orientation="horizontal" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.PillGroup">
                <ImageView android:id="@+id/flameStreakAnimation" android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:layout_marginEnd="@dimen/design_row_gap" android:src="@drawable/ic_flame_line" app:tint="@color/on_accent" android:layout_gravity="center" />
                <TextView android:id="@+id/tvStreakSummary" style="@style/TextAppearance.Eve.Token.Chip.OnAccent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdmin" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginHorizontal="@dimen/design_screen_margin" android:layout_marginTop="@dimen/design_screen_margin" android:text="Admin Dashboard" android:visibility="gone" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false" android:scrollbars="none">
                <com.eve.app.ui.home.HomeCategoryChipGroup android:id="@+id/chipGroupCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_section_gap" android:layout_marginEnd="@dimen/design_section_gap" app:chipSpacingHorizontal="@dimen/design_card_gap" app:singleLine="true" app:singleSelection="true" />
            </HorizontalScrollView>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvExams" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Scroll" />
                <com.eve.app.designsystem.DesignLoadingView android:id="@+id/loadingHome" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
                <LinearLayout android:id="@+id/progressGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                    <com.google.android.material.progressindicator.CircularProgressIndicator android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" style="@style/Widget.Eve.Token.Ring" android:indeterminate="true" />
                    <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:text="Loading exams…" />
                </LinearLayout>
                <LinearLayout android:id="@+id/messageGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                    <com.airbnb.lottie.LottieAnimationView android:id="@+id/ivMessageIcon" android:layout_width="160dp" android:layout_height="160dp" app:lottie_autoPlay="false" app:lottie_loop="false" app:lottie_rawRes="@raw/error_404" style="@style/Widget.Eve.Token.Lottie" />
                    <TextView android:id="@+id/tvMessage" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_section_gap" android:gravity="center" />
                    <TextView android:id="@+id/tvMessageSub" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="260dp" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" android:gravity="center" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRetry" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="18dp" android:text="Try again" android:visibility="gone" />
                </LinearLayout>
                <com.eve.app.designsystem.DesignCardView android:id="@+id/cardFloatingAirplane" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:layout_gravity="bottom|end" android:layout_marginBottom="@dimen/design_card_gap" android:clickable="true" android:focusable="true" android:visibility="gone" app:rippleColor="@android:color/transparent" style="@style/Widget.Eve.Token.Card.Clear">
                    <com.airbnb.lottie.LottieAnimationView android:id="@+id/lottieFloatingAirplane" android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:layout_gravity="center" android:contentDescription="Open community link" app:lottie_autoPlay="false" app:lottie_loop="true" app:lottie_rawRes="@raw/man_flying_on_paper_airplane" style="@style/Widget.Eve.Token.Lottie" />
                </com.eve.app.designsystem.DesignCardView>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/navDrawerPanel" android:layout_width="290dp" android:layout_height="match_parent" android:layout_gravity="start" android:clickable="true" android:focusable="true" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Modal">
        <ImageView android:id="@+id/ivDrawerGlassBlurBackground" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <View android:id="@+id/viewDrawerGlassTintOverlay" android:layout_width="match_parent" android:layout_height="match_parent" />
        <LinearLayout android:id="@+id/navDrawerContent" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivDrawerAvatar" android:layout_width="60dp" android:layout_height="60dp" android:clickable="true" android:focusable="true" android:contentDescription="Profile photo" android:scaleType="centerCrop" android:src="@drawable/ic_user_profile" android:stateListAnimator="@animator/design_press_scale" app:shapeAppearanceOverlay="@style/ShapeCircle" />
                <TextView android:id="@+id/tvDrawerUserName" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_pill_padding" android:text="Student" />
                <TextView android:id="@+id/tvDrawerUserEmail" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="student@eve.app" />
                <TextView android:id="@+id/tvDrawerPremiumStatus" style="@style/TextAppearance.Eve.Token.Secondary.green" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:visibility="gone" />
            </LinearLayout>
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false" android:scrollbars="none">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false" android:orientation="vertical" style="@style/Widget.Eve.Token.Column">
                <LinearLayout android:id="@+id/layoutDrawerProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/design_screen_margin" android:stateListAnimator="@animator/design_press_scale" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="52dp" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Row">
                    <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Profile" android:src="@drawable/ic_person" app:tint="@color/text_primary" />
                    <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_shadow_room" android:text="Profile" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutDrawerHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/design_screen_margin" android:stateListAnimator="@animator/design_press_scale" android:clickable="true" android:focusable="true" android:contentDescription="Test history" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="52dp" style="@style/Widget.Eve.Token.Row">
                    <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:src="@drawable/ic_history" app:tint="@color/text_primary" />
                    <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_shadow_room" android:text="History" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutDrawerSaved" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/design_screen_margin" android:stateListAnimator="@animator/design_press_scale" android:clickable="true" android:focusable="true" android:contentDescription="Saved questions" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="52dp" style="@style/Widget.Eve.Token.Row">
                    <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:src="@drawable/ic_bookmark" app:tint="@color/text_primary" />
                    <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_shadow_room" android:text="Saved" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutDrawerPremium" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/design_screen_margin" android:stateListAnimator="@animator/design_press_scale" android:clickable="true" android:clipChildren="false" android:clipToPadding="false" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="52dp" style="@style/Widget.Eve.Token.Row">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="-6dp" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                        <com.airbnb.lottie.LottieAnimationView android:id="@+id/lottieDrawerPremiumStarFallback" android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Premium" android:visibility="gone" app:lottie_autoPlay="false" app:lottie_loop="false" app:lottie_rawRes="@raw/premium_star" android:layout_gravity="center" style="@style/Widget.Eve.Token.Lottie" />
                    </FrameLayout>
                    <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_pill_padding" android:text="Premium" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutDrawerPerformance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/design_screen_margin" android:stateListAnimator="@animator/design_press_scale" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="52dp" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Row">
                    <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Performance" android:src="@drawable/ic_performance_increase" app:tint="@color/text_primary" />
                    <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_shadow_room" android:text="Performance" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutDrawerLeaderboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/design_screen_margin" android:stateListAnimator="@animator/design_press_scale" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="52dp" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Row">
                    <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Overall Leaderboard" android:src="@drawable/ic_leaderboard_star" app:tint="@color/text_primary" />
                    <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_shadow_room" android:text="Overall Leaderboard" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutDrawerSyllabus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/design_screen_margin" android:stateListAnimator="@animator/design_press_scale" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="52dp" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Row">
                    <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Syllabus" android:src="@drawable/ic_syllabus" app:tint="@color/text_primary" />
                    <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_shadow_room" android:text="Syllabus" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutDrawerAbout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/design_screen_margin" android:stateListAnimator="@animator/design_press_scale" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="52dp" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Row">
                    <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="About" android:src="@drawable/ic_info" app:tint="@color/text_primary" />
                    <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_shadow_room" android:text="About" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutDrawerSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/design_screen_margin" android:stateListAnimator="@animator/design_press_scale" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="52dp" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Row">
                    <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Settings" android:src="@drawable/ic_settings" app:tint="@color/text_primary" />
                    <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_shadow_room" android:text="Settings" />
                </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/maintenanceOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:focusable="true" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:src="@drawable/ic_maintenance" app:tint="@color/system_blue" />
            <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_shadow_room" android:text="Scheduled Maintenance" />
            <TextView android:id="@+id/tvMaintenanceMessage" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:gravity="center" android:text="Eve Mock Test is currently undergoing scheduled maintenance. Please check back shortly." />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCheckMaintenanceAgain" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="@dimen/design_icon_size" android:text="Check Again" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/forceUpdateOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:focusable="true" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
