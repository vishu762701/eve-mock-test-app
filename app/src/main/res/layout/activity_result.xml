                        <LinearLayout android:id="@+id/layoutEmptyFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                            <TextView android:id="@+id/tvEmptyFilterTitle" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No questions found" />
                            <TextView android:id="@+id/tvEmptyFilterSub" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" android:gravity="center" android:text="Select another filter above or tap any question on the palette." />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
                <androidx.core.widget.NestedScrollView android:id="@+id/scrollLeaderboard" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false" android:fillViewport="true" android:visibility="gone" android:overScrollMode="ifContentScrolls" style="@style/Widget.Eve.Token.Scroll">
                    <LinearLayout android:id="@+id/sectionLeaderboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false" android:orientation="vertical" style="@style/Widget.Eve.Token.Column">
                        <com.eve.app.designsystem.DesignCardView style="@style/Widget.Eve.Token.Card" android:id="@+id/cardLeaderboardHero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_card_gap">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                                <FrameLayout android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                                    <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:layout_gravity="center" android:contentDescription="Leaderboard Trophy" android:src="@drawable/ic_trophy" app:tint="@color/system_orange" />
                                </FrameLayout>
                                <TextView android:id="@+id/tvLeaderboardTabRank" style="@style/TextAppearance.Eve.Token.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_section_gap" android:text="-- / --" />
                                <TextView android:id="@+id/tvLeaderboardTabSubtitle" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="See how you rank against all students who took this exam." />
                                <com.eve.app.ui.result.ResponsiveResultRow android:id="@+id/layoutLeaderboardChips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_section_gap" android:gravity="center" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false">
                                    <TextView android:id="@+id/tvLeaderboardScoreChip" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/design_card_gap" android:text="Score: --" />
                                    <TextView android:id="@+id/tvLeaderboardPercentileChip" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Percentile: --%" />
                                </com.eve.app.ui.result.ResponsiveResultRow>
                                <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenLeaderboard" style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="@dimen/design_shadow_room" android:text="View Full Leaderboard" app:icon="@drawable/ic_trophy" app:iconGravity="textStart" app:iconPadding="@dimen/design_card_gap" />
                            </LinearLayout>
                        </com.eve.app.designsystem.DesignCardView>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </FrameLayout>
            <FrameLayout android:id="@+id/layoutResultTabContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_marginStart="@dimen/design_screen_margin" android:layout_marginEnd="@dimen/design_screen_margin" android:layout_marginTop="@dimen/design_zero" android:layout_marginBottom="@dimen/design_zero" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <com.eve.app.designsystem.DesignSegmentedTabs android:id="@+id/tabLayoutResult" android:layout_width="match_parent" android:layout_height="@dimen/design_tab_height" app:tabGravity="fill" app:tabMode="fixed" style="@style/Widget.Eve.Token.SegmentedTabs">
                    <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Overview" />
                    <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Review" />
                    <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Leaderboard" />
                </com.eve.app.designsystem.DesignSegmentedTabs>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>