<?xml version='1.0' encoding='utf-8'?>
<com.eve.app.designsystem.DesignCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:ns1="http://schemas.android.com/tools" android:id="@+id/cardMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="@dimen/design_zero" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:minHeight="@dimen/design_row_with_gap" style="@style/Widget.Eve.Token.Card" android:layout_marginBottom="@dimen/design_card_gap">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <TextView android:id="@+id/tvSenderName" style="@style/TextAppearance.Eve.Telegram.ListTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" ns1:text="Student Name"  android:tag="eve_telegram_type" />
                <TextView android:id="@+id/tvSenderEmail" style="@style/TextAppearance.Eve.Telegram.ListPreview" android:layout_width="wrap_content" android:layout_height="wrap_content" ns1:text="student@example.com"  android:tag="eve_telegram_type" />
            </LinearLayout>
            <TextView android:id="@+id/tvUnreadBadge" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEW" android:visibility="gone" ns1:visibility="visible" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnReply" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="@dimen/design_row_gap" android:text="Reply" />
            <ImageButton android:id="@+id/btnDeleteMessage" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="4dp" android:contentDescription="Delete message" android:src="@drawable/ic_delete" style="@style/Widget.Eve.Token.IconButton.Destructive" />
        </LinearLayout>
        <TextView android:id="@+id/tvMessageBody" style="@style/TextAppearance.Eve.Telegram.ListPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" ns1:text="This is a feedback message from a student regarding the mock tests."  android:tag="eve_telegram_type" />
        <TextView android:id="@+id/tvTimestamp" style="@style/TextAppearance.Eve.Telegram.ListTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="@dimen/design_card_gap" ns1:text="24 Sep 2026, 06:30 PM"  android:tag="eve_telegram_type" />
    </LinearLayout>
</com.eve.app.designsystem.DesignCardView>