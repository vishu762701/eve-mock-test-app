<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMessage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/eve_card_bg"
    app:cardCornerRadius="@dimen/eve_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/eve_shape_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSenderName"
                    style="@style/TextAppearance.Eve.Subheadline.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/eve_text"
                    tools:text="Student Name" />

                <TextView
                    android:id="@+id/tvSenderEmail"
                    style="@style/TextAppearance.Eve.Secondary.ItemSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/eve_text_secondary"
                    tools:text="student@example.com" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUnreadBadge"
                style="@style/TextAppearance.Eve.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_accent"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="NEW"
                android:textColor="@color/eve_on_accent_container"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReply"
                style="@style/Widget.Eve.TextButton"
                android:textAppearance="@style/TextAppearance.Eve.Caption1.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Reply" />

            <ImageButton
                android:id="@+id/btnDeleteMessage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete message"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/selector_eve_destructive_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessageBody"
            style="@style/TextAppearance.Eve.Secondary.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/eve_text"
            tools:text="This is a feedback message from a student regarding the mock tests." />

        <TextView
            android:id="@+id/tvTimestamp"
            style="@style/TextAppearance.Eve.Caption1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:textColor="@color/eve_text_secondary"
            tools:text="24 Sep 2026, 06:30 PM" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
