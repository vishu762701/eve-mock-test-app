<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eve_bg"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eve_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/eve_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="Manage Exam"
            android:textColor="@color/eve_text"
            android:textSize="18sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 1. Select Exam Dropdown & + New Exam button -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="1. Select Exam"
                android:textColor="@color/eve_text"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSelectExam"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                    app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                    app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                    app:boxCornerRadiusTopStart="@dimen/eve_radius_sm">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actvExam"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:fontFamily="@font/poppins"
                        android:hint="Select exam"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:popupBackground="@color/eve_surface"
                        android:singleLine="true"
                        android:textColor="@color/eve_text"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewExam"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Create New Exam"
                    android:fontFamily="@font/poppins_semibold"
                    android:minWidth="48dp"
                    android:text="+ New Exam" />
            </LinearLayout>

            <!-- 2. Main Exam (optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="2. Main Exam (optional)"
                android:textColor="@color/eve_text"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilParentExam"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/eve_radius_sm"
                app:helperText="Leave as None for a main exam. Choose a main exam to make this a sub-exam (e.g. a subject under 3rd Grade)."
                app:helperTextTextColor="@color/eve_text_secondary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvParentExam"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="@font/poppins"
                    android:hint="Main Exam (optional)"
                    android:inputType="none"
                    android:popupBackground="@color/eve_surface"
                    android:textColor="@color/eve_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 3. Test Duration (minutes) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="3. Test Duration (minutes)"
                android:textColor="@color/eve_text"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDuration"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/eve_radius_sm"
                app:helperText="Valid range: 1 to 600 minutes">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:hint="Duration in minutes"
                    android:inputType="number"
                    android:maxLength="3"
                    android:maxLines="1"
                    android:textColor="@color/eve_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 4. Test Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="4. Test Number"
                android:textColor="@color/eve_text"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTestNumber"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/eve_radius_sm"
                app:helperText="Label for the next generated test (e.g. Test 1, Test 2)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTestNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:hint="Test Number"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:textColor="@color/eve_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 5. Number of Questions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="5. Number of Questions"
                android:textColor="@color/eve_text"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilQuestionCount"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/eve_radius_sm"
                app:helperText="Valid range: 1 to 200 questions">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etQuestionCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:hint="Question Count"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textColor="@color/eve_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 6. Negative Marking -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="6. Negative Marking"
                android:textColor="@color/eve_text"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNegativeMarking"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/eve_radius_sm"
                app:helperText="Deducted per wrong answer">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNegativeMarking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:hint="e.g. 1/3, 1/4, 0.25 or 0"
                    android:inputType="text"
                    android:maxLength="10"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/eve_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 7. Scheduled Auto-Generation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="7. Scheduled Auto-Generation"
                android:textColor="@color/eve_text"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickTime"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Time: 00:00 (IST)" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAutoGen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Auto-generation"
                    android:textColor="@color/eve_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLastRunStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/eve_text_secondary"
                android:textSize="12sp"
                tools:text="Last run: Success on 24 Sep 2026, 05:00 AM" />

            <!-- Generate Test Now Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerateNow"
                style="@style/Widget.Eve.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/poppins_medium"
                android:text="⚡ Generate Test Now (Admin On-Demand)"
                android:textColor="@color/eve_primary" />

            <!-- 8. Exam Syllabus (PDF) Upload -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="8. Exam Syllabus (PDF)"
                android:textColor="@color/eve_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins"
                android:text="Upload PDF syllabus (Max 20MB). Stored in Firebase Storage."
                android:textColor="@color/eve_text_secondary"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progressBarPdf"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Uploaded Container -->
            <LinearLayout
                android:id="@+id/layoutSyllabusUploaded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="PDF"
                    android:src="@drawable/ic_description"
                    app:tint="@color/eve_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSyllabusFileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:fontFamily="@font/poppins_medium"
                        android:maxLines="1"
                        android:textColor="@color/eve_text"
                        android:textSize="13sp"
                        tools:text="ssc_cgl_syllabus.pdf" />

                    <TextView
                        android:id="@+id/tvSyllabusUploadDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/eve_text_secondary"
                        android:textSize="11sp"
                        tools:text="Uploaded: 24 Sep 2026, 11:30 AM" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReplacePdf"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="10dp"
                    android:text="Replace"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemovePdf"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="10dp"
                    android:text="Remove"
                    android:textColor="@color/eve_red"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Empty Upload Container -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadPdf"
                style="@style/Widget.Eve.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_medium"
                android:text="Upload Syllabus PDF"
                app:icon="@drawable/ic_upload" />

            <!-- 9. AI Prompt for this Exam -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="9. AI Prompt for this Exam"
                android:textColor="@color/eve_text"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilGenerationPrompt"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/eve_radius_sm"
                app:counterEnabled="true"
                app:counterMaxLength="20000"
                app:helperText="Main instruction used to generate this exam's questions">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGenerationPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:gravity="top|start"
                    android:hint="Custom syllabus topics, focus areas, pattern notes..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="20000"
                    android:minHeight="240dp"
                    android:scrollbars="vertical"
                    android:textColor="@color/eve_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 10. Generated Tests for this Exam -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="10. Generated Tests for this Exam"
                android:textColor="@color/eve_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins"
                android:text="Review or delete AI-generated question batches for this exam."
                android:textColor="@color/eve_text_secondary"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progressBarGenTests"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvNoGenTests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins"
                android:text="No generated tests for this exam yet."
                android:textColor="@color/eve_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGeneratedTestsForExam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>

    <!-- 8. Sticky Save Button at Bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eve_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <com.eve.app.ui.common.ErrorStateView
            android:id="@+id/compactErrorView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.Eve.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Save Exam Settings" />
    </LinearLayout>
</LinearLayout>
