<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eve_bg"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eve_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/eve_text" />

        <TextView
            style="@style/TextAppearance.Eve.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Manage Exam" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <!-- Card 1: Exam & Sub-Exam Selection -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/eve_surface"
                app:cardCornerRadius="@dimen/eve_radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/eve_shape_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/eve_card_padding_inner">

                    <TextView
                        android:id="@+id/tvLabelMainExam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Main Exam"
                        android:textColor="@color/eve_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilSelectExam"
                            style="@style/Widget.Eve.TextInput.Filled.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                            app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                            app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                            app:boxCornerRadiusTopStart="@dimen/eve_radius_sm">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/actvExam"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:hint="Select main exam"
                                android:inputType="textCapWords"
                                android:maxLines="1"
                                android:popupBackground="@color/eve_surface"
                                android:singleLine="true"
                                android:textColor="@color/eve_text"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNewExam"
                            style="@style/Widget.Eve.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="Create New Main Exam"
                            android:minWidth="48dp"
                            android:text="+ New Main Exam"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLabelSubExam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Sub-Exam / Subject (optional)"
                        android:textColor="@color/eve_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutSubExamContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilParentExam"
                            style="@style/Widget.Eve.TextInput.Filled.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                            app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                            app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                            app:boxCornerRadiusTopStart="@dimen/eve_radius_sm"
                            app:helperText="Choose a sub-exam or Direct Test."
                            app:helperTextTextColor="@color/eve_text_secondary">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/actvParentExam"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:hint="Sub-Exam / Subject"
                                android:inputType="textCapWords"
                                android:popupBackground="@color/eve_surface"
                                android:textColor="@color/eve_text"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddSubExam"
                            style="@style/Widget.Eve.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="Add Sub-Exam"
                            android:minWidth="48dp"
                            android:text="+ Add Sub-Exam"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Active Target Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/eve_surface"
                app:cardCornerRadius="@dimen/eve_radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/eve_shape_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/eve_card_padding_inner">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvActiveContextBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_active_context_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="MAIN EXAM"
                            android:textColor="@color/eve_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvActiveContextTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/eve_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Rajasthan CET" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvActiveContextSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="All test rules, prompt configuration, and test generation apply directly to this entity."
                        android:textColor="@color/eve_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Test Rules & Timing -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/eve_surface"
                app:cardCornerRadius="@dimen/eve_radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/eve_shape_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/eve_card_padding_inner">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Test Rules &amp; Timing"
                        android:textColor="@color/eve_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Duration and Test Number Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilDuration"
                            style="@style/Widget.Eve.TextInput.Filled"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                            app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                            app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                            app:boxCornerRadiusTopStart="@dimen/eve_radius_sm"
                            app:helperText="1 - 600 min">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDuration"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Duration (min)"
                                android:inputType="number"
                                android:maxLength="3"
                                android:maxLines="1"
                                android:textColor="@color/eve_text"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilTestNumber"
                            style="@style/Widget.Eve.TextInput.Filled"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                            app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                            app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                            app:boxCornerRadiusTopStart="@dimen/eve_radius_sm"
                            app:helperText="e.g. Test 1">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTestNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Test Number"
                                android:inputType="textCapWords"
                                android:maxLines="1"
                                android:textColor="@color/eve_text"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Question Count and Negative Marking Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilQuestionCount"
                            style="@style/Widget.Eve.TextInput.Filled"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                            app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                            app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                            app:boxCornerRadiusTopStart="@dimen/eve_radius_sm"
                            app:helperText="1 - 200 questions">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etQuestionCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Questions"
                                android:inputType="number"
                                android:maxLines="1"
                                android:textColor="@color/eve_text"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilNegativeMarking"
                            style="@style/Widget.Eve.TextInput.Filled"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                            app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                            app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                            app:boxCornerRadiusTopStart="@dimen/eve_radius_sm"
                            app:helperText="e.g. 1/3, 0.25, 0">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNegativeMarking"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Negative Mark"
                                android:inputType="text"
                                android:maxLength="10"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:textColor="@color/eve_text"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: AI Generation & Schedule -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/eve_surface"
                app:cardCornerRadius="@dimen/eve_radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/eve_shape_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/eve_card_padding_inner">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Generation &amp; Schedule"
                        android:textColor="@color/eve_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickTime"
                            style="@style/Widget.Eve.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Time: 00:00 (IST)" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchAutoGen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Auto-generation"
                            android:textColor="@color/eve_text" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPublishMode"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="New AI Tests Status"
                        app:hintTextColor="@color/eve_primary"
                        app:boxStrokeColor="@color/selector_shape_border"
                        app:boxStrokeErrorColor="@color/selector_shape_border"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="1dp">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvPublishMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/eve_text"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvPublishModeHelper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/eve_text_secondary"
                        android:textSize="12sp"
                        tools:text="Follows the global setting in App Config." />

                    <TextView
                        android:id="@+id/tvLastRunStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/eve_text_secondary"
                        android:textSize="12sp"
                        tools:text="Last run: Success on 24 Sep 2026, 05:00 AM" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerateNow"
                        style="@style/Widget.Eve.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="⚡ Generate Test Now (Admin On-Demand)"
                        android:textColor="@color/eve_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: AI Prompt -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/eve_surface"
                app:cardCornerRadius="@dimen/eve_radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/eve_shape_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/eve_card_padding_inner">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Syllabus &amp; Custom Prompt"
                        android:textColor="@color/eve_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Main instructions used by AI to generate this entity's questions."
                        android:textColor="@color/eve_text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilGenerationPrompt"
                        style="@style/Widget.Eve.TextInput.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                        app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                        app:boxCornerRadiusTopStart="@dimen/eve_radius_sm"
                        app:counterEnabled="true"
                        app:counterMaxLength="20000">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etGenerationPrompt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:hint="Custom syllabus topics, focus areas, pattern notes..."
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="20000"
                            android:minHeight="180dp"
                            android:scrollbars="vertical"
                            android:textColor="@color/eve_text"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 6: Generated Tests for this entity -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/eve_surface"
                app:cardCornerRadius="@dimen/eve_radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/eve_shape_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/eve_card_padding_inner">

                    <TextView
                        android:id="@+id/tvGenTestsSectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Generated Tests"
                        android:textColor="@color/eve_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Review or delete AI-generated question batches for this exam."
                        android:textColor="@color/eve_text_secondary"
                        android:textSize="12sp" />

                    <ProgressBar
                        android:id="@+id/progressBarGenTests"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvNoGenTests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No generated tests for this exam yet."
                        android:textColor="@color/eve_text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvGeneratedTestsForExam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Sticky Save Button Bar at Bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eve_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <com.eve.app.ui.common.ErrorStateView
            android:id="@+id/compactErrorView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.Eve.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Exam Settings" />
    </LinearLayout>
</LinearLayout>
