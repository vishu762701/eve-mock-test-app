<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eve_bg"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eve_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/eve_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Manage Exams (Syllabus &amp; AI)"
            android:textColor="@color/eve_text"
            android:textSize="19sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="Select Exam"
                android:textColor="@color/eve_text"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/spExam"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_circle_translucent"
                android:paddingHorizontal="12dp" />

            <!-- Question Count -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilQuestionCount"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Questions per Test (e.g. 25, 50, 75)"
                app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/eve_radius_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etQuestionCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:inputType="number"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Auto-generation Switch -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/eve_surface"
                app:cardCornerRadius="@dimen/eve_radius_md"
                app:cardElevation="0dp"
                app:strokeColor="@color/eve_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Nightly AI Auto-Generation"
                            android:textColor="@color/eve_text"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins"
                            android:text="Generates fresh tests into Paused state automatically"
                            android:textColor="@color/eve_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoGen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Syllabus Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSyllabus"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Exam Syllabus (topics, subjects, sub-topics)"
                app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/eve_radius_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSyllabus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="5"
                    android:textColor="@color/eve_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Custom Prompt Notes -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCustomNotes"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Custom Prompt Notes (e.g. Focus on Polity and Economy)"
                app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/eve_radius_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:textColor="@color/eve_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Eve.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Save Exam Settings" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
