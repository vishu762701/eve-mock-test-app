<?xml version="1.0" encoding="utf-8"?>
<com.eve.app.designsystem.DesignCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Eve.Token.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/design_card_gap">

    <LinearLayout
        style="@style/Widget.Eve.Token.Column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/design_card_padding">

        <LinearLayout
            style="@style/Widget.Eve.Token.Column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStyleName"
                style="@style/TextAppearance.Eve.Token.Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Style Name" />

            <TextView
                android:id="@+id/tvStyleSpecs"
                style="@style/TextAppearance.Eve.Token.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size / Line Height" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPreviewSample"
            style="@style/TextAppearance.Eve.Token.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/design_card_gap"
            android:text="Sample Text" />

    </LinearLayout>
</com.eve.app.designsystem.DesignCardView>
