<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:background="@drawable/bg_student_row"
    android:layout_marginVertical="6dp"
    android:padding="16dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:contentDescription="Notification"
        android:src="@drawable/ic_bell"
        app:tint="@color/eve_accent_text"
        android:background="@drawable/bg_student_icon"
        android:padding="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/eve_text"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Naya Exam Available!" />

        <TextView
            android:id="@+id/tvBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="?attr/eveLabelSecondary"
            android:textSize="13sp"
            tools:text="A new mock test has been added. Try it now!" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/eveLabelSecondary"
            android:textSize="13sp"
            tools:text="2 hours ago" />
    </LinearLayout>

</LinearLayout>
