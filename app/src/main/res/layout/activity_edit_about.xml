<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eve_bg"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eve_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/eve_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="Edit About Content"
            android:textColor="@color/eve_text"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.Eve.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save" />
    </LinearLayout>

    <!-- Tab Selector -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eve_surface"
        app:tabIndicatorColor="@color/eve_primary"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/eve_primary"
        app:tabTextColor="@color/eve_text_secondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacy" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terms" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Us" />
    </com.google.android.material.tabs.TabLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTitle"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Page Title"
                app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/eve_radius_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:maxLines="1"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Structured Contact Us Fields -->
            <LinearLayout
                android:id="@+id/layoutContactFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Support Email (Optional)"
                    app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                    app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                    app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                    app:boxCornerRadiusTopStart="@dimen/eve_radius_sm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSupportEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/eve_text"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Support Phone (Optional)"
                    app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                    app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                    app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                    app:boxCornerRadiusTopStart="@dimen/eve_radius_sm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:textColor="@color/eve_text"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Website URL (Optional)"
                    app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                    app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                    app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                    app:boxCornerRadiusTopStart="@dimen/eve_radius_sm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWebsite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:textColor="@color/eve_text"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Office Address (Optional)"
                    app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                    app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                    app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                    app:boxCornerRadiusTopStart="@dimen/eve_radius_sm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:inputType="textPostalAddress"
                        android:maxLines="2"
                        android:textColor="@color/eve_text"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBody"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Body Content"
                app:boxCornerRadiusBottomEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/eve_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/eve_radius_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="12"
                    android:textColor="@color/eve_text"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
