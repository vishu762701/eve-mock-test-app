<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/eve_system_grouped_background" android:orientation="vertical">

    <!-- Top Bar -->
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:background="@android:color/transparent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/design_screen_margin">

        <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="@color/eve_text" style="@style/Widget.Eve.Token.IconButton"/>

        <View android:layout_width="@dimen/design_zero" android:layout_height="@dimen/design_zero" android:layout_weight="1"/><com.eve.app.designsystem.DesignIconActionButton android:id="@+id/btnCreatePollDialog" style="@style/Widget.Eve.Token.IconAction" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:text="+ New Poll" app:icon="@drawable/ic_add"/>
    </LinearLayout>
</com.eve.app.ui.common.EveGlassToolbar>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/design_screen_margin" android:paddingBottom="@dimen/design_section_gap"><TextView style="@style/TextAppearance.Eve.Token.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Polls Management"/>

        </LinearLayout><FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipeRefresh" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:clipChildren="false">

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPolls" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutAnimation="@anim/layout_enter" android:clipToPadding="false" android:paddingVertical="@dimen/eve_space_8" android:clipChildren="false"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:indeterminate="true" android:visibility="gone"/>

        <com.eve.app.ui.common.EmptyStateView android:id="@+id/emptyStateView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>

        <com.eve.app.ui.common.ErrorStateView android:id="@+id/errorStateView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>