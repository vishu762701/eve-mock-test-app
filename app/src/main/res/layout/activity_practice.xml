<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eve_system_grouped_background"
        android:clipToPadding="false"
        android:clipChildren="false"
        >
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_translucent"
            android:padding="12dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="?attr/eveLabelPrimary" />
        <TextView
            style="@style/TextAppearance.Eve.Headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Topic-wise Practice" />
    </LinearLayout>
</com.eve.app.ui.common.EveGlassToolbar>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:background="@color/eve_system_grouped_background"
            android:clipChildren="false"
            >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >
            <TextView
                style="@style/TextAppearance.Eve.Subheadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="Choose an exam and focus on one topic. Each practice set contains up to 10 random questions." />
            <TextView
                style="@style/TextAppearance.Eve.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Exam" />
            <Spinner
                android:id="@+id/spExam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_student_row_ripple"
                android:paddingHorizontal="12dp"
                android:spinnerMode="dropdown"
                android:popupBackground="@color/eve_secondary_system_grouped_background"
                android:contentDescription="Select exam" />

            <TextView
                style="@style/TextAppearance.Eve.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Choose a topic" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTopics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacingVertical="12dp"
                app:chipSpacingHorizontal="8dp" />
            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginVertical="20dp"
                android:visibility="gone"
                android:indeterminateTint="@color/eve_primary" />
            <TextView
                android:id="@+id/tvMessage"
                style="@style/TextAppearance.Eve.Subheadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="20dp"
                android:background="@drawable/bg_student_row"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
