<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Screen">
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:orientation="horizontal" android:gravity="center_vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.ToolbarRow">
            <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="?attr/eveLabelPrimary" style="@style/Widget.Eve.Token.IconButton" />
            <View android:layout_width="@dimen/design_zero" android:layout_height="@dimen/design_zero" android:layout_weight="1" />
        </LinearLayout>
    </com.eve.app.ui.common.EveGlassToolbar>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.LargeTitleBlock">
        <TextView style="@style/TextAppearance.Eve.Token.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Topic-wise Practice" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="@dimen/design_zero" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose an exam and focus on one topic. Each practice set contains up to 10 random questions." />
            <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_icon_size" android:text="Exam" />
            <com.eve.app.designsystem.DesignSpinner android:id="@+id/spExam" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:minHeight="56dp" android:layout_marginTop="@dimen/design_card_gap" android:spinnerMode="dropdown" android:popupBackground="@color/surface_inset" android:contentDescription="Select exam" style="@style/Widget.Eve.Token.Spinner" />
            <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_icon_size" android:text="Choose a topic" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupTopics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" app:chipSpacingVertical="@dimen/design_screen_margin" app:chipSpacingHorizontal="@dimen/design_card_gap" />
            <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progress" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:layout_gravity="center" android:layout_marginVertical="@dimen/design_shadow_room" android:visibility="gone" style="@style/Widget.Eve.Token.Ring" android:indeterminate="true" />
            <TextView android:id="@+id/tvMessage" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_shadow_room" android:gravity="center" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>