<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Question Top Metadata & Actions Bar (Timer, Bookmark, Report) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <!-- Live Per-Question Timer Chip -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_question_timer_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Timer"
                    android:src="@drawable/ic_timer"
                    app:tint="@color/eve_text_secondary" />

                <TextView
                    android:id="@+id/tvQuestionTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="0:00"
                    android:textColor="@color/eve_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Bookmark Star Action (48dp touch target) -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageButton
                    android:id="@+id/btnBookmark"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mark for review"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_star_outline"
                    app:tint="@color/eve_text" />
            </FrameLayout>

            <!-- Report Question Action (48dp touch target, warning symbol ⚠️) -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp">

                <ImageButton
                    android:id="@+id/btnReport"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Report this question"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/eve_status_warning" />
            </FrameLayout>
        </LinearLayout>

        <!-- Question Text: Receives FULL Available Width -->
        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/poppins_semibold"
            android:lineSpacingExtra="5dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <RadioGroup
            android:id="@+id/rgOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.eve.app.ui.common.TelegramRadioButton
                android:id="@+id/rbA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingVertical="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp" />

            <com.eve.app.ui.common.TelegramRadioButton
                android:id="@+id/rbB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingVertical="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp" />

            <com.eve.app.ui.common.TelegramRadioButton
                android:id="@+id/rbC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingVertical="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp" />

            <com.eve.app.ui.common.TelegramRadioButton
                android:id="@+id/rbD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingVertical="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                style="@style/Widget.Eve.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Clear response" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkReview"
                style="@style/Widget.Eve.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Mark for review" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
