<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <!-- 1. Compact Meta Row (height ≈ 40dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <!-- Live Per-Question Timer Chip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_question_timer_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Timer"
                android:src="@drawable/ic_timer"
                app:tint="@color/eve_text_secondary" />

            <TextView
                android:id="@+id/tvQuestionTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="0:00"
                android:textColor="@color/eve_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bookmark Star Action (48dp touch target) -->
        <FrameLayout
            android:id="@+id/layoutBookmark"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.eve.app.ui.common.SparkleView
                android:id="@+id/sparkleView"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mark for review"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star_outline" />
        </FrameLayout>

        <!-- Report Question Action (48dp touch target, bare icon) -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp">

            <ImageButton
                android:id="@+id/btnReport"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:stateListAnimator="@animator/press_scale"
                android:contentDescription="Report this question"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_report_flag_premium"
                app:tint="@color/eve_text_secondary" />
        </FrameLayout>
    </LinearLayout>

    <!-- 2. Question Region: wrap_content, max-height managed by QuestionFitHelper -->
    <FrameLayout
        android:id="@+id/questionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginBottom="0dp">

        <ScrollView
            android:id="@+id/svQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="vertical"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="16dp">

            <TextView
                android:id="@+id/tvQuestion"
                style="@style/TextAppearance.Eve.QuestionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/eve_text"
                android:textSize="18sp" />
        </ScrollView>

        <ImageView
            android:id="@+id/ivScrollHint"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="2dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/eve_text_secondary"
            android:alpha="0.7"
            android:visibility="gone"
            android:contentDescription="Scroll for more" />
    </FrameLayout>

    <!-- 3. Options Block: wrap_content, directly beneath question with 10dp gap -->
    <RadioGroup
        android:id="@+id/rgOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <com.eve.app.ui.common.TelegramRadioButton
            android:id="@+id/rbA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/poppins_regular"
            android:paddingVertical="10dp"
            android:paddingEnd="12dp"
            android:textSize="16sp" />

        <com.eve.app.ui.common.TelegramRadioButton
            android:id="@+id/rbB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/poppins_regular"
            android:paddingVertical="10dp"
            android:paddingEnd="12dp"
            android:textSize="16sp" />

        <com.eve.app.ui.common.TelegramRadioButton
            android:id="@+id/rbC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/poppins_regular"
            android:paddingVertical="10dp"
            android:paddingEnd="12dp"
            android:textSize="16sp" />

        <com.eve.app.ui.common.TelegramRadioButton
            android:id="@+id/rbD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/poppins_regular"
            android:paddingVertical="10dp"
            android:paddingEnd="12dp"
            android:textSize="16sp" />
    </RadioGroup>
</LinearLayout>
