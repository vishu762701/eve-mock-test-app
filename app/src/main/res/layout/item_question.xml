<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/questionScroll" android:fillViewport="true" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="@dimen/design_row_gap" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Timer" android:src="@drawable/ic_timer" app:tint="@color/text_secondary" />
                <TextView android:id="@+id/tvQuestionTimer" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_row_gap" android:text="0:00" />
            </LinearLayout>
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
            <FrameLayout android:id="@+id/layoutBookmark" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <ImageButton android:id="@+id/btnBookmark" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:layout_gravity="center" android:contentDescription="Bookmark question" android:scaleType="fitCenter" android:src="@drawable/ic_star_outline" app:tint="@color/accent_icon" style="@style/Widget.Eve.Token.IconButton" />
            </FrameLayout>
            <FrameLayout android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="4dp" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <ImageButton android:id="@+id/btnReport" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:layout_gravity="center" android:contentDescription="Report this question" android:scaleType="fitCenter" android:src="@drawable/ic_report_flag_premium" app:tint="@color/text_secondary" style="@style/Widget.Eve.Token.IconButton" />
            </FrameLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/questionContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_zero" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <TextView android:id="@+id/tvQuestion" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="left" />
        </FrameLayout>
        <FrameLayout android:id="@+id/optionsMaterialHost" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_section_gap" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <RadioGroup android:id="@+id/rgOptions" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.eve.app.ui.common.TelegramRadioButton android:id="@+id/rbA" style="@style/Widget.Eve.Token.Choice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_row_gap" />
                <com.eve.app.ui.common.TelegramRadioButton android:id="@+id/rbB" style="@style/Widget.Eve.Token.Choice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_row_gap" />
                <com.eve.app.ui.common.TelegramRadioButton android:id="@+id/rbC" style="@style/Widget.Eve.Token.Choice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_row_gap" />
                <com.eve.app.ui.common.TelegramRadioButton android:id="@+id/rbD" style="@style/Widget.Eve.Token.Choice" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </RadioGroup>
        </FrameLayout>
    </LinearLayout>
</ScrollView>