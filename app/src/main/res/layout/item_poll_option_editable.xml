<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">

    <com.eve.app.ui.common.TelegramRadioButton
        android:id="@+id/radioQuizCorrect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:button="@null"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etOptionText"
        style="@style/TextAppearance.Eve.Token.Body"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:hint="Option"
        android:inputType="textCapSentences"
        android:maxLength="100"
        android:maxLines="1"
        android:textColor="@color/telegram_type_primary"
        android:textColorHint="@color/telegram_type_secondary" />

    <TextView
        android:id="@+id/tvOptionCounter"
        style="@style/TextAppearance.Eve.Caption1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:textColor="@color/telegram_type_secondary"
        android:text="100" />

    <ImageButton
        android:id="@+id/btnDeleteOption"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/telegram_action_icon_ripple"
        android:contentDescription="Delete option"
        android:scaleType="centerInside"
        android:src="@drawable/ic_close"
        app:tint="@color/telegram_type_secondary" />
</LinearLayout>
