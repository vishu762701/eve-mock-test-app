<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eve_system_grouped_background"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_translucent"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="?attr/eveLabelPrimary" />

        <TextView
            style="@style/TextAppearance.Eve.Headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:text="About"
            android:textColor="?attr/eveLabelPrimary" />
    </LinearLayout>
</com.eve.app.ui.common.EveGlassToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
            android:clipChildren="false"
            >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
        android:clipToPadding="false"
        android:clipChildren="false"
        >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="App icon"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/tvAppName"
            style="@style/TextAppearance.Eve.Secondary.SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="@color/eve_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVersion"
            style="@style/TextAppearance.Eve.Secondary.ItemSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/eveLabelSecondary"
            tools:text="Version 1.0" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="@color/eve_separator" />

    <LinearLayout
        android:id="@+id/rowPrivacyPolicy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_student_row"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Privacy Policy"
            android:src="@drawable/ic_info"
            app:tint="@color/eve_system_blue" />

        <TextView
            style="@style/TextAppearance.Eve.Secondary.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Privacy Policy"
            android:textColor="@color/eve_text" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:background="@color/eve_separator" />

    <LinearLayout
        android:id="@+id/rowTerms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_student_row"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Terms of Service"
            android:src="@drawable/ic_info"
            app:tint="@color/eve_system_blue" />

        <TextView
            style="@style/TextAppearance.Eve.Secondary.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Terms of Service"
            android:textColor="@color/eve_text" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:background="@color/eve_separator" />

    <LinearLayout
        android:id="@+id/rowContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_student_row"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Contact us"
            android:src="@drawable/ic_info"
            app:tint="@color/eve_system_blue" />

        <TextView
            style="@style/TextAppearance.Eve.Secondary.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Contact Us"
            android:textColor="@color/eve_text" />
    </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
