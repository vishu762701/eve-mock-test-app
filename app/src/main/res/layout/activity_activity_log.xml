<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    style="@style/Widget.Eve.Token.Screen"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.eve.app.ui.common.EveGlassToolbar
        android:id="@+id/glassToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.eve.app.ui.admin.tg.TelegramActionBar
            android:id="@+id/actionBar"
            android:layout_width="match_parent"
            android:layout_height="56dp" />
    </com.eve.app.ui.common.EveGlassToolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.eve.app.ui.admin.tg.TelegramSegmentedTabs
            android:id="@+id/tabsRange"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvActiveFilters"
            style="@style/TextAppearance.Eve.Telegram.SettingsDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            android:textColor="@color/telegram_type_secondary"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAuditLogs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never" />

            <com.eve.app.designsystem.TelegramRadialProgressView
                android:id="@+id/progressBar"
                android:layout_width="@dimen/design_ring_size"
                android:layout_height="@dimen/design_ring_size"
                android:layout_gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/emptyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieEmpty"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    app:lottie_rawRes="@raw/search"
                    app:lottie_loop="true"
                    app:lottie_autoPlay="true" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    style="@style/TextAppearance.Eve.Telegram.NavigationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No Recent Actions"
                    android:tag="eve_telegram_type" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    style="@style/TextAppearance.Eve.Telegram.SettingsDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="No activity logs match the selected filters."
                    android:tag="eve_telegram_type" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
