<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eve_bg">

    <!-- 1. Background: Gentle breathing Apple Liquid Glass ambient canvas -->
    <com.eve.app.ui.login.AmbientBackgroundView
        android:id="@+id/ambientBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 2. Apple iOS 26 Liquid Glass Modal Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="24dp"
                android:layout_marginVertical="32dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false"
                app:strokeColor="@color/eve_separator"
                app:strokeWidth="@dimen/eve_stroke_hairline">

                <!-- Real-time BlurView layer for authentic Liquid Glass frosted-glass effect -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurViewLogin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:blurOverlayColor="@color/eve_material_thick" />

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/cardScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="28dp"
                        android:paddingBottom="28dp">

                        <!-- 3. Header Bar: Title / Branding + Modal Close Button -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvLogo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:letterSpacing="0.03"
                                    android:text="EVE"
                                    android:textColor="@color/eve_login_text"
                                    android:textSize="26sp" />

                                <TextView
                                    android:id="@+id/tvTagline"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="Mock Test &amp; Preparation"
                                    android:textColor="@color/eve_login_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Close (X) icon in top-right corner of the modal -->
                            <ImageView
                                android:id="@+id/btnCloseModal"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle_translucent"
                                android:contentDescription="Close"
                                android:padding="7dp"
                                android:src="@drawable/ic_close"
                                app:tint="@color/eve_login_text_secondary" />

                        </LinearLayout>

                        <!-- Subtitle / Helper Prompt -->
                        <TextView
                            android:id="@+id/tvSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="16dp"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:text="Sign in to save your mock tests and sync performance."
                            android:textColor="@color/eve_login_text_secondary"
                            android:textSize="13sp" />

                        <!-- 4. Apple iOS 26 Segmented Control: Sign In / Join -->
                        <LinearLayout
                            android:id="@+id/layoutSegmentedControl"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_tab_segmented_track"
                            android:orientation="horizontal"
                            android:padding="3dp">

                            <!-- Segment 1: Sign In -->
                            <FrameLayout
                                android:id="@+id/tabContainerSignIn"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">

                                <View
                                    android:id="@+id/indicatorTabSignIn"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_login_tab_indicator" />

                                <TextView
                                    android:id="@+id/tvTabSignIn"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="center"
                                    android:text="Sign In"
                                    android:textColor="@color/eve_login_text"
                                    android:textSize="14sp" />
                            </FrameLayout>

                            <!-- Segment 2: Join -->
                            <FrameLayout
                                android:id="@+id/tabContainerJoin"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">

                                <View
                                    android:id="@+id/indicatorTabJoin"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_login_tab_indicator"
                                    android:visibility="invisible" />

                                <TextView
                                    android:id="@+id/tvTabJoin"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="center"
                                    android:text="Join"
                                    android:textColor="@color/eve_login_text_secondary"
                                    android:textSize="14sp" />
                            </FrameLayout>

                        </LinearLayout>

                        <!-- 5. Form Fields: Refined Apple-style Inputs -->

                        <!-- Full Name input (visible only during Join / Sign Up mode) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilName"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Full Name"
                            android:textColorHint="@color/eve_login_text_hint"
                            android:visibility="gone"
                            app:boxBackgroundColor="@color/eve_login_input_bg"
                            app:boxCornerRadiusBottomEnd="@dimen/eve_radius_tile"
                            app:boxCornerRadiusBottomStart="@dimen/eve_radius_tile"
                            app:boxCornerRadiusTopEnd="@dimen/eve_radius_tile"
                            app:boxCornerRadiusTopStart="@dimen/eve_radius_tile"
                            app:boxStrokeColor="@color/sl_glass_input_stroke"
                            app:boxStrokeWidth="@dimen/eve_stroke_hairline"
                            app:boxStrokeWidthFocused="1dp"
                            app:hintTextColor="@color/eve_login_text_secondary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:inputType="textCapWords"
                                android:maxLines="1"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="14dp"
                                android:textColor="@color/eve_login_text"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Email Label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Email"
                            android:textColor="@color/eve_login_text_secondary"
                            android:textSize="13sp" />

                        <!-- Email input -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilEmail"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:textColorHint="@color/eve_login_text_hint"
                            app:boxBackgroundColor="@color/eve_login_input_bg"
                            app:boxCornerRadiusBottomEnd="@dimen/eve_radius_tile"
                            app:boxCornerRadiusBottomStart="@dimen/eve_radius_tile"
                            app:boxCornerRadiusTopEnd="@dimen/eve_radius_tile"
                            app:boxCornerRadiusTopStart="@dimen/eve_radius_tile"
                            app:boxStrokeColor="@color/sl_glass_input_stroke"
                            app:boxStrokeWidth="@dimen/eve_stroke_hairline"
                            app:boxStrokeWidthFocused="1dp"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:hint="name@example.com"
                                android:inputType="textEmailAddress"
                                android:maxLines="1"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="14dp"
                                android:textColor="@color/eve_login_text"
                                android:textColorHint="@color/eve_login_text_hint"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Password Label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Password"
                            android:textColor="@color/eve_login_text_secondary"
                            android:textSize="13sp" />

                        <!-- Password input with eye icon and placeholder -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPassword"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColorHint="@color/eve_login_text_hint"
                            app:boxBackgroundColor="@color/eve_login_input_bg"
                            app:boxCornerRadiusBottomEnd="@dimen/eve_radius_tile"
                            app:boxCornerRadiusBottomStart="@dimen/eve_radius_tile"
                            app:boxCornerRadiusTopEnd="@dimen/eve_radius_tile"
                            app:boxCornerRadiusTopStart="@dimen/eve_radius_tile"
                            app:boxStrokeColor="@color/sl_glass_input_stroke"
                            app:boxStrokeWidth="@dimen/eve_stroke_hairline"
                            app:boxStrokeWidthFocused="1dp"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/eve_login_text_secondary"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:hint="At least 6 characters"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="14dp"
                                android:textColor="@color/eve_login_text"
                                android:textColorHint="@color/eve_login_text_hint"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Error Text -->
                        <TextView
                            android:id="@+id/tvError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/eve_login_error"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <!-- 6. Primary Action: Apple System Blue Pill Button with In-Button Progress -->
                        <FrameLayout
                            android:id="@+id/layoutBtnSubmit"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="18dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSubmit"
                                style="@style/Widget.Eve.Button"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:backgroundTint="@color/eve_system_blue"
                                android:fontFamily="sans-serif-medium"
                                android:text="Sign In"
                                android:textColor="@color/eve_white"
                                android:textSize="16sp"
                                app:cornerRadius="@dimen/eve_radius_pill"
                                app:strokeColor="@android:color/transparent"
                                app:strokeWidth="0dp" />

                            <ProgressBar
                                android:id="@+id/progressSubmit"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:indeterminate="true"
                                android:indeterminateTint="@color/eve_white"
                                android:visibility="gone" />
                        </FrameLayout>

                        <!-- 7. Hairline Divider -->
                        <LinearLayout
                            android:id="@+id/dividerLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="4dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="@dimen/eve_stroke_hairline"
                                android:layout_weight="1"
                                android:background="@color/eve_separator" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="12dp"
                                android:fontFamily="sans-serif"
                                android:text="or"
                                android:textColor="@color/eve_login_text_secondary"
                                android:textSize="13sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="@dimen/eve_stroke_hairline"
                                android:layout_weight="1"
                                android:background="@color/eve_separator" />
                        </LinearLayout>

                        <!-- 8. Social Login: Google Button (Apple-style secondary grouped/glass button) -->
                        <FrameLayout
                            android:id="@+id/layoutBtnGoogle"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="12dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGoogle"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:backgroundTint="@color/eve_login_google_bg"
                                android:contentDescription="Continue with Google"
                                android:fontFamily="sans-serif-medium"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="0dp"
                                android:text="Continue with Google"
                                android:textColor="@color/eve_login_google_text"
                                android:textSize="15sp"
                                app:cornerRadius="@dimen/eve_radius_pill"
                                app:icon="@drawable/ic_social_google"
                                app:iconGravity="textStart"
                                app:iconPadding="10dp"
                                app:iconSize="20dp"
                                app:iconTint="@null"
                                app:strokeColor="@color/eve_login_google_border"
                                app:strokeWidth="@dimen/eve_stroke_hairline" />

                            <ProgressBar
                                android:id="@+id/progressGoogle"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:indeterminate="true"
                                android:indeterminateTint="@color/eve_system_blue"
                                android:visibility="gone" />
                        </FrameLayout>

                        <!-- 9. Mode Switch: Understated System Blue Text Link -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleMode"
                            style="@style/Widget.Eve.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Don't have an account? Sign Up"
                            android:textColor="@color/eve_system_blue"
                            android:textSize="13sp" />

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </ScrollView>

</FrameLayout>
