<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eve_bg">

    <!-- 1. Background: Animated 3D Liquid-Metal / Mercury Blob View -->
    <com.eve.app.ui.login.AmbientBackgroundView
        android:id="@+id/ambientBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="32dp">

            <!-- 2. Modal Card: Dark near-black semi-transparent glassmorphism with ~24px rounded corners -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/eve_login_glass_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/eve_login_glass_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="26dp">

                    <!-- 3. Header / Tabs Row (Sign In / Join + Orange Underline + Close X icon) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Tabs: Sign In & Join -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Tab 1: Sign In -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="start"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvTabSignIn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sign In"
                                    android:textColor="@color/eve_login_text"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <View
                                    android:id="@+id/indicatorTabSignIn"
                                    android:layout_width="28dp"
                                    android:layout_height="3dp"
                                    android:layout_marginTop="5dp"
                                    android:background="@drawable/bg_indicator_active" />
                            </LinearLayout>

                            <View
                                android:layout_width="22dp"
                                android:layout_height="1dp" />

                            <!-- Tab 2: Join -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="start"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvTabJoin"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Join"
                                    android:textColor="@color/eve_login_text_secondary"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <View
                                    android:id="@+id/indicatorTabJoin"
                                    android:layout_width="28dp"
                                    android:layout_height="3dp"
                                    android:layout_marginTop="5dp"
                                    android:background="@drawable/bg_indicator_active"
                                    android:visibility="invisible" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- Close (X) icon in top-right corner of the modal -->
                        <ImageView
                            android:id="@+id/btnCloseModal"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_translucent"
                            android:contentDescription="Close"
                            android:padding="6dp"
                            android:src="@drawable/ic_close"
                            app:tint="@color/eve_login_text_secondary" />

                    </LinearLayout>

                    <!-- Preserved legacy title views (retains zero-regression binding references) -->
                    <TextView
                        android:id="@+id/tvLogo"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvTagline"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- 4. Form Fields -->
                    <!-- Full Name input (visible only during Join / Sign Up mode) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilName"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="Full Name"
                        android:textColorHint="@color/eve_login_text_secondary"
                        android:visibility="gone"
                        app:boxBackgroundColor="@color/eve_login_input_bg"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/eve_login_input_border"
                        app:boxStrokeWidth="1dp"
                        app:hintTextColor="@color/eve_login_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:textColor="@color/eve_login_text"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="6dp"
                        android:text="Email"
                        android:textColor="@color/eve_login_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Email input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColorHint="@color/eve_login_text_secondary"
                        app:boxBackgroundColor="@color/eve_login_input_bg"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/eve_login_input_border"
                        app:boxStrokeWidth="1dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="name@example.com"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:textColor="@color/eve_login_text"
                            android:textColorHint="@color/eve_login_text_hint"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="6dp"
                        android:text="Password"
                        android:textColor="@color/eve_login_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Password input with eye icon and "At least 6 characters" placeholder -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColorHint="@color/eve_login_text_secondary"
                        app:boxBackgroundColor="@color/eve_login_input_bg"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/eve_login_input_border"
                        app:boxStrokeWidth="1dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/eve_login_text_secondary"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="At least 6 characters"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="@color/eve_login_text"
                            android:textColorHint="@color/eve_login_text_hint"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Error Text -->
                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#EF4444"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <!-- Submit Button with In-Button Loading Indicator -->
                    <FrameLayout
                        android:id="@+id/layoutBtnSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmit"
                            style="@style/Widget.Eve.Button"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:backgroundTint="#FF7A00"
                            android:text="Sign In"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:strokeColor="#50FFA040"
                            app:strokeWidth="1dp" />

                        <ProgressBar
                            android:id="@+id/progressSubmit"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:indeterminateTint="#FFFFFF"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Divider -->
                    <LinearLayout
                        android:id="@+id/dividerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/eve_login_glass_border" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:text="or"
                            android:textColor="@color/eve_login_text_secondary"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/eve_login_glass_border" />
                    </LinearLayout>

                    <!-- 5. Social Login: Google Button (Horizontally centered, no empty side spacing) -->
                    <FrameLayout
                        android:id="@+id/layoutBtnGoogle"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:layout_gravity="center_horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGoogle"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:backgroundTint="@color/eve_login_google_bg"
                            android:text="Continue with Google"
                            android:textColor="@color/eve_login_google_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_social_google"
                            app:iconGravity="textStart"
                            app:iconPadding="10dp"
                            app:iconTint="@null"
                            app:strokeColor="@color/eve_login_google_border"
                            app:strokeWidth="1dp" />

                        <ProgressBar
                            android:id="@+id/progressGoogle"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:indeterminateTint="#34A853"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Toggle Mode (Sign In / Sign Up) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleMode"
                        style="@style/Widget.Eve.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Don't have an account? Sign Up"
                        android:textColor="@color/eve_login_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</FrameLayout>
