<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Screen">
    <ScrollView android:id="@+id/scrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="ifContentScrolls" android:scrollbars="none" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll">
        <FrameLayout android:id="@+id/contentLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <LinearLayout android:id="@+id/cardLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                    <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="@color/system_blue" style="@style/Widget.Eve.Token.IconButton" />
                    <View android:layout_width="@dimen/design_zero" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/tvLogo" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EVE" />
                </LinearLayout>
                <TextView android:id="@+id/tvTagline" style="@style/TextAppearance.Eve.Token.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="36dp" android:text="Welcome back" />
                <TextView android:id="@+id/tvSubtitle" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:layout_marginBottom="28dp" android:text="Sign in to save your mock tests and sync performance." />
                <com.eve.app.designsystem.DesignInputLayout android:id="@+id/tilName" style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_screen_margin" android:hint="Full name" android:visibility="gone">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etName" style="@style/Widget.Eve.Token.Input" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="textCapWords" android:maxLines="1" />
                </com.eve.app.designsystem.DesignInputLayout>
                <com.eve.app.designsystem.DesignInputLayout android:id="@+id/tilEmail" style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_screen_margin" android:hint="Email">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEmail" style="@style/Widget.Eve.Token.Input" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="textEmailAddress" android:maxLines="1" />
                </com.eve.app.designsystem.DesignInputLayout>
                <com.eve.app.designsystem.DesignInputLayout android:id="@+id/tilPassword" style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Password" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPassword" style="@style/Widget.Eve.Token.Input" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:imeOptions="actionDone" android:inputType="textPassword" android:maxLines="1" />
                </com.eve.app.designsystem.DesignInputLayout>
                <TextView android:id="@+id/tvError" style="@style/TextAppearance.Eve.Token.Secondary.red" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:visibility="gone" />
                <FrameLayout android:id="@+id/layoutBtnSubmit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="@dimen/design_shadow_room" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSubmit" style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:text="Sign In" />
                    <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressSubmit" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:layout_gravity="center" android:indeterminate="true" android:visibility="gone" style="@style/Widget.Eve.Token.Ring" />
                </FrameLayout>
                <LinearLayout android:id="@+id/dividerLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_icon_size" android:layout_marginBottom="4dp" android:gravity="center" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                    <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/design_screen_margin" android:text="or" />
                </LinearLayout>
                <FrameLayout android:id="@+id/layoutBtnGoogle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="@dimen/design_screen_margin" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnGoogle" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:contentDescription="Continue with Google" android:text="Continue with Google" app:icon="@drawable/ic_social_google" app:iconGravity="textStart" app:iconPadding="@dimen/design_card_padding" />
                    <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressGoogle" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:layout_gravity="center" android:indeterminate="true" android:visibility="gone" style="@style/Widget.Eve.Token.Ring" />
                </FrameLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnToggleMode" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="@dimen/design_pill_padding" android:text="Don't have an account? Sign Up" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>