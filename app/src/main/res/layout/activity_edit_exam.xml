<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Screen">
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.ToolbarRow">
            <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="@color/telegram_type_primary" style="@style/Widget.Eve.Token.IconButton" />
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
            <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressBar" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:indeterminate="true" android:visibility="gone" style="@style/Widget.Eve.Token.Ring" />
        </LinearLayout>
    </com.eve.app.ui.common.EveGlassToolbar>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.LargeTitleBlock">
        <TextView android:id="@+id/tvToolbarTitle" style="@style/TextAppearance.Eve.Telegram.NavigationTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Edit Exam"  android:tag="eve_telegram_type" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <com.eve.app.designsystem.DesignCardView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Eve.Token.Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                    <TextView style="@style/TextAppearance.Eve.Token.Heading.blue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Exam Information" />
                    <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:hint="Exam Name">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etExamName" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="textCapWords" style="@style/Widget.Eve.Token.Input" />
                    </com.eve.app.designsystem.DesignInputLayout>
                    <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:hint="Time Limit (minutes)">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etExamMinutes" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="number" style="@style/Widget.Eve.Token.Input" />
                    </com.eve.app.designsystem.DesignInputLayout>
                    <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:text="Category" />
                    <com.eve.app.designsystem.DesignSpinner android:id="@+id/spCategory" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:layout_marginTop="4dp" style="@style/Widget.Eve.Token.Spinner" />
                    <TextView style="@style/TextAppearance.Eve.Token.Body.blue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_section_gap" android:text="Category Cutoffs (Optional)" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                        <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:hint="General">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCutoffGeneral" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="numberDecimal" style="@style/Widget.Eve.Token.Input" />
                        </com.eve.app.designsystem.DesignInputLayout>
                        <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:hint="OBC">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCutoffObc" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="numberDecimal" style="@style/Widget.Eve.Token.Input" />
                        </com.eve.app.designsystem.DesignInputLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                        <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:hint="SC">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCutoffSc" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="numberDecimal" style="@style/Widget.Eve.Token.Input" />
                        </com.eve.app.designsystem.DesignInputLayout>
                        <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:hint="ST">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCutoffSt" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="numberDecimal" style="@style/Widget.Eve.Token.Input" />
                        </com.eve.app.designsystem.DesignInputLayout>
                    </LinearLayout>
                    <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" android:hint="EWS Cutoff">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCutoffEws" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="numberDecimal" style="@style/Widget.Eve.Token.Input" />
                    </com.eve.app.designsystem.DesignInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveExamDetails" style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="@dimen/design_section_gap" android:text="Save Exam Details" />
                </LinearLayout>
            </com.eve.app.designsystem.DesignCardView>
            <com.eve.app.designsystem.DesignCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" style="@style/Widget.Eve.Token.Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                        <TextView style="@style/TextAppearance.Eve.Token.Heading.blue" android:id="@+id/tvQuestionsHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Questions (0)" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAddQuestion" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="0dp" android:layout_height="@dimen/design_touch_min" android:layout_weight="1" android:layout_marginEnd="@dimen/design_row_gap" android:text="+ Add Question" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnBulkUpload" style="@style/Widget.Eve.Token.Button" android:layout_width="0dp" android:layout_height="@dimen/design_touch_min" android:layout_weight="1" android:layout_marginStart="@dimen/design_row_gap" android:text="📥 Bulk Upload" />
                    </LinearLayout>
                    <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:id="@+id/tvFormatHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:text="Expected format: Question, OptionA, OptionB, OptionC, OptionD, CorrectOption, Explanation" />
                    <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:id="@+id/tvNoQuestions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_shadow_room" android:layout_marginBottom="@dimen/design_section_gap" android:gravity="center" android:text="No questions added yet. Add manually or bulk upload via CSV/Excel." android:visibility="gone" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvQuestions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:nestedScrollingEnabled="false" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll.Inner" />
                </LinearLayout>
            </com.eve.app.designsystem.DesignCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>