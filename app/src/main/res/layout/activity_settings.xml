<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Screen">
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.ToolbarRow">
            <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="@color/text_primary" style="@style/Widget.Eve.Token.IconButton" />
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
    </com.eve.app.ui.common.EveGlassToolbar>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.LargeTitleBlock">
        <TextView style="@style/TextAppearance.Eve.Telegram.NavigationTitle" android:tag="eve_telegram_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Settings" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:overScrollMode="ifContentScrolls" android:scrollbars="none" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <TextView style="@style/TextAppearance.Eve.Telegram.SettingsSection" android:tag="eve_telegram_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PREFERENCES" />
            <com.eve.app.designsystem.DesignCardView style="@style/Widget.Eve.Token.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                    <LinearLayout android:id="@+id/rowReminder" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/design_bottom_bar_height" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                        <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Reminder" android:src="@drawable/ic_bell" app:tint="@color/system_orange" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_pill_padding" android:layout_weight="1" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                            <TextView style="@style/TextAppearance.Eve.Telegram.SettingsLabel" android:tag="eve_telegram_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily Practice Reminder" />
                            <TextView style="@style/TextAppearance.Eve.Telegram.SettingsDetail" android:tag="eve_telegram_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Get notified every day to keep your streak" />
                        </LinearLayout>
                        <com.eve.app.designsystem.UiArcSwitch android:id="@+id/switchReminder" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.Eve.Token.Switch" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/rowDailyGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/design_bottom_bar_height" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                        <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Daily Goal" android:src="@drawable/ic_trophy" app:tint="@color/system_orange" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_pill_padding" android:layout_weight="1" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                            <TextView style="@style/TextAppearance.Eve.Telegram.SettingsLabel" android:tag="eve_telegram_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily Goal" />
                            <TextView android:id="@+id/tvDailyGoalValue" style="@style/TextAppearance.Eve.Telegram.SettingsDetail" android:tag="eve_telegram_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 tests per day" />
                        </LinearLayout>
                        <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:src="@drawable/ic_chevron_right" app:tint="@color/text_secondary" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/rowTargetExams" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/design_bottom_bar_height" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                        <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="My Exams" android:src="@drawable/ic_topic" app:tint="@color/system_blue" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_pill_padding" android:layout_weight="1" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                            <TextView style="@style/TextAppearance.Eve.Telegram.SettingsLabel" android:tag="eve_telegram_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Exams" />
                            <TextView style="@style/TextAppearance.Eve.Telegram.SettingsDetail" android:tag="eve_telegram_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choose exams for personalized feed" />
                        </LinearLayout>
                        <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:src="@drawable/ic_chevron_right" app:tint="@color/text_secondary" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/rowLanguage" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/design_bottom_bar_height" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                        <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="App Language" android:src="@drawable/ic_language" app:tint="@color/system_blue" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_pill_padding" android:layout_weight="1" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                            <TextView style="@style/TextAppearance.Eve.Telegram.SettingsLabel" android:tag="eve_telegram_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="App Language" />
                            <TextView android:id="@+id/tvLanguageValue" style="@style/TextAppearance.Eve.Telegram.SettingsDetail" android:tag="eve_telegram_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="System default" />
                        </LinearLayout>
                        <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:src="@drawable/ic_chevron_right" app:tint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.eve.app.designsystem.DesignCardView>
            <TextView style="@style/TextAppearance.Eve.Telegram.SettingsSection" android:tag="eve_telegram_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ACCOUNT" />
            <com.eve.app.designsystem.DesignCardView style="@style/Widget.Eve.Token.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/rowDeleteAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/design_bottom_bar_height" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                    <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Delete Account" android:src="@drawable/ic_delete" app:tint="@color/system_red" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_pill_padding" android:layout_weight="1" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                        <TextView style="@style/TextAppearance.Eve.Token.Body.red" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Delete Account" />
                        <TextView style="@style/TextAppearance.Eve.Telegram.SettingsDetail" android:tag="eve_telegram_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Permanently delete account and all data" />
                    </LinearLayout>
                    <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Go" android:src="@drawable/ic_chevron_right" app:tint="@color/text_secondary" />
                </LinearLayout>
            </com.eve.app.designsystem.DesignCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>