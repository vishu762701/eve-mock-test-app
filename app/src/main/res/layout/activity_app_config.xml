<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Screen">
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.ToolbarRow">
            <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="@color/telegram_type_primary" style="@style/Widget.Eve.Token.IconButton" />
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
            <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressBar" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:visibility="gone" style="@style/Widget.Eve.Token.Ring" android:indeterminate="true" />
        </LinearLayout>
    </com.eve.app.ui.common.EveGlassToolbar>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.LargeTitleBlock">
        <TextView style="@style/TextAppearance.Eve.Telegram.NavigationTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="App Config &amp; Maintenance"  android:tag="eve_telegram_type" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <com.eve.app.designsystem.DesignCardView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Eve.Token.Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                    <TextView style="@style/TextAppearance.Eve.Token.Heading.blue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Live Backend Controls" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_section_gap" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                            <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Maintenance Mode" />
                            <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Blocks non-admin users from using the app" />
                        </LinearLayout>
                        <com.eve.app.designsystem.DesignSwitch android:id="@+id/switchMaintenanceMode" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.Eve.Token.Switch" />
                    </LinearLayout>
                    <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:hint="Maintenance Message">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMaintenanceMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:minLines="2" style="@style/Widget.Eve.Token.Input" />
                    </com.eve.app.designsystem.DesignInputLayout>
                    <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:hint="Minimum Supported Version Code">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMinVersionCode" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="number" style="@style/Widget.Eve.Token.Input" />
                    </com.eve.app.designsystem.DesignInputLayout>
                    <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:id="@+id/tvCurrentVersionNotice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Current installed app version code: 1" />
                    <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_section_gap" android:text="Default AI Test Status" />
                    <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Applies to all exams unless an exam overrides it. Existing tests are not changed." />
                    <RadioGroup android:id="@+id/rgDefaultPublishMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap">
                        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rbPublishPaused" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Keep new AI tests paused (review first)" style="@style/Widget.Eve.Token.Radio" />
                        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rbPublishLive" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Publish new AI tests live automatically" style="@style/Widget.Eve.Token.Radio" />
                    </RadioGroup>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveConfig" style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="@dimen/design_section_gap" android:text="Save &amp; Apply Configuration" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTestAiHealth" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="@dimen/design_card_padding" android:text="Test AI Connection" />
                </LinearLayout>
            </com.eve.app.designsystem.DesignCardView>
            <com.eve.app.designsystem.DesignCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" style="@style/Widget.Eve.Token.Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                    <TextView style="@style/TextAppearance.Eve.Token.Heading.blue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Firebase Console Remote Config Guide" />
                    <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:text="To manage safety limits directly in the Firebase Console without changing backend code:\n\n1. Go to Firebase Console -&gt; Engage -&gt; Remote Config.\n\n2. Configure these parameters:\n   • minimum_supported_version_code: (Number, e.g. 2). Users with lower version will see a blocking update prompt.\n   • maintenance_mode: (Boolean: true/false). Halts student access immediately.\n   • maintenance_message: (String). The message displayed to students during maintenance.\n\n3. Click 'Publish Changes' in Firebase Console." />
                </LinearLayout>
            </com.eve.app.designsystem.DesignCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>