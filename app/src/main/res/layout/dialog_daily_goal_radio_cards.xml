<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/design_screen_margin"
        android:paddingTop="@dimen/design_card_padding"
        android:paddingBottom="@dimen/design_screen_margin"
        android:clipToPadding="false"
        android:clipChildren="false">

        <TextView
            style="@style/TextAppearance.Eve.Token.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/design_card_gap"
            android:text="Choose your target number of practice mock tests to maintain your streak." />

        <com.eve.app.designsystem.UiArcRadioCardsGroup
            android:id="@+id/radioCardsDailyGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:clipChildren="false" />

    </LinearLayout>
</ScrollView>
