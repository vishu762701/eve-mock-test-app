<?xml version='1.0' encoding='utf-8'?>
<com.eve.app.designsystem.DesignCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.Eve.Token.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="@dimen/design_zero" android:clickable="true" android:focusable="true" app:rippleColor="@color/design_role_ripple" android:minHeight="@dimen/design_row_with_gap" android:layout_marginBottom="@dimen/design_card_gap">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📢 Feedback" />
            <View android:layout_width="0dp" android:layout_height="@dimen/design_hairline_width" android:layout_weight="1" />
            <TextView android:id="@+id/tvFeedbackPostDate" style="@style/TextAppearance.Eve.Telegram.ListTime" android:tag="eve_telegram_type" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:id="@+id/tvFeedbackPostTitle" style="@style/TextAppearance.Eve.Telegram.ListTitle" android:tag="eve_telegram_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:ellipsize="end" android:maxLines="1" />
        <TextView android:id="@+id/tvFeedbackPostMessage" style="@style/TextAppearance.Eve.Telegram.ListPreview" android:tag="eve_telegram_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_compact_gap" />
        <LinearLayout android:id="@+id/layoutReplyBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <EditText android:id="@+id/etReplyText" style="@style/Widget.Eve.Token.Input" android:layout_width="0dp" android:layout_height="@dimen/design_input_height" android:layout_weight="1" android:hint="Type your reply..." android:imeOptions="actionSend" android:inputType="textCapSentences" android:maxLength="500" android:maxLines="2" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSendReply" style="@style/Widget.Eve.Token.Button" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="@dimen/design_card_gap" android:text="Reply" />
        </LinearLayout>
    </LinearLayout>
</com.eve.app.designsystem.DesignCardView>