<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    style="@style/Widget.Eve.Card.Content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/eve_space_0"
    android:layout_marginVertical="@dimen/eve_space_6"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="@dimen/eve_home_card_elevation"
    app:cardMaxElevation="@dimen/eve_home_card_elevation"
    android:stateListAnimator="@animator/press_scale"
    app:rippleColor="@color/eve_ripple"
    android:minHeight="@dimen/eve_list_row_min">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/eve_space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_accent"
                android:paddingHorizontal="@dimen/eve_space_10"
                android:paddingVertical="@dimen/eve_space_3"
                android:text="📢 Feedback"
                android:textColor="@color/eve_on_accent_container" />

            <View
                android:layout_width="@dimen/eve_space_0"
                android:layout_height="@dimen/eve_home_hairline_border"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvFeedbackPostDate"
                style="@style/TextAppearance.Eve.Caption1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/eveLabelSecondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFeedbackPostTitle"
            style="@style/TextAppearance.Eve.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eve_space_8"
            android:textColor="@color/eve_text" />

        <TextView
            android:id="@+id/tvFeedbackPostMessage"
            style="@style/TextAppearance.Eve.Footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eve_space_4"
            android:textColor="?attr/eveLabelSecondary" />

        <!-- Inline Reply Box (Task B, Item 4) -->
        <LinearLayout
            android:id="@+id/layoutReplyBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eve_space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etReplyText"
                style="@style/TextAppearance.Eve.Footnote"
                android:layout_width="@dimen/eve_space_0"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/eve_segment_min_height"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_rounded"
                android:hint="Type your reply..."
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLength="500"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/eve_space_12"
                android:paddingVertical="@dimen/eve_space_8"
                android:textColor="@color/eve_text"
                android:textColorHint="@color/eve_placeholder_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendReply"
                style="@style/Widget.Eve.Button.Primary"
                android:textAppearance="@style/TextAppearance.Eve.Caption1.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/eve_space_8"
                android:paddingHorizontal="@dimen/eve_space_14"
                android:text="Reply"
                android:minHeight="@dimen/eve_control_min_touch"
                android:paddingVertical="@dimen/eve_space_8" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
