<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF333333"
    android:orientation="vertical">

    <!-- Source PhotoCropActivity ActionBar: dark media-picker bar, white back/done. -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/design_touch_min"
        android:background="#FF333333"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/btnCancel"
            android:layout_width="@dimen/design_touch_min"
            android:layout_height="@dimen/design_touch_min"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFFFF"
            style="@style/Widget.Eve.Token.IconButton" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/profile_crop_title"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnDone"
            android:layout_width="@dimen/design_touch_min"
            android:layout_height="@dimen/design_touch_min"
            android:contentDescription="@string/profile_crop_done"
            android:src="@drawable/ic_ab_done"
            app:tint="#FFFFFFFF"
            style="@style/Widget.Eve.Token.IconButton" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.eve.app.ui.profile.AvatarCropView
            android:id="@+id/cropView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/profile_crop_hint"
            android:importantForAccessibility="yes" />

        <com.eve.app.designsystem.TelegramRadialProgressView
            android:id="@+id/progress"
            android:layout_width="@dimen/design_ring_size"
            android:layout_height="@dimen/design_ring_size"
            android:layout_gravity="center"
            android:visibility="visible" />
    </FrameLayout>
</LinearLayout>
