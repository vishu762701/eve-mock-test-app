<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Sheet">
    <View android:layout_width="@dimen/design_tab_height" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="@dimen/design_section_gap" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose Font" style="@style/TextAppearance.Eve.Token.Heading" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="@dimen/design_section_gap" android:text="Select typography style for the app" style="@style/TextAppearance.Eve.Token.Body" />
    <LinearLayout android:id="@+id/rowEveDefault" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
        <RadioButton android:id="@+id/radioEveDefault" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="false" android:focusable="false" style="@style/Widget.Eve.Token.Radio" />
        <LinearLayout android:layout_width="@dimen/design_zero" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_screen_margin" android:layout_weight="1" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <TextView android:id="@+id/tvEveDefaultTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eve default" style="@style/TextAppearance.Eve.Token.Heading" />
            <TextView android:id="@+id/tvEveDefaultSample" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Practice makes perfect  Aa Bb 123" style="@style/TextAppearance.Eve.Token.Secondary" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/rowDeviceFont" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
        <RadioButton android:id="@+id/radioDeviceFont" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="false" android:focusable="false" style="@style/Widget.Eve.Token.Radio" />
        <LinearLayout android:layout_width="@dimen/design_zero" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_screen_margin" android:layout_weight="1" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <TextView android:id="@+id/tvDeviceFontTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Device font" style="@style/TextAppearance.Eve.Token.Heading" />
            <TextView android:id="@+id/tvDeviceFontSample" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Uses your phone's system font" style="@style/TextAppearance.Eve.Token.Secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>