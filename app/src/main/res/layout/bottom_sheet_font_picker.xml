<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_bottom"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Font"
        style="@style/TextAppearance.Eve.Heading" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Select typography style for the app"
        style="@style/TextAppearance.Eve.BodySmall" />

    <!-- Option 1: Eve Default -->
    <LinearLayout
        android:id="@+id/rowEveDefault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="14dp">

        <RadioButton
            android:id="@+id/radioEveDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEveDefaultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eve default"
                style="@style/TextAppearance.Eve.Subheading" />

            <TextView
                android:id="@+id/tvEveDefaultSample"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Practice makes perfect  Aa Bb 123"
                style="@style/TextAppearance.Eve.BodySmall" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/eve_stroke_hairline"
        android:background="@color/eve_separator" />

    <!-- Option 2: Device Font -->
    <LinearLayout
        android:id="@+id/rowDeviceFont"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="14dp">

        <RadioButton
            android:id="@+id/radioDeviceFont"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDeviceFontTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device font"
                style="@style/TextAppearance.Eve.Subheading" />

            <TextView
                android:id="@+id/tvDeviceFontSample"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Uses your phone's system font"
                style="@style/TextAppearance.Eve.BodySmall" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
