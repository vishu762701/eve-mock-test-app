<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/eve_card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle drag indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/eve_stroke" />

    <TextView
        android:id="@+id/tvCompletedTitle"
        style="@style/TextAppearance.Eve.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/eve_text" />

    <TextView
        android:id="@+id/tvCompletedScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eve_space_8"
        android:background="@drawable/bg_tile_right"
        android:fontFamily="@font/poppins_semibold"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="@color/eve_tile_right_text"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewResult"
        style="@style/Widget.Eve.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/view_my_result"
        app:icon="@drawable/ic_history"
        app:iconGravity="textStart"
        app:iconTint="@color/eve_on_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReattempt"
        style="@style/Widget.Eve.Button.Orange"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/eve_space_12"
        android:text="@string/reattempt"
        app:icon="@drawable/ic_refresh"
        app:iconGravity="textStart" />

</LinearLayout>
