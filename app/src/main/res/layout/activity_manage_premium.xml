<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Screen">
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.ToolbarRow">
            <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="@color/telegram_type_primary" style="@style/Widget.Eve.Token.IconButton" />
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/btnRefresh" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Refresh" android:src="@drawable/ic_refresh" app:tint="@color/text_primary" style="@style/Widget.Eve.Token.IconButton" />
        </LinearLayout>
    </com.eve.app.ui.common.EveGlassToolbar>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.LargeTitleBlock">
        <TextView style="@style/TextAppearance.Eve.Telegram.NavigationTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Premium Management"  android:tag="eve_telegram_type" />
    </LinearLayout>
    <com.eve.app.designsystem.DesignSegmentedTabs android:id="@+id/tabLayout" style="@style/Widget.Eve.Token.SegmentedTabs" android:layout_width="match_parent" android:layout_height="@dimen/design_tab_height" android:layout_marginHorizontal="@dimen/design_screen_margin" android:layout_marginTop="@dimen/design_card_gap" android:layout_marginBottom="@dimen/design_card_gap" app:tabMode="fixed" app:tabGravity="fill">
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transactions" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Users" />
    </com.eve.app.designsystem.DesignSegmentedTabs>
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
        <com.eve.app.designsystem.TelegramRadialProgressView android:id="@+id/progressAdmin" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:layout_gravity="center" android:visibility="gone" />
        <androidx.core.widget.NestedScrollView android:id="@+id/containerSettings" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="visible" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                <com.eve.app.designsystem.DesignCardView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Eve.Token.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                        <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Premium Plan" />
                        <com.eve.app.designsystem.DesignSwitch android:id="@+id/switchEnablePremium" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:text="Enable Premium Purchases" style="@style/Widget.Eve.Token.Switch" />
                        <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:hint="Plan Name">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPlanName" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="text" style="@style/Widget.Eve.Token.Input" />
                        </com.eve.app.designsystem.DesignInputLayout>
                        <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:hint="Price (INR)">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPriceInr" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="number" style="@style/Widget.Eve.Token.Input" />
                        </com.eve.app.designsystem.DesignInputLayout>
                        <com.eve.app.designsystem.DesignSwitch android:id="@+id/switchLifetime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:text="Lifetime Plan (No Expiry)" style="@style/Widget.Eve.Token.Switch" />
                        <com.eve.app.designsystem.DesignInputLayout android:id="@+id/tilDurationDays" style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:hint="Duration in Days (e.g. 7, 30, 90, 365)">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDurationDays" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="number" style="@style/Widget.Eve.Token.Input" />
                        </com.eve.app.designsystem.DesignInputLayout>
                        <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:hint="Student Description">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:minLines="2" style="@style/Widget.Eve.Token.Input" />
                        </com.eve.app.designsystem.DesignInputLayout>
                        <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:hint="Benefits (one per line)">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBenefits" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:minLines="4" style="@style/Widget.Eve.Token.Input" />
                        </com.eve.app.designsystem.DesignInputLayout>
                    </LinearLayout>
                </com.eve.app.designsystem.DesignCardView>
                <com.eve.app.designsystem.DesignCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" style="@style/Widget.Eve.Token.Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                        <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Payment Methods &amp; Expiry" />
                        <com.eve.app.designsystem.DesignSwitch android:id="@+id/switchQrEnabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:text="Enable QR Code Payment" style="@style/Widget.Eve.Token.Switch" />
                        <com.eve.app.designsystem.DesignSwitch android:id="@+id/switchUpiEnabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" android:text="Enable UPI Intent Payment" style="@style/Widget.Eve.Token.Switch" />
                        <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:hint="Payment Session Expiry (Minutes)">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSessionExpiry" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="number" style="@style/Widget.Eve.Token.Input" />
                        </com.eve.app.designsystem.DesignInputLayout>
                        <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:hint="Merchant UPI VPA (e.g. evemocktest@upi)">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMerchantVpa" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="text" style="@style/Widget.Eve.Token.Input" />
                        </com.eve.app.designsystem.DesignInputLayout>
                    </LinearLayout>
                </com.eve.app.designsystem.DesignCardView>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveSettings" style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="@dimen/design_shadow_room" android:text="Save Settings" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <FrameLayout android:id="@+id/containerTransactions" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvTransactions" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll" />
            <TextView android:id="@+id/tvEmptyTransactions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="No transactions found" android:visibility="gone" style="@style/TextAppearance.Eve.Token.Body" />
        </FrameLayout>
        <LinearLayout android:id="@+id/containerUsers" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnGrantManual" style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:text="+ Grant Premium Manually" app:icon="@drawable/ic_star_filled" />
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPremiumUsers" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll" />
                <TextView android:id="@+id/tvEmptyUsers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="No premium users found" android:visibility="gone" style="@style/TextAppearance.Eve.Token.Body" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>