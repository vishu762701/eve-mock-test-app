<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/Widget.Eve.Token.Screen">

    <!-- Telegram-style Top Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/design_touch_min"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        style="@style/Widget.Eve.Token.ToolbarRow">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/design_touch_min"
            android:layout_height="@dimen/design_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/telegram_type_primary" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            style="@style/TextAppearance.Eve.Telegram.NavigationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Edit Name" />

        <ImageButton
            android:id="@+id/btnDone"
            android:layout_width="@dimen/design_touch_min"
            android:layout_height="@dimen/design_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Done"
            android:src="@drawable/ic_ab_done"
            app:tint="@color/telegram_type_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp">

        <EditText
            android:id="@+id/etName"
            style="@style/TextAppearance.Eve.Telegram.EditInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@null"
            android:hint="Display Name"
            android:textColorHint="@color/telegram_type_secondary"
            android:inputType="textPersonName|textCapWords|textMultiLine"
            android:maxLength="100"
            android:minLines="2"
            android:maxLines="5"
            android:gravity="top|start" />

        <View
            android:id="@+id/lineName"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent" />

        <TextView
            android:id="@+id/tvHelp"
            style="@style/TextAppearance.Eve.Telegram.EditHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Your display name can include multiple words (up to 100 characters). Your @username is separate." />
    </LinearLayout>
</LinearLayout>
