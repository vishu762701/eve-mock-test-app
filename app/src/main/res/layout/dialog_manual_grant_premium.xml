<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Modal">
    <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="User UID or Email">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etGrantUser" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="textEmailAddress" style="@style/Widget.Eve.Token.Input" />
    </com.eve.app.designsystem.DesignInputLayout>
    <com.eve.app.designsystem.TelegramSwitch android:id="@+id/switchGrantLifetime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:text="Grant Lifetime Access" />
    <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:hint="Duration in Days">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etGrantDays" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="number" android:text="30" style="@style/Widget.Eve.Token.Input" />
    </com.eve.app.designsystem.DesignInputLayout>
</LinearLayout>