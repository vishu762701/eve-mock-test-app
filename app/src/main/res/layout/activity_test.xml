<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Screen">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
        <FrameLayout android:id="@+id/timerCapsuleHost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <com.eve.app.ui.common.CircularTimerView android:id="@+id/circularTimerView" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:layout_gravity="center" />
        </FrameLayout>
        <TextView android:id="@+id/tvTimer" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="--:--" />
        <TextView android:id="@+id/tvTestTitle" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="@dimen/design_screen_margin" android:ellipsize="end" android:maxLines="1" android:singleLine="true" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvQuestionPalette" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false" android:orientation="horizontal" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" style="@style/Widget.Eve.Token.Scroll.Inner" />
    <TextView android:id="@+id/tvOfflineBanner" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/offline_banner_text" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:clipChildren="false" android:clipToPadding="false" android:layout_weight="1" style="@style/Widget.Eve.Token.Column">
        <androidx.viewpager2.widget.ViewPager2 android:id="@+id/viewPager" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false" />
        <com.eve.app.designsystem.DesignLoadingView android:id="@+id/loadingTest" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
        <LinearLayout android:id="@+id/progressGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:visibility="gone" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <com.google.android.material.progressindicator.CircularProgressIndicator android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" style="@style/Widget.Eve.Token.Ring" android:indeterminate="true" />
            <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:text="Loading questions…" />
        </LinearLayout>
        <LinearLayout android:id="@+id/messageGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:visibility="gone" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <com.airbnb.lottie.LottieAnimationView android:id="@+id/ivMessageIcon" android:layout_width="160dp" android:layout_height="160dp" app:lottie_autoPlay="false" app:lottie_loop="false" app:lottie_rawRes="@raw/error_404" style="@style/Widget.Eve.Token.Lottie" />
            <TextView android:id="@+id/tvMessage" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_section_gap" />
            <TextView android:id="@+id/tvMessageSub" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="260dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRetry" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="@dimen/design_section_gap" android:text="Retry" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/layoutBottomBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <FrameLayout android:layout_width="0dp" android:layout_height="@dimen/design_touch_min" android:layout_marginEnd="@dimen/design_row_gap" android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnClear" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="match_parent" android:layout_height="match_parent" android:text="Clear response" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="@dimen/design_row_gap" android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnMarkReview" style="@style/Widget.Eve.Token.Button.Review" android:layout_width="match_parent" android:layout_height="match_parent" android:text="Mark for review" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_shadow_room" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <FrameLayout android:layout_width="0dp" android:layout_height="@dimen/design_touch_min" android:layout_marginEnd="@dimen/design_row_gap" android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPrev" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="match_parent" android:layout_height="match_parent" android:text="Previous" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="@dimen/design_row_gap" android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnNext" style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="match_parent" android:text="Save and Next" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>