<?xml version='1.0' encoding='utf-8'?>
<com.eve.app.designsystem.DesignCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_card_gap" android:minHeight="@dimen/design_row_with_gap" style="@style/Widget.Eve.Token.Card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
        <TextView android:id="@+id/tvQuestion" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvExam" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <TextView android:id="@+id/tvStats" style="@style/TextAppearance.Eve.Token.Secondary.red" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEditQuestion" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:text="Edit this question" app:icon="@drawable/ic_edit" />
        </LinearLayout>
    </LinearLayout>
</com.eve.app.designsystem.DesignCardView>