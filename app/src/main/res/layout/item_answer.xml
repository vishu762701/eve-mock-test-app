<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/eve_surface"
    app:cardCornerRadius="@dimen/eve_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/eve_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Question Number + Status + Header Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivStatusCircle"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Question status"
                android:src="@drawable/ic_status_circle_right" />

            <TextView
                android:id="@+id/tvQuestionNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Question 1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvQuestionStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_stat_mini"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Correct"
                android:textColor="@color/eve_status_success"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ivBookmark"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Bookmarked"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star_bookmark_filled"
                android:visibility="gone" />

            <!-- Question Report Action Button (48dp touch target) -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/ivReportQuestion"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_report_button"
                    android:stateListAnimator="@animator/press_scale"
                    android:contentDescription="Report this question"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_report_flag_premium"
                    app:tint="@color/eve_report_red" />
            </FrameLayout>
        </LinearLayout>

        <!-- 2. Question Text: Receives Primary Focus -->
        <TextView
            android:id="@+id/tvQ"
            style="@style/TextAppearance.Eve.QuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/eve_text"
            android:textSize="18sp" />

        <!-- Review Options Container (Shows complete question with options) -->
        <LinearLayout
            android:id="@+id/layoutOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- Option A -->
            <LinearLayout
                android:id="@+id/layoutOptionA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_option_review_default"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvBadgeOptionA"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_option_badge_default"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/eve_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOptionA"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivOptionAStatus"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Status"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Option B -->
            <LinearLayout
                android:id="@+id/layoutOptionB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_option_review_default"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvBadgeOptionB"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_option_badge_default"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="@color/eve_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOptionB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivOptionBStatus"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Status"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Option C -->
            <LinearLayout
                android:id="@+id/layoutOptionC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_option_review_default"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvBadgeOptionC"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_option_badge_default"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="@color/eve_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOptionC"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivOptionCStatus"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Status"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Option D -->
            <LinearLayout
                android:id="@+id/layoutOptionD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_option_review_default"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvBadgeOptionD"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_option_badge_default"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="@color/eve_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOptionD"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivOptionDStatus"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Status"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- View Solution Button (Initial Review State: Question First, Solution on Demand) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewSolution"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="View Solution"
            android:textColor="?attr/colorOnSurface"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_visibility"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="?attr/colorOnSurface"
            app:strokeColor="@color/eve_stroke"
            app:strokeWidth="1dp" />

        <!-- Solution Container (Expanded Inline on Demand) -->
        <LinearLayout
            android:id="@+id/layoutSolutionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="@color/eve_stroke" />

        <!-- 3. User's Answer -->
        <TextView
            android:id="@+id/tvYourAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textSize="14sp" />

        <!-- 4. Correct Answer -->
        <TextView
            android:id="@+id/tvCorrectAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/eve_status_success"
            android:textSize="14sp" />

        <!-- Accuracy Stat Badge (% got this right) -->
        <LinearLayout
            android:id="@+id/layoutAccuracyStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAccuracyStat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="--% got this right"
                android:textColor="@color/eve_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 5. Time Information (When Available) -->
        <LinearLayout
            android:id="@+id/layoutTimeInsight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_stat_mini"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/TextAppearance.Eve.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIME ANALYSIS"
                android:textColor="@color/eve_premium_text" />

            <!-- You Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="You"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/pbTimeYou"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvTimeYou"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Avg Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="Avg"
                    android:textColor="@color/eve_text_secondary"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/pbTimeAvg"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvTimeAvg"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/eve_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Message -->
            <TextView
                android:id="@+id/tvTimeInsightMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 6. Explanation / Solution Section -->
        <LinearLayout
            android:id="@+id/layoutSolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="@color/eve_stroke" />

            <!-- One-line correct summary -->
            <TextView
                android:id="@+id/tvCorrectSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <!-- Key Points Header -->
            <LinearLayout
                android:id="@+id/layoutKeyPointsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Key Points"
                    android:src="@drawable/ic_key"
                    app:tint="@color/eve_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:letterSpacing="0.04"
                    android:text="KEY POINTS"
                    android:textColor="@color/eve_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Explanation with formatted bulleted concepts -->
            <TextView
                android:id="@+id/tvExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleExplanation"
            style="@style/Widget.Eve.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- 7. Footer Report Action Link -->
        <LinearLayout
            android:id="@+id/layoutReportAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Report"
                android:src="@drawable/ic_warning"
                app:tint="@color/eve_status_warning" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Report an issue with this question"
                android:textColor="@color/eve_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
