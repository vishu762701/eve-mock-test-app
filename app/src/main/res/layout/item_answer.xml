<?xml version='1.0' encoding='utf-8'?>
<com.eve.app.designsystem.DesignCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.Eve.Token.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/design_zero" android:layout_marginTop="@dimen/design_card_gap" android:layout_marginBottom="@dimen/design_card_gap">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <LinearLayout android:layout_width="@dimen/design_zero" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                    <ImageView android:id="@+id/ivStatusCircle" android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Question status" android:src="@drawable/ic_status_circle_right" />
                    <TextView android:id="@+id/tvQuestionNum" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="@dimen/design_zero" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/design_card_gap" android:text="Question 1" />
                </LinearLayout>
                <TextView android:id="@+id/tvQuestionStatusLabel" style="@style/TextAppearance.Eve.Token.Secondary.green" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Correct" />
            </LinearLayout>
            <ImageView android:id="@+id/ivBookmark" android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Bookmarked" android:scaleType="fitCenter" android:src="@drawable/ic_star_bookmark_filled" android:visibility="gone" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/ivReportQuestion" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:stateListAnimator="@animator/design_press_scale" android:contentDescription="Report this question" android:scaleType="fitCenter" android:src="@drawable/ic_report_flag_premium" app:tint="@color/text_secondary" style="@style/Widget.Eve.Token.IconButton" />
        </LinearLayout>
        <TextView android:id="@+id/tvQ" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" />
        <LinearLayout android:id="@+id/layoutOptionsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <LinearLayout android:id="@+id/layoutOptionA" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_row_gap" android:gravity="center_vertical" android:orientation="horizontal" style="@style/Widget.Eve.Token.Tile" android:clipChildren="false" android:clipToPadding="false">
                <TextView android:id="@+id/tvBadgeOptionA" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="28dp" android:layout_height="28dp" android:text="A" />
                <TextView android:id="@+id/tvOptionA" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="@dimen/design_zero" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_card_padding" android:layout_weight="1" />
                <ImageView android:id="@+id/ivOptionAStatus" android:layout_width="@dimen/design_shadow_room" android:layout_height="@dimen/design_shadow_room" android:layout_marginStart="@dimen/design_card_gap" android:contentDescription="Status" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/layoutOptionB" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_row_gap" android:gravity="center_vertical" android:orientation="horizontal" style="@style/Widget.Eve.Token.Tile" android:clipChildren="false" android:clipToPadding="false">
                <TextView android:id="@+id/tvBadgeOptionB" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="28dp" android:layout_height="28dp" android:text="B" />
                <TextView android:id="@+id/tvOptionB" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="@dimen/design_zero" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_card_padding" android:layout_weight="1" />
                <ImageView android:id="@+id/ivOptionBStatus" android:layout_width="@dimen/design_shadow_room" android:layout_height="@dimen/design_shadow_room" android:layout_marginStart="@dimen/design_card_gap" android:contentDescription="Status" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/layoutOptionC" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_row_gap" android:gravity="center_vertical" android:orientation="horizontal" style="@style/Widget.Eve.Token.Tile" android:clipChildren="false" android:clipToPadding="false">
                <TextView android:id="@+id/tvBadgeOptionC" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="28dp" android:layout_height="28dp" android:text="C" />
                <TextView android:id="@+id/tvOptionC" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="@dimen/design_zero" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_card_padding" android:layout_weight="1" />
                <ImageView android:id="@+id/ivOptionCStatus" android:layout_width="@dimen/design_shadow_room" android:layout_height="@dimen/design_shadow_room" android:layout_marginStart="@dimen/design_card_gap" android:contentDescription="Status" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/layoutOptionD" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_row_gap" android:gravity="center_vertical" android:orientation="horizontal" style="@style/Widget.Eve.Token.Tile" android:clipChildren="false" android:clipToPadding="false">
                <TextView android:id="@+id/tvBadgeOptionD" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="28dp" android:layout_height="28dp" android:text="D" />
                <TextView android:id="@+id/tvOptionD" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="@dimen/design_zero" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_card_padding" android:layout_weight="1" />
                <ImageView android:id="@+id/ivOptionDStatus" android:layout_width="@dimen/design_shadow_room" android:layout_height="@dimen/design_shadow_room" android:layout_marginStart="@dimen/design_card_gap" android:contentDescription="Status" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnViewSolution" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="@dimen/design_screen_margin" android:text="View Solution" app:icon="@drawable/ic_visibility" app:iconGravity="textStart" app:iconPadding="@dimen/design_card_gap" />
        <LinearLayout android:id="@+id/layoutSolutionDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <TextView android:id="@+id/tvYourAnswer" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvCorrectAnswer" style="@style/TextAppearance.Eve.Token.Body.green" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" />
            <LinearLayout android:id="@+id/layoutAccuracyStat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" />
                <TextView android:id="@+id/tvAccuracyStat" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_row_gap" android:text="--% got this right" />
            </LinearLayout>
            <LinearLayout android:id="@+id/layoutTimeInsight" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:orientation="vertical" style="@style/Widget.Eve.Token.Tile" android:clipChildren="false" android:clipToPadding="false">
                <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TIME ANALYSIS" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                    <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="@dimen/design_pill_height" android:layout_height="wrap_content" android:text="You" />
                    <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/pbTimeYou" style="@style/Widget.Eve.Token.Ring" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:layout_marginHorizontal="@dimen/design_screen_margin" android:max="100" android:indeterminate="false" />
                    <TextView android:id="@+id/tvTimeYou" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="end" android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                    <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="@dimen/design_pill_height" android:layout_height="wrap_content" android:text="Avg" />
                    <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/pbTimeAvg" style="@style/Widget.Eve.Token.Ring" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:layout_marginHorizontal="@dimen/design_screen_margin" android:max="100" android:indeterminate="false" />
                    <TextView android:id="@+id/tvTimeAvg" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="end" android:layout_weight="1" />
                </LinearLayout>
                <TextView android:id="@+id/tvTimeInsightMessage" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" />
            </LinearLayout>
            <LinearLayout android:id="@+id/layoutSolution" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_pill_padding" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <TextView android:id="@+id/tvCorrectSummary" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/layoutKeyPointsHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                    <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Key Points" android:src="@drawable/ic_key" app:tint="@color/system_blue" />
                    <TextView style="@style/TextAppearance.Eve.Token.Secondary.blue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_row_gap" android:text="KEY POINTS" />
                </LinearLayout>
                <TextView android:id="@+id/tvExplanation" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnToggleExplanation" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:visibility="gone" />
            <LinearLayout android:id="@+id/layoutReportAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_pill_padding" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="@dimen/design_touch_min" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Report" android:src="@drawable/ic_warning" app:tint="@color/system_orange" />
                <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_row_gap" android:text="Report an issue with this question" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.eve.app.designsystem.DesignCardView>