<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Eve.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/tvQ" style="@style/Eve.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp" />
            <ImageView android:id="@+id/ivBookmark" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="6dp" android:src="@drawable/ic_star_filled" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/tvYourAnswer" style="@style/Eve.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
        <TextView android:id="@+id/tvCorrectAnswer" style="@style/Eve.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnToggleExplanation" style="@style/Widget.Eve.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginStart="-8dp" android:text="Explanation dekho" android:textSize="13sp" android:visibility="gone" />
        <TextView android:id="@+id/tvExplanation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:background="@color/eve_surface_alt" android:padding="12dp" android:textColor="@color/eve_text" android:textSize="14sp" android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
