<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="480dp"
    android:clipToPadding="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/TextAppearance.Eve.Subheadline.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Issue Category"
            android:textColor="?attr/eveLabelPrimary" />

        <TextView
            style="@style/TextAppearance.Eve.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="CONTENT ISSUES"
            android:textColor="@color/eve_text_secondary" />

        <RadioGroup
            android:id="@+id/rgReportReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbReasonWrongQuestion"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Wrong Question"
                android:minHeight="48dp"
                android:textColor="?attr/eveLabelPrimary"
                android:buttonTint="@color/selector_eve_checked_control" />

            <RadioButton
                android:id="@+id/rbReasonNoSolution"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Solution"
                android:minHeight="48dp"
                android:textColor="?attr/eveLabelPrimary"
                android:buttonTint="@color/selector_eve_checked_control" />

            <RadioButton
                android:id="@+id/rbReasonWrongTranslation"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wrong Translation"
                android:minHeight="48dp"
                android:textColor="?attr/eveLabelPrimary"
                android:buttonTint="@color/selector_eve_checked_control" />

            <RadioButton
                android:id="@+id/rbReasonOutOfSyllabus"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Out of Syllabus"
                android:minHeight="48dp"
                android:textColor="?attr/eveLabelPrimary"
                android:buttonTint="@color/selector_eve_checked_control" />

            <TextView
                style="@style/TextAppearance.Eve.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="TECHNICAL ISSUES"
                android:textColor="@color/eve_text_secondary" />

            <RadioButton
                android:id="@+id/rbReasonNotVisible"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question and Options not visible"
                android:minHeight="48dp"
                android:textColor="?attr/eveLabelPrimary"
                android:buttonTint="@color/selector_eve_checked_control" />

            <RadioButton
                android:id="@+id/rbReasonBlinking"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blinking Screen Issue"
                android:minHeight="48dp"
                android:textColor="?attr/eveLabelPrimary"
                android:buttonTint="@color/selector_eve_checked_control" />

            <RadioButton
                android:id="@+id/rbReasonFormatting"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Formatting Issues"
                android:minHeight="48dp"
                android:textColor="?attr/eveLabelPrimary"
                android:buttonTint="@color/selector_eve_checked_control" />

            <RadioButton
                android:id="@+id/rbReasonScroll"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scroll Not Working"
                android:minHeight="48dp"
                android:textColor="?attr/eveLabelPrimary"
                android:buttonTint="@color/selector_eve_checked_control" />

            <RadioButton
                android:id="@+id/rbReasonDarkMode"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dark Mode Issue"
                android:minHeight="48dp"
                android:textColor="?attr/eveLabelPrimary"
                android:buttonTint="@color/selector_eve_checked_control" />

            <RadioButton
                android:id="@+id/rbReasonQuestionMissingOptionsVisible"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question not visible but Options visible"
                android:minHeight="48dp"
                android:textColor="?attr/eveLabelPrimary"
                android:buttonTint="@color/selector_eve_checked_control" />

            <RadioButton
                android:id="@+id/rbReasonOther"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Other"
                android:minHeight="48dp"
                android:textColor="?attr/eveLabelPrimary"
                android:buttonTint="@color/selector_eve_checked_control" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilComment"
            style="@style/Widget.Eve.TextInput.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Details (Optional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReportComment"
                style="@style/TextAppearance.Eve.Callout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textColorHint="@color/eve_placeholder_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Inline error message (if server error occurs) -->
        <TextView
            android:id="@+id/tvCommentError"
            style="@style/TextAppearance.Eve.Caption1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/eve_status_error_text"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
