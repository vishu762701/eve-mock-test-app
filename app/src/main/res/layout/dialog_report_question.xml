<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxHeight="480dp" android:clipToPadding="false" android:overScrollMode="ifContentScrolls" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
        <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select Issue Category" />
        <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:text="CONTENT ISSUES" />
        <RadioGroup android:id="@+id/rgReportReason" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbReasonWrongQuestion" style="@style/Widget.Eve.Token.Radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Wrong Question" android:minHeight="@dimen/design_touch_min" android:textColor="?attr/eveLabelPrimary" android:buttonTint="@color/selector_eve_checked_control" />
            <RadioButton android:id="@+id/rbReasonNoSolution" style="@style/Widget.Eve.Token.Radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No Solution" android:minHeight="@dimen/design_touch_min" android:textColor="?attr/eveLabelPrimary" android:buttonTint="@color/selector_eve_checked_control" />
            <RadioButton android:id="@+id/rbReasonWrongTranslation" style="@style/Widget.Eve.Token.Radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wrong Translation" android:minHeight="@dimen/design_touch_min" android:textColor="?attr/eveLabelPrimary" android:buttonTint="@color/selector_eve_checked_control" />
            <RadioButton android:id="@+id/rbReasonOutOfSyllabus" style="@style/Widget.Eve.Token.Radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Out of Syllabus" android:minHeight="@dimen/design_touch_min" android:textColor="?attr/eveLabelPrimary" android:buttonTint="@color/selector_eve_checked_control" />
            <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:text="TECHNICAL ISSUES" />
            <RadioButton android:id="@+id/rbReasonNotVisible" style="@style/Widget.Eve.Token.Radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Question and Options not visible" android:minHeight="@dimen/design_touch_min" android:textColor="?attr/eveLabelPrimary" android:buttonTint="@color/selector_eve_checked_control" />
            <RadioButton android:id="@+id/rbReasonBlinking" style="@style/Widget.Eve.Token.Radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Blinking Screen Issue" android:minHeight="@dimen/design_touch_min" android:textColor="?attr/eveLabelPrimary" android:buttonTint="@color/selector_eve_checked_control" />
            <RadioButton android:id="@+id/rbReasonFormatting" style="@style/Widget.Eve.Token.Radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Formatting Issues" android:minHeight="@dimen/design_touch_min" android:textColor="?attr/eveLabelPrimary" android:buttonTint="@color/selector_eve_checked_control" />
            <RadioButton android:id="@+id/rbReasonScroll" style="@style/Widget.Eve.Token.Radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scroll Not Working" android:minHeight="@dimen/design_touch_min" android:textColor="?attr/eveLabelPrimary" android:buttonTint="@color/selector_eve_checked_control" />
            <RadioButton android:id="@+id/rbReasonDarkMode" style="@style/Widget.Eve.Token.Radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dark Mode Issue" android:minHeight="@dimen/design_touch_min" android:textColor="?attr/eveLabelPrimary" android:buttonTint="@color/selector_eve_checked_control" />
            <RadioButton android:id="@+id/rbReasonQuestionMissingOptionsVisible" style="@style/Widget.Eve.Token.Radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Question not visible but Options visible" android:minHeight="@dimen/design_touch_min" android:textColor="?attr/eveLabelPrimary" android:buttonTint="@color/selector_eve_checked_control" />
            <RadioButton android:id="@+id/rbReasonOther" style="@style/Widget.Eve.Token.Radio" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Other" android:minHeight="@dimen/design_touch_min" android:textColor="?attr/eveLabelPrimary" android:buttonTint="@color/selector_eve_checked_control" />
        </RadioGroup>
        <com.eve.app.designsystem.DesignInputLayout android:id="@+id/tilComment" style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:hint="Details (Optional)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etReportComment" style="@style/Widget.Eve.Token.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top|start" android:inputType="textMultiLine" android:minLines="3" />
        </com.eve.app.designsystem.DesignInputLayout>
        <TextView android:id="@+id/tvCommentError" style="@style/TextAppearance.Eve.Token.Secondary.red" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>