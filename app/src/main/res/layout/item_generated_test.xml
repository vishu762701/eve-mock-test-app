<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginVertical="@dimen/eve_space_8" android:stateListAnimator="@animator/press_scale" app:cardBackgroundColor="@color/eve_card_bg" app:cardCornerRadius="@dimen/eve_radius_card" app:cardElevation="0dp" app:strokeWidth="1dp" android:minHeight="@dimen/eve_list_row_min">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

            <TextView android:id="@+id/tvExamName" style="@style/TextAppearance.Eve.Headline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SSC CGL - Generated Test #1"/>

            <TextView android:id="@+id/tvStatusBadge" style="@style/TextAppearance.Eve.Footnote.Medium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_circle_translucent" android:paddingHorizontal="10dp" android:paddingVertical="3dp" android:text="PAUSED" android:textColor="@color/eve_text_secondary"/>
        </LinearLayout>

        <TextView android:id="@+id/tvTestDetails" style="@style/TextAppearance.Eve.Footnote" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="25 questions • Generated 2h ago"/>

        <TextView android:id="@+id/tvScheduledTime" style="@style/TextAppearance.Eve.Caption1.Medium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/eve_accent_text" android:visibility="gone"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">

            <TextView style="@style/TextAppearance.Eve.Subheadline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Live for students:"/>

            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchLive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical|end" android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnSchedule" style="@style/Widget.Eve.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:insetTop="0dp" android:insetBottom="0dp" android:text="Schedule"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnPreview" style="@style/Widget.Eve.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Review"/>

            <ImageButton android:id="@+id/btnDelete" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="8dp" android:contentDescription="Delete test" android:src="@drawable/ic_close" app:tint="@color/selector_eve_destructive_text" style="@style/Widget.Eve.Token.IconButton"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>