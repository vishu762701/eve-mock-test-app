<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/eve_system_grouped_background" android:clipToPadding="false" android:clipChildren="false">

    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:minHeight="56dp" android:background="@android:color/transparent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/design_screen_margin" android:paddingVertical="8dp" android:clipToPadding="false" android:clipChildren="false">

        <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="?attr/eveLabelPrimary" style="@style/Widget.Eve.Token.IconButton"/>

        <View android:layout_width="@dimen/design_zero" android:layout_height="@dimen/design_zero" android:layout_weight="1"/></LinearLayout>
</com.eve.app.ui.common.EveGlassToolbar>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/design_screen_margin" android:paddingBottom="@dimen/design_section_gap"><TextView android:id="@+id/tvExamName" style="@style/TextAppearance.Eve.Token.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:text="Leaderboard"/>
    </LinearLayout><com.google.android.material.card.MaterialCardView style="@style/Widget.Eve.Card.Group" android:id="@+id/cardYourRank" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="14dp" android:clipToPadding="false" android:clipChildren="false">

            <!-- Left: Rank inside a rounded-square surface-2 tile -->
            <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_tile_surface2">

                <TextView android:id="@+id/tvRankMedallion" style="@style/TextAppearance.Eve.Subheadline.Medium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:textColor="?attr/eveLabelPrimary"/>
            </FrameLayout>

            <!-- Middle: small label "YOUR RANK", large rank value, percentile -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false">

                <TextView style="@style/TextAppearance.Eve.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOUR RANK" android:textColor="?attr/eveLabelSecondary"/>

                <TextView android:id="@+id/tvYourRank" style="@style/TextAppearance.Eve.Title3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textStyle="bold" android:textColor="?attr/eveLabelPrimary"/>

                <TextView android:id="@+id/tvYourPercentile" style="@style/TextAppearance.Eve.Caption1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="?attr/eveLabelSecondary"/>
            </LinearLayout>

            <!-- Right: Score large and bold with /total in muted colour -->
            <TextView android:id="@+id/tvYourScore" style="@style/TextAppearance.Eve.Title3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:gravity="end" android:textStyle="bold" android:textColor="?attr/eveLabelPrimary"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="4dp" android:paddingBottom="6dp" android:clipToPadding="false" android:clipChildren="false">

        <TextView style="@style/TextAppearance.Eve.Headline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Top Scorers" android:textColor="?attr/eveLabelPrimary"/>

        <TextView style="@style/TextAppearance.Eve.Caption1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Highest scores across all participants" android:textColor="?attr/eveLabelSecondary"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false" android:background="@color/eve_system_grouped_background">

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvLeaderboard" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false" android:layoutAnimation="@anim/layout_enter" android:paddingHorizontal="16dp" android:paddingTop="12dp" android:paddingBottom="24dp" android:background="@color/eve_system_grouped_background"/>

        <LinearLayout android:id="@+id/progressGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:visibility="gone" android:clipToPadding="false" android:clipChildren="false">

            <ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <TextView style="@style/TextAppearance.Eve.Footnote" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Loading leaderboard…" android:textColor="?attr/eveLabelSecondary"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/messageGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:padding="24dp" android:visibility="gone" android:clipToPadding="false" android:clipChildren="false">

            <com.airbnb.lottie.LottieAnimationView android:id="@+id/ivMessageIcon" android:layout_width="160dp" android:layout_height="160dp" android:background="@android:color/transparent" app:lottie_autoPlay="false" app:lottie_loop="false" app:lottie_rawRes="@raw/error_404"/>

            <TextView android:id="@+id/tvMessage" style="@style/TextAppearance.Eve.Headline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:textColor="@color/eve_text"/>

            <TextView android:id="@+id/tvMessageSub" style="@style/TextAppearance.Eve.Footnote" android:layout_width="260dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="?attr/eveLabelSecondary"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnRetry" style="@style/Widget.Eve.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Retry" android:visibility="gone"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>