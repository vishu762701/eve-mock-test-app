<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eve_system_grouped_background"
    android:orientation="vertical">

    <!-- Top App Bar / Header -->
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle_translucent"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="?attr/eveLabelPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailTitle"
                style="@style/TextAppearance.Eve.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Details"
                android:textColor="?attr/eveLabelPrimary" />

            <TextView
                android:id="@+id/tvDetailSubtitle"
                style="@style/TextAppearance.Eve.Footnote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/eveLabelPrimary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.eve.app.ui.common.EveGlassToolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/eve_stroke" />

    <!-- Scrollable detail container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        android:overScrollMode="ifContentScrolls"
        android:background="@color/eve_system_grouped_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ========================================================== -->
            <!-- 1. STATISTICS CONTAINER                                    -->
            <!-- ========================================================== -->
            <LinearLayout
                android:id="@+id/layoutContainerStatistics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Score Overview Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Eve.Card.Group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="20dp">

                        <TextView
                            style="@style/TextAppearance.Eve.Result.HeroLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.06"
                            android:text="TOTAL SCORE ACHIEVED" />

                        <TextView
                            android:id="@+id/tvStatHeroScore"
                            style="@style/TextAppearance.Eve.Result.HeroScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvStatHeroPercentage"
                            style="@style/TextAppearance.Eve.Result.ScoreBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_stat_mini"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="--% Score" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Marks Breakdown Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Eve.Card.Group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.Eve.Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="Marking Scheme Breakdown"
                            android:textColor="?attr/eveLabelPrimary" />

                        <!-- Correct Gain -->
                        <com.eve.app.ui.result.ResponsiveResultRow
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <TextView
                                android:id="@+id/tvStatCorrectLabel"
                                style="@style/TextAppearance.Eve.Footnote"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Correct Answers (+1.00 each)"
                                android:textColor="?attr/eveLabelPrimary" />

                            <TextView
                                android:id="@+id/tvStatCorrectMarks"
                                style="@style/TextAppearance.Eve.Subheadline.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+0.00"
                                android:textColor="@color/eve_status_success_text" />
                        </com.eve.app.ui.result.ResponsiveResultRow>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/eve_stroke" />

                        <!-- Wrong Deduction -->
                        <com.eve.app.ui.result.ResponsiveResultRow
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <TextView
                                android:id="@+id/tvStatWrongLabel"
                                style="@style/TextAppearance.Eve.Footnote"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Negative Marking Deduction"
                                android:textColor="?attr/eveLabelPrimary" />

                            <TextView
                                android:id="@+id/tvStatWrongMarks"
                                style="@style/TextAppearance.Eve.Subheadline.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-0.00"
                                android:textColor="@color/eve_status_error_text" />
                        </com.eve.app.ui.result.ResponsiveResultRow>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/eve_stroke" />

                        <!-- Unattempted -->
                        <com.eve.app.ui.result.ResponsiveResultRow
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <TextView
                                android:id="@+id/tvStatUnattemptedLabel"
                                style="@style/TextAppearance.Eve.Footnote"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Unattempted Questions"
                                android:textColor="?attr/eveLabelPrimary" />

                            <TextView
                                android:id="@+id/tvStatUnattemptedCount"
                                style="@style/TextAppearance.Eve.Subheadline.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="?attr/eveLabelSecondary" />
                        </com.eve.app.ui.result.ResponsiveResultRow>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/eve_stroke" />

                        <!-- Net Score -->
                        <com.eve.app.ui.result.ResponsiveResultRow
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="4dp">

                            <TextView
                                style="@style/TextAppearance.Eve.Subheadline.Medium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Final Net Score"
                                android:textColor="?attr/eveLabelPrimary" />

                            <TextView
                                android:id="@+id/tvStatFinalNetScore"
                                style="@style/TextAppearance.Eve.Headline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.00"
                                android:textColor="?attr/eveLabelPrimary" />
                        </com.eve.app.ui.result.ResponsiveResultRow>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4 Tiles Detailed Grid -->
                <TextView
                    style="@style/TextAppearance.Eve.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Question Summary"
                    android:textColor="?attr/eveLabelPrimary" />

                <com.eve.app.ui.result.ResultStatisticsGrid
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Right -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="96dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tile_right"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvStatRightCount"
                            style="@style/TextAppearance.Eve.Result.MetricCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/eve_tile_right_text" />

                        <TextView
                            style="@style/TextAppearance.Eve.Result.MetricLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Right"
                            android:textColor="@color/eve_tile_right_text" />
                    </LinearLayout>

                    <!-- Wrong -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="96dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tile_wrong"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvStatWrongCount"
                            style="@style/TextAppearance.Eve.Result.MetricCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/eve_tile_wrong_text" />

                        <TextView
                            style="@style/TextAppearance.Eve.Result.MetricLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Wrong"
                            android:textColor="@color/eve_tile_wrong_text" />
                    </LinearLayout>

                    <!-- Unattempted -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="96dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tile_unattempted"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvStatUnattemptedTileCount"
                            style="@style/TextAppearance.Eve.Result.MetricCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="?attr/eveLabelPrimary" />

                        <TextView
                            style="@style/TextAppearance.Eve.Result.MetricLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Unattempted"
                            android:textColor="?attr/eveLabelSecondary" />
                    </LinearLayout>

                    <!-- Accuracy -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="96dp"
                        android:background="@drawable/bg_tile_medium"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvStatAccuracyPct"
                            style="@style/TextAppearance.Eve.Result.MetricCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--%"
                            android:textColor="@color/eve_tile_medium_text" />

                        <TextView
                            style="@style/TextAppearance.Eve.Result.MetricLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Accuracy"
                            android:textColor="@color/eve_tile_medium_text" />
                    </LinearLayout>
                </com.eve.app.ui.result.ResultStatisticsGrid>
            </LinearLayout>

            <!-- ========================================================== -->
            <!-- 2. PERFORMANCE CONTAINER                                   -->
            <!-- ========================================================== -->
            <LinearLayout
                android:id="@+id/layoutContainerPerformance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Standing Hero Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Eve.Card.Group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_badge">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="Standing Trophy"
                                android:src="@drawable/ic_trophy"
                                app:tint="@color/eve_gold" />
                        </FrameLayout>

                            <TextView
                                android:id="@+id/tvPerfDetailRank"
                                style="@style/TextAppearance.Eve.Leaderboard.HeroRank"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="#-- / --" />

                            <TextView
                                android:id="@+id/tvPerfDetailPercentile"
                                style="@style/TextAppearance.Eve.Subheadline.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Percentile: --%"
                                android:textColor="@color/eve_accent_text" />

                            <TextView
                                android:id="@+id/tvPerfDetailSummary"
                                style="@style/TextAppearance.Eve.Caption1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="Rank calculated across all candidates."
                                android:textColor="?attr/eveLabelSecondary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Batch Comparison Card -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Eve.Card.Group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                style="@style/TextAppearance.Eve.Heading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="Batch Comparison"
                                android:textColor="?attr/eveLabelPrimary" />

                            <com.eve.app.ui.result.ResponsiveResultRow
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <!-- Your Score -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_tile_surface2"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        style="@style/TextAppearance.Eve.Result.InsetLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Your Score" />

                                    <TextView
                                        android:id="@+id/tvPerfYourScore"
                                        style="@style/TextAppearance.Eve.Result.InsetValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="--" />
                                </LinearLayout>

                                <!-- Average Score -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_tile_surface2"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        style="@style/TextAppearance.Eve.Result.InsetLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Batch Average" />

                                    <TextView
                                        android:id="@+id/tvPerfAvgScore"
                                        style="@style/TextAppearance.Eve.Result.InsetValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="--" />
                                </LinearLayout>

                                <!-- Topper Score -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_tile_surface2"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        style="@style/TextAppearance.Eve.Result.InsetLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Topper Score" />

                                    <TextView
                                        android:id="@+id/tvPerfTopperScore"
                                        style="@style/TextAppearance.Eve.Result.InsetValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="--"
                                        android:textColor="@color/eve_tile_right_text" />
                                </LinearLayout>
                            </com.eve.app.ui.result.ResponsiveResultRow>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Ranking Explanation -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Eve.Card.Group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                style="@style/TextAppearance.Eve.Heading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="How Standing Is Calculated"
                                android:textColor="?attr/eveLabelPrimary" />

                            <TextView
                                style="@style/TextAppearance.Eve.Footnote"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="3dp"
                                android:text="• Rank is assigned based on total net marks achieved.\n• In case of ties, higher accuracy and lower negative markings determine the higher standing.\n• Percentile indicates the percentage of all exam takers who scored below your total score."
                                android:textColor="?attr/eveLabelSecondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ========================================================== -->
            <!-- 3. ANALYTICS CONTAINER                                     -->
            <!-- ========================================================== -->
            <LinearLayout
                android:id="@+id/layoutContainerAnalytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Topic Accuracy Breakdown Card (Weakest First) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Eve.Card.Group"
                    android:id="@+id/cardTopicAccuracy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.Eve.Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Topic-wise Accuracy (Weakest First)"
                            android:textColor="?attr/eveLabelPrimary" />

                        <TextView
                            style="@style/TextAppearance.Eve.Caption1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="12dp"
                            android:text="Focus on weaker topics to maximize score gains"
                            android:textColor="?attr/eveLabelSecondary" />

                        <LinearLayout
                            android:id="@+id/layoutTopicList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPracticeWeakest"
                            style="@style/Widget.Eve.Button.OrangePill"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="48dp"
                            android:text="Practice Weakest Topic"
                            android:visibility="gone"
                            android:paddingVertical="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Question Pace Chart Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Eve.Card.Group"
                    android:id="@+id/cardTimePerQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.Eve.Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Time Per Question Pace Chart"
                            android:textColor="?attr/eveLabelPrimary" />

                        <TextView
                            android:id="@+id/tvChartDetail"
                            style="@style/TextAppearance.Eve.Footnote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:text="Tap a bar to inspect time taken"
                            android:textColor="?attr/eveLabelSecondary" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <com.eve.app.ui.result.QuestionTimeChartView
                                android:id="@+id/chartTimeView"
                                android:layout_width="wrap_content"
                                android:layout_height="180dp" />
                        </HorizontalScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Slowest Questions Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Eve.Card.Group"
                    android:id="@+id/cardSlowestQuestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.Eve.Heading"
                            android:layout_width="wrap_content"
