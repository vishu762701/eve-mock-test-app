<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Modal">
    <TextView style="@style/TextAppearance.Eve.Telegram.DialogTitle" android:tag="eve_telegram_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reply to Student Feedback" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:background="@drawable/design_pill_surface" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                <TextView android:id="@+id/tvOriginalSenderName" style="@style/TextAppearance.Eve.Token.Body.blue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Student Name" />
                <TextView android:id="@+id/tvOriginalTimestamp" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24 Sep 2026, 06:30 PM" />
            </LinearLayout>
            <TextView android:id="@+id/tvOriginalSenderEmail" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="student@example.com" />
            <TextView android:id="@+id/tvOriginalMessageText" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="6" android:scrollbars="vertical" android:text="Original message content goes here in full context." />
        </LinearLayout>
    </FrameLayout>
    <com.eve.app.designsystem.TelegramOutlineEditText android:id="@+id/tilReply" style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_pill_padding" android:hint="Type your response to student...">
        <com.eve.app.designsystem.TelegramEditText android:id="@+id/etReplyText" style="@style/Widget.Eve.Token.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences" android:minLines="3" />
    </com.eve.app.designsystem.TelegramOutlineEditText>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_section_gap" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
        <com.eve.app.designsystem.TelegramButton android:id="@+id/btnCancelReply" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="0dp" android:layout_height="@dimen/design_touch_min" android:layout_marginEnd="@dimen/design_row_gap" android:layout_weight="1" android:text="Cancel" />
        <com.eve.app.designsystem.TelegramButton android:id="@+id/btnSendReply" style="@style/Widget.Eve.Token.Button" android:layout_width="0dp" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="@dimen/design_row_gap" android:layout_weight="1" android:text="Send Reply" />
    </LinearLayout>
</LinearLayout>