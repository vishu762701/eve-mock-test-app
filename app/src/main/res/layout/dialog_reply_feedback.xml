<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

    <TextView
        style="@style/TextAppearance.Eve.Secondary.SectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reply to Student Feedback"
        android:textColor="@color/eve_text" />

    <!-- Original Message Card Context -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/eve_card_bg"
        app:cardCornerRadius="@dimen/eve_radius_card"
        app:cardElevation="0dp"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

                <TextView
                    android:id="@+id/tvOriginalSenderName"
                    style="@style/TextAppearance.Eve.Subheadline.Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Student Name"
                    android:textColor="@color/eve_accent_text" />

                <TextView
                    android:id="@+id/tvOriginalTimestamp"
                    style="@style/TextAppearance.Eve.Caption1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24 Sep 2026, 06:30 PM"
                    android:textColor="@color/eve_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOriginalSenderEmail"
                style="@style/TextAppearance.Eve.Caption1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="student@example.com"
                android:textColor="@color/eve_text_secondary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/eve_stroke" />

            <TextView
                android:id="@+id/tvOriginalMessageText"
                style="@style/TextAppearance.Eve.Secondary.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:maxLines="6"
                android:scrollbars="vertical"
                android:text="Original message content goes here in full context."
                android:textColor="@color/eve_text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Reply Input Box directly below the original message -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilReply"
        style="@style/Widget.Eve.TextInput.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Type your response to student...">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReplyText"
            style="@style/TextAppearance.Eve.Callout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:textColor="@color/eve_text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelReply"
            style="@style/Widget.Eve.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendReply"
            style="@style/Widget.Eve.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Send Reply" />
    </LinearLayout>
</LinearLayout>
