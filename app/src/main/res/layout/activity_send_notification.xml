<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Screen">
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <LinearLayout android:id="@+id/normalTopBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="@color/text_primary" style="@style/Widget.Eve.Token.IconButton" />
            </LinearLayout>
            <LinearLayout android:id="@+id/selectionTopBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                <ImageButton android:id="@+id/btnCancelSelection" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Cancel Selection" android:src="@drawable/ic_close" app:tint="@color/text_primary" style="@style/Widget.Eve.Token.IconButton" />
                <TextView style="@style/TextAppearance.Eve.Token.Heading" android:id="@+id/tvSelectedCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_screen_margin" android:layout_weight="1" android:text="0 selected" />
                <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:id="@+id/btnSelectAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:text="Select all" />
                <ImageButton android:id="@+id/btnDeleteSelected" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="4dp" android:contentDescription="Delete Selected" android:src="@drawable/ic_delete" app:tint="@color/text_primary" style="@style/Widget.Eve.Token.IconButton" />
            </LinearLayout>
        </FrameLayout>
    </com.eve.app.ui.common.EveGlassToolbar>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.LargeTitleBlock">
        <TextView style="@style/TextAppearance.Eve.Token.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Publish In-App Notice" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Publish to Notifications Inbox" />
            <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="This message is published for all signed-in students in the in-app inbox. Device push delivery is not confirmed by this feature." />
            <com.eve.app.designsystem.DesignInputLayout android:id="@+id/tilTitle" style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_shadow_room" android:hint="Notification Title">
                <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Eve.Token.Input" android:id="@+id/etTitle" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="textCapSentences" android:maxLines="1" />
            </com.eve.app.designsystem.DesignInputLayout>
            <com.eve.app.designsystem.DesignInputLayout android:id="@+id/tilMessage" style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_section_gap" android:hint="Message" app:counterEnabled="true" app:counterMaxLength="500">
                <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Eve.Token.Input" android:id="@+id/etMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences" android:maxLength="500" android:minLines="5" />
            </com.eve.app.designsystem.DesignInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSend" style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="@dimen/design_icon_size" android:text="Publish to Inbox" app:icon="@drawable/ic_send" app:iconGravity="textStart" />
            <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressBar" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/design_section_gap" android:visibility="gone" style="@style/Widget.Eve.Token.Ring" android:indeterminate="true" />
            <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Published Notices" />
            <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Deleting a notice removes it from the server inbox. It cannot recall notifications already cached on student devices or guarantee device push recall." />
            <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressBarSent" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/design_section_gap" android:visibility="gone" style="@style/Widget.Eve.Token.Ring" android:indeterminate="true" />
            <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:id="@+id/tvNoSentBroadcasts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/design_shadow_room" android:text="No broadcast messages sent yet." android:visibility="gone" />
            <com.eve.app.ui.common.ErrorStateView android:id="@+id/compactErrorView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSentBroadcasts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_section_gap" android:nestedScrollingEnabled="false" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll.Inner" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>