<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    style="@style/Widget.Eve.Card.Group"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/eve_space_12"
    android:layout_marginVertical="@dimen/eve_space_8"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/press_scale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Exam Tag, Question Number, Topic/PYQ, and Unbookmark Star Button -->
        <com.eve.app.ui.result.ResponsiveResultRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:eveHorizontalBreakpoint="440dp">

            <TextView
                android:id="@+id/tvExamTag"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_category_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/eve_accent_text"
                tools:text="SSC CGL 2024"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvQuestionNumber"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_category_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="?attr/eveLabelPrimary"
                tools:text="Q3" />

            <TextView
                android:id="@+id/tvTopicTag"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_category_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="?attr/eveLabelSecondary"
                android:visibility="gone"
                tools:text="Polity"
                tools:visibility="visible"
                android:maxLines="2"
                android:ellipsize="end" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remove Bookmark"
                android:padding="12dp"
                android:src="@drawable/ic_star_filled"
                app:tint="@color/eve_status_warning_text" />
        </com.eve.app.ui.result.ResponsiveResultRow>

        <!-- Question Text -->
        <TextView
            android:id="@+id/tvQuestionText"
            style="@style/TextAppearance.Eve.Callout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eve_space_12"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/eve_text"
            tools:text="What is the capital of France?" />

        <!-- Options Container -->
        <LinearLayout
            android:id="@+id/layoutOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOptionA"
                style="@style/TextAppearance.Eve.Subheadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                tools:text="A. Berlin"
                android:textColor="?attr/eveLabelPrimary" />

            <TextView
                android:id="@+id/tvOptionB"
                style="@style/TextAppearance.Eve.Subheadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                tools:text="B. Madrid"
                android:textColor="?attr/eveLabelPrimary" />

            <TextView
                android:id="@+id/tvOptionC"
                style="@style/TextAppearance.Eve.Subheadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                tools:text="C. Paris (Correct)"
                android:textColor="?attr/eveLabelPrimary" />

            <TextView
                android:id="@+id/tvOptionD"
                style="@style/TextAppearance.Eve.Subheadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                tools:text="D. Rome"
                android:textColor="?attr/eveLabelPrimary" />
        </LinearLayout>

        <!-- Toggle Explanation Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleExplanation"
            style="@style/Widget.Eve.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="-8dp"
            android:text="View Explanation"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Explanation View -->
        <TextView
            android:id="@+id/tvExplanation"
            style="@style/TextAppearance.Eve.Result.ExplanationBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_student_inset"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:visibility="gone"
            tools:text="Paris is the capital and most populous city of France."
            tools:visibility="visible" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@color/eve_menu_glass_divider" />

        <!-- Footer / Action CTA -->
        <LinearLayout
            android:id="@+id/layoutTapToOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:minHeight="48dp">

            <TextView
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tap to open in test"
                android:textColor="@color/eve_accent_text" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Open"
                android:src="@drawable/ic_back"
                android:rotation="180"
                app:tint="@color/eve_primary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
