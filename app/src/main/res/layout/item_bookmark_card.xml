<?xml version='1.0' encoding='utf-8'?>
<com.eve.app.designsystem.DesignCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:ns2="http://schemas.android.com/tools" style="@style/Widget.Eve.Token.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="@dimen/design_zero" android:clickable="true" android:focusable="true" android:minHeight="@dimen/eve_list_row_min" android:layout_marginBottom="@dimen/design_card_gap">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
        <com.eve.app.ui.result.ResponsiveResultRow android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" app:eveHorizontalBreakpoint="440dp" android:clipChildren="false" android:clipToPadding="false">
            <TextView android:id="@+id/tvExamTag" style="@style/TextAppearance.Eve.Token.Secondary.blue" android:layout_width="wrap_content" android:layout_height="wrap_content" ns2:text="SSC CGL 2024" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/tvQuestionNumber" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_row_gap" ns2:text="Q3" />
            <TextView android:id="@+id/tvTopicTag" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_row_gap" android:visibility="gone" ns2:text="Polity" ns2:visibility="visible" android:maxLines="2" android:ellipsize="end" />
            <View android:layout_width="@dimen/design_zero" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/btnBookmark" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Remove Bookmark" android:src="@drawable/ic_star_filled" app:tint="@color/system_orange" style="@style/Widget.Eve.Token.IconButton" />
        </com.eve.app.ui.result.ResponsiveResultRow>
        <TextView android:id="@+id/tvQuestionText" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/eve_space_12" ns2:text="What is the capital of France?" />
        <LinearLayout android:id="@+id/layoutOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <TextView android:id="@+id/tvOptionA" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" ns2:text="A. Berlin" />
            <TextView android:id="@+id/tvOptionB" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" ns2:text="B. Madrid" />
            <TextView android:id="@+id/tvOptionC" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" ns2:text="C. Paris (Correct)" />
            <TextView android:id="@+id/tvOptionD" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" ns2:text="D. Rome" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnToggleExplanation" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="4dp" android:layout_marginStart="-8dp" android:text="View Explanation" android:visibility="gone" ns2:visibility="visible" />
        <TextView android:id="@+id/tvExplanation" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" android:visibility="gone" ns2:text="Paris is the capital and most populous city of France." ns2:visibility="visible" />
        <LinearLayout android:id="@+id/layoutTapToOpen" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="@dimen/design_touch_min" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <TextView style="@style/TextAppearance.Eve.Token.Secondary.blue" android:layout_width="@dimen/design_zero" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tap to open in test" />
            <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Open" android:src="@drawable/ic_back" android:rotation="180" app:tint="@color/system_blue" />
        </LinearLayout>
    </LinearLayout>
</com.eve.app.designsystem.DesignCardView>