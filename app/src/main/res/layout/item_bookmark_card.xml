<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/eve_radius_md"
    app:cardElevation="2dp"
    app:strokeColor="@color/eve_menu_glass_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Exam Tag, Question Number, Topic/PYQ, and Unbookmark Star Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvExamTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_category_chip"
                android:fontFamily="@font/poppins_medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/eve_primary"
                android:textSize="11sp"
                tools:text="SSC CGL 2024" />

            <TextView
                android:id="@+id/tvQuestionNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_category_chip"
                android:fontFamily="@font/poppins_semibold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/eve_text"
                android:textSize="11sp"
                tools:text="Q3" />

            <TextView
                android:id="@+id/tvTopicTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_category_chip"
                android:fontFamily="@font/poppins_regular"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/eve_text_secondary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Polity"
                tools:visibility="visible" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remove Bookmark"
                android:padding="6dp"
                android:src="@drawable/ic_star_filled" />
        </LinearLayout>

        <!-- Question Text -->
        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="3dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="What is the capital of France?" />

        <!-- Options Container -->
        <LinearLayout
            android:id="@+id/layoutOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOptionA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/poppins_regular"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textSize="13sp"
                tools:text="A. Berlin" />

            <TextView
                android:id="@+id/tvOptionB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/poppins_regular"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textSize="13sp"
                tools:text="B. Madrid" />

            <TextView
                android:id="@+id/tvOptionC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/poppins_regular"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textSize="13sp"
                tools:text="C. Paris (Correct)" />

            <TextView
                android:id="@+id/tvOptionD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textSize="13sp"
                tools:text="D. Rome" />
        </LinearLayout>

        <!-- Toggle Explanation Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleExplanation"
            style="@style/Widget.Eve.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="-8dp"
            android:text="View Explanation"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Explanation View -->
        <TextView
            android:id="@+id/tvExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_category_chip"
            android:fontFamily="@font/poppins_regular"
            android:lineSpacingExtra="3dp"
            android:padding="10dp"
            android:textColor="@color/eve_text"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Paris is the capital and most populous city of France."
            tools:visibility="visible" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@color/eve_menu_glass_divider" />

        <!-- Footer / Action CTA -->
        <LinearLayout
            android:id="@+id/layoutTapToOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="Tap to open in test"
                android:textColor="@color/eve_primary"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Open"
                android:src="@drawable/ic_back"
                android:rotation="180"
                app:tint="@color/eve_primary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
