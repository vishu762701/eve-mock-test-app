<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menuContainer"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    app:cardBackgroundColor="@color/eve_menu_glass_bg"
    app:cardCornerRadius="@dimen/eve_radius_md"
    app:cardElevation="12dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:strokeColor="@color/eve_menu_glass_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card 1: Theme Toggle Row (Preserves cardTheme ID for touch & window coords) -->
        <LinearLayout
            android:id="@+id/cardTheme"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <ImageView
                android:id="@+id/ivThemeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:contentDescription="Theme mode"
                android:src="@drawable/ic_sun"
                app:tint="@color/eve_text" />

            <TextView
                android:id="@+id/tvThemeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:fontFamily="@font/poppins_medium"
                android:text="Dark Mode"
                android:textColor="@color/eve_text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Subtle 1dp Frosted Glass Divider -->
        <View
            android:id="@+id/menuDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/eve_menu_glass_divider" />

        <!-- Card 2: Main Menu Items (Preserves cardMenuItems ID) -->
        <LinearLayout
            android:id="@+id/cardMenuItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1: History -->
            <LinearLayout
                android:id="@+id/menuRowHistory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="History"
                    android:src="@drawable/ic_history_rounded"
                    app:tint="@color/eve_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="History"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Row 2: Performance -->
            <LinearLayout
                android:id="@+id/menuRowPerformance"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Performance"
                    android:src="@drawable/ic_performance_increase" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Performance"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Row 3: Topic-wise Test -->
            <LinearLayout
                android:id="@+id/menuRowTopic"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Topic-wise Test"
                    android:src="@drawable/ic_topic"
                    app:tint="@color/eve_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Topic-wise Test"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Row 4: PYQ -->
            <LinearLayout
                android:id="@+id/menuRowPyq"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="PYQ"
                    android:src="@drawable/ic_pyq"
                    app:tint="@color/eve_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="PYQ"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Row 5: Syllabus -->
            <LinearLayout
                android:id="@+id/menuRowSyllabus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Syllabus"
                    android:src="@drawable/ic_syllabus"
                    app:tint="@color/eve_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Syllabus"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Row 6: Overall Leaderboard -->
            <LinearLayout
                android:id="@+id/menuRowLeaderboard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Overall Leaderboard"
                    android:src="@drawable/ic_leaderboard_star"
                    app:tint="@color/eve_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Overall Leaderboard"
                    android:textColor="@color/eve_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Row 7: Logout (Last row, highlighted) -->
            <LinearLayout
                android:id="@+id/menuRowLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Logout"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/eve_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Logout"
                    android:textColor="@color/eve_red"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
