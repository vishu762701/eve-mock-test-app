                            <ImageView android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:contentDescription="Maintenance Mode" android:src="@drawable/ic_maintenance" app:tint="@color/system_red" />
                            <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_card_gap" android:layout_weight="1" android:text="Maintenance Mode" />
                            <TextView style="@style/TextAppearance.Eve.Token.Secondary.green" android:id="@+id/tvLiveMaintenanceStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OFF (Live)" />
                        </LinearLayout>
                        <TextView style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" android:text="When active, all students are immediately blocked by a maintenance screen with your custom message." />
                        <com.eve.app.designsystem.TelegramSwitch android:id="@+id/switchMaintenanceMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:text="Enable Maintenance Mode" />
                        <com.eve.app.designsystem.DesignInputLayout style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:hint="Custom Maintenance Notice Message">
                            <com.google.android.material.textfield.TextInputEditText style="@style/Widget.Eve.Token.Input" android:id="@+id/etMaintenanceMessage" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:gravity="top|start" android:lines="2" android:maxLines="4" />
                        </com.eve.app.designsystem.DesignInputLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnApplyMaintenance" style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="@dimen/design_pill_padding" android:text="Publish Maintenance Settings" />
                        <com.eve.app.designsystem.TelegramRadialProgressView android:id="@+id/progressBarMaintenance" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:layout_gravity="center" android:layout_marginTop="@dimen/design_card_gap" android:visibility="gone" />
                    </LinearLayout>
                </com.eve.app.designsystem.DesignCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>