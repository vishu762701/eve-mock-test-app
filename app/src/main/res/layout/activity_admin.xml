<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eve_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eve_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/eve_text" />

        <TextView
            style="@style/TextAppearance.Eve.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Admin Dashboard" />

        <ProgressBar
            android:id="@+id/progressBarAdmin"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Tabs: 1. Create Exam, 2. Manage Questions, 3. Admins -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eve_bg"
        app:tabIndicatorColor="@color/eve_system_blue"
        app:tabIndicatorHeight="2dp"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabMinWidth="80dp"
        app:tabSelectedTextColor="@color/eve_text"
        app:tabTextAppearance="@style/TextAppearance.Eve.Button"
        app:tabTextColor="@color/eve_text_secondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exams" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage Questions" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admins" />

    </com.google.android.material.tabs.TabLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/eve_stroke" />

    <!-- Container for Tab Contents -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ========================================================= -->
        <!-- TAB 1: CREATE EXAM & CONTENT MANAGEMENT                  -->
        <!-- ========================================================= -->
        <ScrollView
            android:id="@+id/scrollTabCreateExam"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- CONTENT MANAGEMENT SECTION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.08"
                    android:text="CONTENT MANAGEMENT"
                    android:textColor="@color/eve_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageExistingExams"
                    style="@style/Widget.Eve.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Manage Existing Exams"
                    app:icon="@drawable/ic_exam_placeholder"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageExams"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Manage Exams"
                    app:icon="@drawable/ic_edit"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGeneratedTests"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="AI Generated Tests"
                    app:icon="@drawable/ic_robot"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHomeBanner"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Home Banner"
                    app:icon="@drawable/ic_image"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFloatingLink"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Floating Link"
                    app:icon="@drawable/ic_link"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManagePremium"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Premium Management"
                    app:icon="@drawable/ic_star_filled"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageSyllabus"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Manage Syllabus"
                    app:icon="@drawable/ic_syllabus"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

            </LinearLayout>
        </ScrollView>

        <!-- ========================================================= -->
        <!-- TAB 2: MANAGE QUESTIONS (Sections 2 & 3 Combined)        -->
        <!-- ========================================================= -->
        <ScrollView
            android:id="@+id/scrollTabManageQuestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 2. Select Exam -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Select Exam (to manage questions)"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spExam"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditExamImage"
                        style="@style/Widget.Eve.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Image" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRenameExam"
                        style="@style/Widget.Eve.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Rename" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeleteExam"
                        style="@style/Widget.Eve.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Delete"
                        android:textColor="@color/eve_red" />
                </LinearLayout>

                <!-- 3. Questions in Selected Exam -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="3. Questions in Selected Exam"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

                <!-- Action Buttons: Manual Single-Question Add + Bulk Upload -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddQuestionManual"
                        style="@style/Widget.Eve.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="+ Add Question" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBulkUploadSelectedExam"
                        style="@style/Widget.Eve.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="📥 Bulk Upload" />
                </LinearLayout>

                <!-- Distinct Empty States Container -->
                <LinearLayout
                    android:id="@+id/layoutEmptyQuestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="36dp">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/ivEmptyStateFolder"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="No exam selected placeholder"
                        app:lottie_autoPlay="false"
                        app:lottie_loop="false"
                        app:lottie_rawRes="@raw/search" />

                    <TextView
                        android:id="@+id/tvEmptyQuestionsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="Select an exam above to view its questions"
                        android:textColor="@color/eve_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvEmptyQuestionsSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Choose an exam from the dropdown to manage questions or upload new ones."
                        android:textColor="@color/eve_text_secondary"
                        android:textSize="13sp" />


                </LinearLayout>

                <!-- Kept for backward compatibility if referenced -->
                <TextView
                    android:id="@+id/tvNoQuestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="No questions uploaded yet"
                    android:textColor="@color/eve_grey"
                    android:visibility="gone" />

                <!-- Questions RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvQuestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layoutAnimation="@anim/layout_enter"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <!-- ========================================================= -->
        <!-- TAB 3: ADMINS & DASHBOARD MONITORING                     -->
        <!-- ========================================================= -->
        <ScrollView
            android:id="@+id/scrollTabAdmins"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. USER MANAGEMENT -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="USER MANAGEMENT"
                    android:textColor="@color/eve_text_secondary"
                    android:textSize="13sp" />

                <!-- Stats Card (Tappable -> Manage Users) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUserStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/eve_card_bg"
                    app:cardCornerRadius="@dimen/eve_radius_card"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/eve_shape_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvTotalUsers"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="@color/eve_text"
                                    android:textSize="22sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total Signups"
                                    android:textColor="@color/eve_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvOnlineUsers"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="@color/eve_green"
                                    android:textSize="22sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Online Now"
                                    android:textColor="@color/eve_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/btnRefreshStats"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Refresh stats"
                                android:padding="6dp"
                                android:src="@drawable/ic_refresh"
                                app:tint="@color/eve_text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Tap to manage users &amp; view test history →"
                            android:textColor="@color/eve_primary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageUsers"
                    style="@style/Widget.Eve.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Manage Users List"
                    app:icon="@drawable/ic_users"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <!-- 4. Manage Admins Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="4. Manage Admins"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="Add new admin emails dynamically without requiring an app update."
                    android:textColor="@color/eve_grey"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etAdminEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="new-admin@gmail.com"
                        android:inputType="textEmailAddress" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddAdmin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Add" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoAdmins"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:text="No extra dynamic admins added"
                    android:textColor="@color/eve_grey"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAdmins"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutAnimation="@anim/layout_enter"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false" />

                <!-- COMMUNICATION SECTION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:letterSpacing="0.08"
                    android:text="COMMUNICATION"
                    android:textColor="@color/eve_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendNotification"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Broadcast Notification (High-Risk)"
                    android:textColor="@color/eve_red"
                    app:icon="@drawable/ic_broadcast"
                    app:iconPadding="12dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/eve_red"
                    app:strokeColor="@color/eve_shape_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlaggedQuestions"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Flagged Questions Inbox"
                    app:icon="@drawable/ic_flag"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFeedbackReplies"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Feedback Replies"
                    app:icon="@drawable/ic_message_dots"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateFeedbackPost"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Create Feedback Post"
                    app:icon="@drawable/ic_campaign"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageFeedbackPosts"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Manage Feedback Posts"
                    app:icon="@drawable/ic_edit"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <!-- ANALYTICS & MONITORING SECTION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:letterSpacing="0.08"
                    android:text="ANALYTICS &amp; MONITORING"
                    android:textColor="@color/eve_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSystemMonitor"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="System Health &amp; Operations" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnalyticsAdmin"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Admin Analytics &amp; Crash Reports"
                    app:icon="@drawable/ic_analytics"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActivityLog"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Activity &amp; Audit Log"
                    app:icon="@drawable/ic_history"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApiUsage"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="API Usage &amp; Cost Monitor"
                    app:icon="@drawable/ic_analytics"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportData"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Export All Exam Data (JSON)"
                    app:icon="@drawable/ic_download"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAppConfig"
                    style="@style/Widget.Eve.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="App Config &amp; Maintenance Mode"
                    app:icon="@drawable/ic_maintenance"
                    app:iconPadding="12dp"
                    app:iconSize="20dp" />

                <!-- APP VERSION & BUILD STATUS SECTION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:letterSpacing="0.08"
                    android:text="APP VERSION &amp; BUILD STATUS"
                    android:textColor="@color/eve_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/eve_card_bg"
                    app:cardCornerRadius="@dimen/eve_radius_card"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/eve_shape_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Build Info"
                                android:src="@drawable/ic_info"
                                app:tint="@color/eve_primary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="Version Enforcement Status"
                                android:textColor="@color/eve_text"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvVersionStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@color/eve_surface_variant"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="Active"
                                android:textColor="@color/eve_green"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Installed Version"
                                    android:textColor="@color/eve_text_secondary"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvInstalledVersion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="v1.0 (Code 1)"
                                    android:textColor="@color/eve_text"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Min Supported Code"
                                    android:textColor="@color/eve_text_secondary"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvMinSupportedVersion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1"
                                    android:textColor="@color/eve_text"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="To enforce an immediate update on older student devices, update 'minimum_supported_version_code' in Firebase Remote Config or using App Config."
                            android:textColor="@color/eve_grey"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- MAINTENANCE MODE CONTROL PANEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:letterSpacing="0.08"
                    android:text="SYSTEM MAINTENANCE"
                    android:textColor="@color/eve_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/eve_card_bg"
                    app:cardCornerRadius="@dimen/eve_radius_card"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/eve_shape_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Maintenance Mode"
                                android:src="@drawable/ic_maintenance"
                                app:tint="@color/eve_red" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="Maintenance Mode"
                                android:textColor="@color/eve_text"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvLiveMaintenanceStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@color/eve_surface_variant"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="OFF (Live)"
                                android:textColor="@color/eve_green"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="When active, all students are immediately blocked by a maintenance screen with your custom message."
                            android:textColor="@color/eve_text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchMaintenanceMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Enable Maintenance Mode"
                            android:textColor="@color/eve_text" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="Custom Maintenance Notice Message"
                            app:boxStrokeColor="@color/selector_shape_border"
                            app:boxStrokeErrorColor="@color/selector_shape_border"
                            app:boxStrokeWidth="1dp"
                            app:boxStrokeWidthFocused="1dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMaintenanceMessage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top|start"
                                android:lines="2"
                                android:maxLines="4"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnApplyMaintenance"
                            style="@style/Widget.Eve.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Publish Maintenance Settings" />

                        <ProgressBar
                            android:id="@+id/progressBarMaintenance"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="8dp"
                            android:indeterminate="true"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
