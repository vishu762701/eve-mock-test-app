<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Screen">
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/telegram_action_bar_height" android:orientation="horizontal" android:gravity="center_vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.ToolbarRow">
            <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/telegram_action_bar_back_width" android:layout_height="match_parent" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="@color/telegram_type_primary" style="@style/Widget.Eve.Token.IconButton" />
            <TextView android:ellipsize="end" android:maxLines="1" android:layout_marginStart="@dimen/telegram_action_bar_title_start" android:layout_weight="1" style="@style/TextAppearance.Eve.Telegram.NavigationTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Previous Year Questions"  android:tag="eve_telegram_type" />
        </LinearLayout>
    </com.eve.app.ui.common.EveGlassToolbar>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose an exam, year and paper to practice original questions in their published order." />
            <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_icon_size" android:text="Exam" />
            <com.eve.app.designsystem.DesignSpinner android:id="@+id/spExam" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:minHeight="56dp" android:layout_marginTop="@dimen/design_card_gap" android:spinnerMode="dropdown" android:popupBackground="@drawable/telegram_dialog_popup_fixed_alert4" android:contentDescription="Select exam" style="@style/Widget.Eve.Token.Spinner" />
            <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_icon_size" android:text="Year" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:scrollbars="none" android:clipToPadding="false" android:clipChildren="false">
                <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupYears" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipSpacingHorizontal="@dimen/design_card_gap" app:singleLine="true" app:singleSelection="true" />
            </HorizontalScrollView>
            <TextView android:id="@+id/tvPapersLabel" android:visibility="gone" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_icon_size" android:text="Choose a paper or shift" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupPapers" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" app:chipSpacingVertical="@dimen/design_screen_margin" app:chipSpacingHorizontal="@dimen/design_card_gap" />
            <com.eve.app.designsystem.TelegramRadialProgressView android:id="@+id/progress" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_ring_size" android:layout_gravity="center" android:layout_marginVertical="@dimen/design_shadow_room" android:visibility="visible" />
            <TextView android:id="@+id/tvMessage" style="@style/TextAppearance.Eve.Token.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_shadow_room" android:gravity="center" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>