<?xml version="1.0" encoding="utf-8"?>
<!-- Telegram-exact Profile Page -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/Widget.Eve.Token.Screen">

    <!-- Top Glass Toolbar -->
    <com.eve.app.ui.common.EveGlassToolbar
        android:id="@+id/glassToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        android:translationZ="4dp">

        <LinearLayout
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/design_touch_min"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            style="@style/Widget.Eve.Token.ToolbarRow">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/design_touch_min"
                android:layout_height="@dimen/design_touch_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@color/telegram_type_primary" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                style="@style/TextAppearance.Eve.Telegram.NavigationTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:alpha="0"
                android:text="Profile" />
        </LinearLayout>
    </com.eve.app.ui.common.EveGlassToolbar>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:clipToPadding="false"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="56dp">

            <!-- Avatar & Gooey Container -->
            <FrameLayout
                android:id="@+id/avatarOuterContainer"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.eve.app.ui.profile.ProfileGooeyView
                    android:id="@+id/avatarGooey"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <FrameLayout
                        android:id="@+id/avatarContainer"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivProfilePhoto"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:contentDescription="Profile photo"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_person"
                            app:shapeAppearanceOverlay="@style/ShapeCircle" />
                    </FrameLayout>
                </com.eve.app.ui.profile.ProfileGooeyView>
            </FrameLayout>

            <!-- Photo actions (Cancel / Save when picking photo) -->
            <LinearLayout
                android:id="@+id/layoutPhotoActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelPhoto"
                    style="@style/Widget.Eve.Token.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/design_touch_min"
                    android:layout_marginEnd="8dp"
                    android:text="Cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSavePhoto"
                    style="@style/Widget.Eve.Token.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/design_touch_min"
                    android:text="Save" />
            </LinearLayout>

            <!-- Name and Status -->
            <TextView
                android:id="@+id/tvName"
                style="@style/TextAppearance.Eve.Telegram.ProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="24dp"
                android:gravity="center"
                tools:text="Student Name" />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/TextAppearance.Eve.Telegram.ProfileStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                tools:text="Student" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAdmin"
                style="@style/Widget.Eve.Token.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:clickable="false"
                android:text="Admin"
                android:visibility="gone" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPremium"
                style="@style/Widget.Eve.Token.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:text="Premium Active"
                android:visibility="gone"
                app:chipIcon="@drawable/ic_star_filled"
                app:chipIconTint="@color/design_role_premium_text" />

            <!-- Three Action Buttons (Set Photo, Edit Info, Settings) -->
            <LinearLayout
                android:id="@+id/layoutActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnSetPhoto"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/design_pill_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/telegram_profile_photo"
                        app:tint="@color/telegram_type_primary" />

                    <TextView
                        style="@style/TextAppearance.Eve.Telegram.ProfileAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Set Photo" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnEditInfo"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/design_pill_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/telegram_profile_edit"
                        app:tint="@color/telegram_type_primary" />

                    <TextView
                        style="@style/TextAppearance.Eve.Telegram.ProfileAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Edit Info" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSettings"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/design_pill_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/telegram_profile_settings"
                        app:tint="@color/telegram_type_primary" />

                    <TextView
                        style="@style/TextAppearance.Eve.Telegram.ProfileAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Settings" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 1: Personal Information -->
            <com.eve.app.designsystem.DesignCardView
                android:id="@+id/cardPersonalInfo"
                style="@style/Widget.Eve.Token.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Mobile -->
                    <LinearLayout
                        android:id="@+id/cellMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:paddingVertical="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp">

                        <TextView
                            android:id="@+id/tvMobileValue"
                            style="@style/TextAppearance.Eve.Telegram.SettingsLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="+91 98765 43210" />

                        <TextView
                            android:id="@+id/tvMobileLabel"
                            style="@style/TextAppearance.Eve.Telegram.SettingsDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Mobile" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="@color/category_pill_unselected_bg" />

                    <!-- Username -->
                    <LinearLayout
                        android:id="@+id/cellUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:paddingVertical="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp">

                        <TextView
                            android:id="@+id/tvUsernameValue"
                            style="@style/TextAppearance.Eve.Telegram.SettingsLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="@ev_wk96r9" />

                        <TextView
                            android:id="@+id/tvUsernameLabel"
                            style="@style/TextAppearance.Eve.Telegram.SettingsDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Username" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="@color/category_pill_unselected_bg" />

                    <!-- Birthday -->
                    <LinearLayout
                        android:id="@+id/cellBirthday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:paddingVertical="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp">

                        <TextView
                            android:id="@+id/tvBirthdayValue"
                            style="@style/TextAppearance.Eve.Telegram.SettingsLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="Mar 15, 2004 (22 years old)" />

                        <TextView
                            android:id="@+id/tvBirthdayLabel"
                            style="@style/TextAppearance.Eve.Telegram.SettingsDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Date of Birth" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="@color/category_pill_unselected_bg" />

                    <!-- Category -->
                    <LinearLayout
                        android:id="@+id/cellCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:paddingVertical="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCategoryValue"
                                style="@style/TextAppearance.Eve.Telegram.SettingsLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                tools:text="General" />

                            <TextView
                                android:id="@+id/tvCategoryLabel"
                                style="@style/TextAppearance.Eve.Telegram.SettingsDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Category" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivCategoryArrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/telegram_type_secondary" />
                    </LinearLayout>

                    <!-- Expandable Category Options -->
                    <LinearLayout
                        android:id="@+id/layoutCategoryOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingBottom="12dp"
                        android:visibility="gone">

                        <com.eve.app.ui.common.TelegramRadioButton
                            android:id="@+id/radioGeneral"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="General" />

                        <com.eve.app.ui.common.TelegramRadioButton
                            android:id="@+id/radioObc"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="OBC" />

                        <com.eve.app.ui.common.TelegramRadioButton
                            android:id="@+id/radioSc"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="SC" />

                        <com.eve.app.ui.common.TelegramRadioButton
                            android:id="@+id/radioSt"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="ST" />
                    </LinearLayout>
                </LinearLayout>
            </com.eve.app.designsystem.DesignCardView>

            <!-- Card 2: EVE Extras (Eve ID, Reminder, Admin actions) -->
            <com.eve.app.designsystem.DesignCardView
                android:id="@+id/cardExtras"
                style="@style/Widget.Eve.Token.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- EVE ID -->
                    <LinearLayout
                        android:id="@+id/cellEveId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:paddingVertical="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvEveId"
                                style="@style/TextAppearance.Eve.Telegram.SettingsLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                tools:text="EV-WK96R9" />

                            <TextView
                                android:id="@+id/tvEveIdLabel"
                                style="@style/TextAppearance.Eve.Telegram.SettingsDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="EVE ID" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnCopyEveId"
                            android:layout_width="@dimen/design_touch_min"
                            android:layout_height="@dimen/design_touch_min"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Copy EVE ID"
                            android:src="@drawable/ic_copy"
                            app:tint="@color/telegram_type_secondary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="@color/category_pill_unselected_bg" />

                    <!-- Daily Reminder with Telegram Switch -->
                    <LinearLayout
                        android:id="@+id/cellReminder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:paddingVertical="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <TextView
                            style="@style/TextAppearance.Eve.Telegram.SettingsLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:text="Daily Practice Reminder" />

                        <com.eve.app.designsystem.TelegramSwitch
                            android:id="@+id/switchReminder"
                            android:layout_width="37dp"
                            android:layout_height="24dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.eve.app.designsystem.DesignCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
