<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:ns2="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Screen">
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.ToolbarRow">
            <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="?attr/eveLabelPrimary" style="@style/Widget.Eve.Token.IconButton" />
            <View android:layout_width="@dimen/design_zero" android:layout_height="@dimen/design_zero" android:layout_weight="1" />
        </LinearLayout>
    </com.eve.app.ui.common.EveGlassToolbar>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.LargeTitleBlock">
        <TextView style="@style/TextAppearance.Eve.Token.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Profile" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="@dimen/design_zero" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:overScrollMode="ifContentScrolls" android:clipChildren="false" style="@style/Widget.Eve.Token.Scroll">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
                    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivProfilePhoto" android:layout_width="100dp" android:layout_height="100dp" android:contentDescription="Profile photo" android:src="@drawable/ic_person" app:shapeAppearanceOverlay="@style/ShapeCircle" />
                    <ImageButton android:id="@+id/btnChangePhoto" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:layout_gravity="bottom|end" android:contentDescription="Change photo" android:src="@drawable/ic_camera" app:tint="@color/on_accent" style="@style/Widget.Eve.Token.IconButton" />
                </FrameLayout>
                <LinearLayout android:id="@+id/layoutPhotoActions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:gravity="center" android:orientation="horizontal" android:visibility="gone" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelPhoto" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:layout_marginEnd="@dimen/design_card_padding" android:text="Cancel" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSavePhoto" style="@style/Widget.Eve.Token.Button" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:text="Save" />
                </LinearLayout>
                <TextView android:id="@+id/tvName" style="@style/TextAppearance.Eve.Token.Heading" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_pill_padding" ns2:text="Student" />
                <TextView android:id="@+id/tvEmail" style="@style/TextAppearance.Eve.Token.Body" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" ns2:text="student@gmail.com" />
                <LinearLayout android:id="@+id/layoutEveId" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                    <TextView android:id="@+id/tvEveIdLabel" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EVE ID: " />
                    <TextView android:id="@+id/tvEveId" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="@dimen/design_zero" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:layout_height="wrap_content" ns2:text="EV-ABC123" />
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnCopyEveId" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="4dp" android:clickable="true" android:contentDescription="Copy EVE ID" android:focusable="true" android:src="@drawable/ic_copy" app:tint="@color/text_secondary" style="@style/Widget.Eve.Token.IconButton" />
                </LinearLayout>
                <com.google.android.material.chip.Chip android:id="@+id/chipAdmin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:clickable="false" android:text="Admin" android:visibility="gone" style="@style/Widget.Eve.Token.Chip" />
                <com.google.android.material.chip.Chip android:id="@+id/chipPremium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:clickable="true" android:text="Premium Active" android:visibility="gone" app:chipIcon="@drawable/ic_star_filled" app:chipIconTint="@color/design_role_premium_text" style="@style/Widget.Eve.Token.Chip" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="@dimen/eve_stroke_hairline" android:layout_marginHorizontal="@dimen/design_screen_margin" android:layout_marginTop="@dimen/design_shadow_room" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="@dimen/design_screen_margin" android:layout_marginTop="18dp" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Panel">
                <TextView style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Personal Information" />
                <com.eve.app.designsystem.DesignInputLayout android:id="@+id/tilName" style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:hint="Full Name">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etName" style="@style/Widget.Eve.Token.Input" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:inputType="textPersonName" android:maxLines="1" />
                </com.eve.app.designsystem.DesignInputLayout>
                <com.eve.app.designsystem.DesignInputLayout android:id="@+id/tilDob" style="@style/Widget.Eve.Token.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_screen_margin" android:hint="Date of Birth (DD/MM/YYYY)" app:endIconDrawable="@drawable/ic_calendar" app:endIconMode="custom">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDob" style="@style/Widget.Eve.Token.Input" android:layout_width="match_parent" android:layout_height="@dimen/design_input_height" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:inputType="none" android:maxLines="1" />
                </com.eve.app.designsystem.DesignInputLayout>
                <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_section_gap" android:text="Category" />
                <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" app:selectionRequired="true" app:singleSelection="true" app:chipSpacingHorizontal="@dimen/design_card_gap" app:chipSpacingVertical="4dp">
                    <com.google.android.material.chip.Chip android:id="@+id/chipGeneral" style="@style/Widget.Eve.Token.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="General" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipObc" style="@style/Widget.Eve.Token.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OBC" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipSc" style="@style/Widget.Eve.Token.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SC" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipSt" style="@style/Widget.Eve.Token.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ST" />
                </com.google.android.material.chip.ChipGroup>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveProfile" style="@style/Widget.Eve.Token.Button" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginTop="@dimen/design_section_gap" android:text="Save Profile" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="@dimen/eve_stroke_hairline" android:layout_marginHorizontal="@dimen/design_screen_margin" android:layout_marginTop="@dimen/design_shadow_room" />
            <LinearLayout android:id="@+id/rowReminder" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipToPadding="false" android:clipChildren="false" style="@style/Widget.Eve.Token.Column">
                <TextView style="@style/TextAppearance.Eve.Token.Body" android:layout_width="@dimen/design_zero" android:layout_height="wrap_content" android:layout_weight="1" android:text="Daily Practice Reminder" />
                <com.eve.app.designsystem.DesignSwitch android:id="@+id/switchReminder" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.Eve.Token.Switch" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEditAbout" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginHorizontal="@dimen/design_screen_margin" android:layout_marginTop="4dp" android:layout_marginBottom="@dimen/design_card_gap" android:text="Edit About Content (Admin)" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAbout" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:layout_marginHorizontal="@dimen/design_screen_margin" android:layout_marginTop="4dp" android:layout_marginBottom="@dimen/design_card_gap" android:text="About" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>