<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eve_system_grouped_background"
    android:orientation="vertical"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

    <!-- Top Bar -->
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_translucent"
            android:stateListAnimator="@animator/press_scale"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="?attr/eveLabelPrimary" />

        <TextView
            style="@style/TextAppearance.Eve.Headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:text="Profile"
            android:textColor="?attr/eveLabelPrimary" />
    </LinearLayout>
</com.eve.app.ui.common.EveGlassToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
            android:clipChildren="false"
            >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

            <!-- Photo & Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingHorizontal="20dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivProfilePhoto"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_circle_primary"
                        android:contentDescription="Profile photo"
                        android:padding="20dp"
                        android:src="@drawable/ic_person"
                        app:shapeAppearanceOverlay="@style/ShapeCircle" />

                    <ImageButton
                        android:id="@+id/btnChangePhoto"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_circle_primary"
                        android:stateListAnimator="@animator/press_scale"
                        android:contentDescription="Change photo"
                        android:elevation="2dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/eve_on_primary" />
                </FrameLayout>

                <!-- Action buttons shown during photo preview -->
                <LinearLayout
                    android:id="@+id/layoutPhotoActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelPhoto"
                        style="@style/Widget.Eve.RecoverySecondary"
                        android:textAppearance="@style/TextAppearance.Eve.Subheadline.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="0dp"
                        android:text="Cancel" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSavePhoto"
                        style="@style/Widget.Eve.RecoveryPrimary"
                        android:textAppearance="@style/TextAppearance.Eve.Subheadline.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="0dp"
                        android:text="Save" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvName"
                    style="@style/TextAppearance.Eve.Title2"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="?attr/eveLabelPrimary"
                    tools:text="Student" />

                <TextView
                    android:id="@+id/tvEmail"
                    style="@style/TextAppearance.Eve.Subheadline"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/eveLabelSecondary"
                    tools:text="student@gmail.com" />

                <LinearLayout
                    android:id="@+id/layoutEveId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

                    <TextView
                        android:id="@+id/tvEveIdLabel"
                        style="@style/TextAppearance.Eve.Footnote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EVE ID: "
                        android:textColor="?attr/eveLabelSecondary" />

                    <TextView
                        android:id="@+id/tvEveId"
                        style="@style/TextAppearance.Eve.Footnote.Medium"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/eveLabelPrimary"
                        tools:text="EV-ABC123" />

                    <ImageView
                        android:id="@+id/btnCopyEveId"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Copy EVE ID"
                        android:focusable="true"
                        android:padding="15dp"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/eve_label_secondary" />
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="false"
                    android:text="Admin"
                    android:textColor="@color/eve_on_primary"
                    android:visibility="gone"
                    app:chipBackgroundColor="@color/eve_accent" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPremium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clickable="true"
                    android:text="Premium Active"
                    android:textColor="@color/eve_premium_text"
                    android:visibility="gone"
                    app:chipIcon="@drawable/ic_star_filled"
                    app:chipIconTint="@color/eve_premium_text"
                    app:chipBackgroundColor="@color/eve_premium_container"
                    app:chipStrokeColor="@color/eve_shape_border"
                    app:chipStrokeWidth="0dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/eve_stroke_hairline"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:background="@color/eve_separator" />

            <!-- Personal / Exam Info Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_student_group"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="18dp"
                android:padding="16dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

                <TextView
                    style="@style/TextAppearance.Eve.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal Information"
                    android:textColor="?attr/eveLabelPrimary" />

                <!-- Name Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilName"
                    style="@style/Widget.Eve.RecoveryInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Full Name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        style="@style/TextAppearance.Eve.Body"
                        android:background="@null"
                        android:minHeight="56dp"
                        android:paddingHorizontal="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textColor="?attr/eveLabelPrimary"
                        android:textColorHint="@color/eve_placeholder_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Date of Birth Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDob"
                    style="@style/Widget.Eve.RecoveryInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Date of Birth (DD/MM/YYYY)"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDob"
                        style="@style/TextAppearance.Eve.Body"
                        android:background="@null"
                        android:minHeight="56dp"
                        android:paddingHorizontal="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:maxLines="1"
                        android:textColor="?attr/eveLabelPrimary"
                        android:textColorHint="@color/eve_placeholder_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Category Field -->
                <TextView
                    style="@style/TextAppearance.Eve.Subheadline.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Category"
                    android:textColor="?attr/eveLabelPrimary" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:selectionRequired="true"
                    app:singleSelection="true"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="4dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGeneral"
                        style="@style/Widget.Eve.AssistChip.Inset"
                        android:textAppearance="@style/TextAppearance.Eve.Footnote.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="General" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipObc"
                        style="@style/Widget.Eve.AssistChip.Inset"
                        android:textAppearance="@style/TextAppearance.Eve.Footnote.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OBC" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSc"
                        style="@style/Widget.Eve.AssistChip.Inset"
                        android:textAppearance="@style/TextAppearance.Eve.Footnote.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SC" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSt"
                        style="@style/Widget.Eve.AssistChip.Inset"
                        android:textAppearance="@style/TextAppearance.Eve.Footnote.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ST" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Save Profile Details Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveProfile"
                    style="@style/Widget.Eve.RecoveryPrimary"
                    android:textAppearance="@style/TextAppearance.Eve.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:stateListAnimator="@animator/press_scale"
                    android:text="Save Profile" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/eve_stroke_hairline"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:background="@color/eve_separator" />

            <!-- Daily Practice Reminder -->
            <LinearLayout
                android:id="@+id/rowReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

                <TextView
                    style="@style/TextAppearance.Eve.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Daily Practice Reminder"
                    android:textColor="?attr/eveLabelPrimary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/selector_eve_switch_thumb"
                    app:trackTint="@color/selector_eve_switch_track" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditAbout"
                style="@style/Widget.Eve.RecoverySecondary"
                android:textAppearance="@style/TextAppearance.Eve.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:stateListAnimator="@animator/press_scale"
                android:text="Edit About Content (Admin)"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbout"
                style="@style/Widget.Eve.RecoverySecondary"
                android:textAppearance="@style/TextAppearance.Eve.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:stateListAnimator="@animator/press_scale"
                android:text="About" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
