<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/eve_card_bg"
    app:cardCornerRadius="@dimen/eve_radius_card"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    android:minHeight="@dimen/eve_list_row_min">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Exam name and Flag count badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvExamName"
                style="@style/TextAppearance.Eve.Admin.ItemSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/eve_accent_text"
                tools:text="SSC CGL Tier 1" />

            <TextView
                android:id="@+id/tvFlagCount"
                style="@style/TextAppearance.Eve.Admin.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_category_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/eve_status_error_text"
                tools:text="🚩 3 flags" />
        </LinearLayout>

        <!-- Question text -->
        <TextView
            android:id="@+id/tvQuestionText"
            style="@style/TextAppearance.Eve.Admin.ItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/eve_text"
            tools:text="Which article of the Indian Constitution deals with the Right to Constitutional Remedies?" />

        <!-- Reasons -->
        <TextView
            android:id="@+id/tvReasons"
            style="@style/TextAppearance.Eve.Caption1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/eve_text_secondary"
            tools:text="Reasons: Wrong answer marked correct, Typo/formatting issue" />

        <!-- Student Comments -->
        <TextView
            android:id="@+id/tvComments"
            style="@style/TextAppearance.Eve.Caption1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/eve_text_secondary"
            tools:text="Comments:\n• Option B says 32 but marked 31.\n• Check key." />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditQuestion"
                style="@style/Widget.Eve.Button"
                android:textAppearance="@style/TextAppearance.Eve.Caption1.Medium"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="✏️ Edit Question" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDismissFlag"
                style="@style/Widget.Eve.OutlinedButton"
                android:textAppearance="@style/TextAppearance.Eve.Caption1.Medium"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="✓ Dismiss Flag" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
