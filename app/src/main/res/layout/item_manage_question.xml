<?xml version='1.0' encoding='utf-8'?>
<com.eve.app.designsystem.DesignCardView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="@dimen/design_zero" android:minHeight="@dimen/design_row_with_gap" style="@style/Widget.Eve.Token.Card" android:layout_marginBottom="@dimen/design_card_gap">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
        <TextView android:id="@+id/tvQuestionText" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvCorrect" style="@style/TextAppearance.Eve.Token.Secondary.green" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_padding" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEdit" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="0dp" android:layout_height="@dimen/design_touch_min" android:layout_marginEnd="@dimen/design_row_gap" android:layout_weight="1" android:text="Edit" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete" style="@style/Widget.Eve.Token.Button.Destructive" android:layout_width="0dp" android:layout_height="@dimen/design_touch_min" android:layout_weight="1" android:text="Delete" />
        </LinearLayout>
    </LinearLayout>
</com.eve.app.designsystem.DesignCardView>