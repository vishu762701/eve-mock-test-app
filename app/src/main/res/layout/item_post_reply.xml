<?xml version='1.0' encoding='utf-8'?>
<com.eve.app.designsystem.DesignCardView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_card_gap" android:minHeight="@dimen/design_row_with_gap" style="@style/Widget.Eve.Token.Card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <TextView android:id="@+id/tvReplyAuthor" style="@style/TextAppearance.Eve.Telegram.ListTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Student Name"  android:tag="eve_telegram_type" />
            <TextView android:id="@+id/tvReplyTime" style="@style/TextAppearance.Eve.Telegram.ListTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today, 12:00 PM"  android:tag="eve_telegram_type" />
        </LinearLayout>
        <TextView android:id="@+id/tvReplyText" style="@style/TextAppearance.Eve.Telegram.ListPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_row_gap" android:text="Reply message text here..."  android:tag="eve_telegram_type" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_card_gap" android:gravity="center_vertical|end" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnMarkRead" style="@style/Widget.Eve.Token.Button.Secondary" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:text="Mark Read" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDeleteReply" style="@style/Widget.Eve.Token.Button.Destructive" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="@dimen/design_card_gap" android:text="Delete" />
        </LinearLayout>
    </LinearLayout>
</com.eve.app.designsystem.DesignCardView>