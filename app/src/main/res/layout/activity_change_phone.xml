<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/Widget.Eve.Token.Screen">

    <!-- Telegram ActionBar (56dp height, 54dp back/done frames, 18dp title start) -->
    <com.eve.app.designsystem.TelegramActionBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/telegram_action_bar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            style="@style/Widget.Eve.Token.ToolbarRow">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/telegram_action_bar_back_width"
                android:layout_height="match_parent"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@color/telegram_type_primary"
                style="@style/Widget.Eve.Token.IconButton" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                style="@style/TextAppearance.Eve.Telegram.NavigationTitle"
                android:tag="eve_telegram_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/telegram_action_bar_title_start"
                android:layout_weight="1"
                android:text="Mobile Number" />

            <ImageButton
                android:id="@+id/btnDone"
                android:layout_width="@dimen/telegram_action_bar_back_width"
                android:layout_height="match_parent"
                android:contentDescription="Done"
                android:src="@drawable/ic_ab_done"
                app:tint="@color/telegram_type_primary"
                style="@style/Widget.Eve.Token.IconButton" />
        </LinearLayout>
    </com.eve.app.designsystem.TelegramActionBar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="21dp"
        android:paddingTop="20dp">

        <EditText
            android:id="@+id/etPhone"
            style="@style/TextAppearance.Eve.Telegram.EditInput"
            android:tag="eve_telegram_type"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@null"
            android:hint="+91 00000 00000"
            android:textColorHint="@color/telegram_type_secondary"
            android:inputType="phone"
            android:maxLines="1"
            android:singleLine="true" />

        <View
            android:id="@+id/linePhone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/TextAppearance.Eve.Telegram.EditHelp"
            android:tag="eve_telegram_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:textColor="@color/telegram_text_red_bold" />

        <TextView
            android:id="@+id/tvHelp"
            style="@style/TextAppearance.Eve.Telegram.EditHelp"
            android:tag="eve_telegram_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:text="Your phone number is optional and visible only to you. Eve does not verify or share your phone number with others." />
    </LinearLayout>
</LinearLayout>
