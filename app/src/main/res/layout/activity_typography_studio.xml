<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Eve.Token.Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.eve.app.ui.common.EveGlassToolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            style="@style/Widget.Eve.Token.ToolbarRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/design_touch_min"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.Eve.Token.IconButton"
                android:layout_width="@dimen/design_touch_min"
                android:layout_height="@dimen/design_touch_min"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />
            <TextView
                style="@style/TextAppearance.Eve.Title3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/design_card_gap"
                android:text="Typography Studio" />
        </LinearLayout>
    </com.eve.app.ui.common.EveGlassToolbar>

    <ScrollView
        style="@style/Widget.Eve.Token.Scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Widget.Eve.Token.Column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- FONT SELECTION CARD -->
            <com.eve.app.designsystem.DesignCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/design_card_gap"
                style="@style/Widget.Eve.Token.Card">

                <LinearLayout
                    style="@style/Widget.Eve.Token.Column"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/design_card_padding">

                    <TextView
                        style="@style/TextAppearance.Eve.Token.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE FONT FAMILY &amp; WEIGHT" />

                    <TextView
                        android:id="@+id/tvActiveFontInfo"
                        style="@style/TextAppearance.Eve.Token.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/design_card_gap"
                        android:text="Selected: Inter Regular (400)" />

                    <!-- Font Choice Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/design_card_gap"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupFonts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipInterRegular"
                                style="@style/Widget.Eve.Token.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Inter Regular (400)"
                                android:checkable="true"
                                android:checked="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipInterMedium"
                                style="@style/Widget.Eve.Token.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Inter Medium (500)"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipInterSemibold"
                                style="@style/Widget.Eve.Token.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Inter Semibold (600)"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipInterBold"
                                style="@style/Widget.Eve.Token.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Inter Bold (700)"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSystemSans"
                                style="@style/Widget.Eve.Token.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="System Sans"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSystemSerif"
                                style="@style/Widget.Eve.Token.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="System Serif"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSystemMono"
                                style="@style/Widget.Eve.Token.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Monospace"
                                android:checkable="true" />

                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Emphasized Toggle -->
                    <LinearLayout
                        style="@style/Widget.Eve.Token.Column"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/design_card_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Eve.Token.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Apply .Emphasized Variant" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchEmphasized"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Custom preview text input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSampleText"
                        style="@style/Widget.Eve.Token.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/design_card_gap"
                        android:hint="Custom preview sample text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSampleText"
                            style="@style/TextAppearance.Eve.Token.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="The quick brown fox jumps over the lazy dog" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Preset buttons row -->
                    <LinearLayout
                        style="@style/Widget.Eve.Token.Column"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/design_card_gap"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPresetEnglish"
                            style="@style/Widget.Eve.Token.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/design_touch_min"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/design_card_gap"
                            android:text="English" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPresetHindi"
                            style="@style/Widget.Eve.Token.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/design_touch_min"
                            android:layout_weight="1"
                            android:text="हिंदी / देवनागरी" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResetText"
                            style="@style/Widget.Eve.Token.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/design_touch_min"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/design_card_gap"
                            android:text="Reset" />
                    </LinearLayout>

                </LinearLayout>
            </com.eve.app.designsystem.DesignCardView>

            <!-- LIVE PREVIEW BANNER / HERO CARD -->
            <com.eve.app.designsystem.DesignCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/design_card_gap"
                style="@style/Widget.Eve.Token.Card">

                <LinearLayout
                    style="@style/Widget.Eve.Token.Column"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/design_card_padding">

                    <TextView
                        style="@style/TextAppearance.Eve.Token.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE COMPONENT PREVIEW" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/previewPrimaryButton"
                        style="@style/Widget.Eve.Token.Button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/design_touch_min"
                        android:layout_marginTop="@dimen/design_card_gap"
                        android:text="Start Mock Test · Primary Button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/previewSecondaryButton"
                        style="@style/Widget.Eve.Token.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/design_touch_min"
                        android:layout_marginTop="@dimen/design_card_gap"
                        android:text="Review Answers · Secondary Button" />

                    <TextView
                        android:id="@+id/previewCardHeading"
                        style="@style/TextAppearance.Eve.Token.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/design_card_gap"
                        android:text="Exam Question Card Preview" />

                    <TextView
                        android:id="@+id/previewCardBody"
                        style="@style/TextAppearance.Eve.Token.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/design_card_gap"
                        android:text="This is an authentic representation of question body content inside EVE." />

                </LinearLayout>
            </com.eve.app.designsystem.DesignCardView>

            <!-- 11 CANONICAL APPLE iOS 26 TYPOGRAPHY STYLES -->
            <TextView
                style="@style/TextAppearance.Eve.Token.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/design_card_gap"
                android:text="11 CANONICAL APPLE iOS 26 STYLES" />

            <include
                android:id="@+id/previewLargeTitle"
                layout="@layout/item_typography_preview_row" />

            <include
                android:id="@+id/previewTitle1"
                layout="@layout/item_typography_preview_row" />

            <include
                android:id="@+id/previewTitle2"
                layout="@layout/item_typography_preview_row" />

            <include
                android:id="@+id/previewTitle3"
                layout="@layout/item_typography_preview_row" />

            <include
                android:id="@+id/previewHeadline"
                layout="@layout/item_typography_preview_row" />

            <include
                android:id="@+id/previewBody"
                layout="@layout/item_typography_preview_row" />

            <include
                android:id="@+id/previewCallout"
                layout="@layout/item_typography_preview_row" />

            <include
                android:id="@+id/previewSubheadline"
                layout="@layout/item_typography_preview_row" />

            <include
                android:id="@+id/previewFootnote"
                layout="@layout/item_typography_preview_row" />

            <include
                android:id="@+id/previewCaption1"
                layout="@layout/item_typography_preview_row" />

            <include
                android:id="@+id/previewCaption2"
                layout="@layout/item_typography_preview_row" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
