<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="72dp"
    android:background="?attr/selectableItemBackground">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:clipToPadding="false"
        android:clipChildren="false">
        <com.eve.app.ui.common.TelegramIconContainerView
            android:id="@+id/examIconContainer"
            style="@style/Widget.Eve.Token.Card.Inner"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">
            <com.eve.app.designsystem.TelegramAvatarImageView
                android:id="@+id/ivExamImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Exam image"
                android:scaleType="centerCrop"
                android:src="@drawable/msg_filehq" />
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieExamIcon"
                android:layout_width="@dimen/design_icon_size"
                android:layout_height="@dimen/design_icon_size"
                android:visibility="gone"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/pencil_writing_on_book"
                android:layout_gravity="center"
                style="@style/Widget.Eve.Token.Lottie" />
        </com.eve.app.ui.common.TelegramIconContainerView>
        <ImageView
            android:id="@+id/ivPinned"
            android:layout_width="@dimen/design_icon_size"
            android:layout_height="@dimen/design_icon_size"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/design_card_gap"
            android:contentDescription="Pinned test"
            android:src="@drawable/ic_pin"
            app:tint="@color/text_secondary"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/design_section_gap"
            android:layout_marginEnd="@dimen/design_card_gap"
            android:layout_toEndOf="@id/examIconContainer"
            android:layout_toStartOf="@id/ivPinned"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            style="@style/Widget.Eve.Token.Column">
            <TextView
                android:id="@+id/tvExamName"
                style="@style/TextAppearance.Eve.Telegram.ListTitle"
                android:tag="eve_telegram_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2" />
            <TextView
                android:id="@+id/tvExamTime"
                style="@style/TextAppearance.Eve.Telegram.ListPreview"
                android:tag="eve_telegram_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/design_compact_gap"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginStart="72dp"
            android:background="@color/hairline"
            android:layout_alignParentBottom="true" />
    </RelativeLayout>
</FrameLayout>
