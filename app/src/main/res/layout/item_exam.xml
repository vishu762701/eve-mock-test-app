<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Eve.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/eve_highlight_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="88dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/tvExamName" style="@style/Eve.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" />
            <TextView android:id="@+id/tvExamTime" style="@style/Eve.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/eve_text_secondary" android:textSize="28sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
