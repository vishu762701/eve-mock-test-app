<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/eve_radius_md"
    app:cardElevation="1dp"
    app:rippleColor="@color/eve_primary"
    app:strokeWidth="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/examIconContainer"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivExamImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/eve_surface_variant"
                android:contentDescription="Exam image"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_exam_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeCircle" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieExamIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:visibility="gone"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/pencil_writing_on_book" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Task D: Pin indicator is icon only (ic_pin), positioned at end without hiding name -->
        <ImageView
            android:id="@+id/ivPinned"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:contentDescription="Pinned test"
            android:src="@drawable/ic_pin"
            android:visibility="gone" />

        <!-- Task C: Exam name is ALWAYS visible in pinned and unpinned states -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="6dp"
            android:layout_toEndOf="@id/examIconContainer"
            android:layout_toStartOf="@id/ivPinned"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvExamName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExamTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/eve_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
