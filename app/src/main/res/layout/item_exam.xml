<?xml version='1.0' encoding='utf-8'?>
<com.eve.app.designsystem.DesignCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.Eve.Token.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="@dimen/design_zero" android:clickable="true" android:focusable="true" app:rippleColor="@color/design_role_ripple" android:minHeight="@dimen/design_row_with_gap" android:layout_marginBottom="@dimen/design_card_gap">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:clipChildren="false">
        <com.eve.app.designsystem.DesignCardView android:id="@+id/examIconContainer" android:layout_width="56dp" android:layout_height="56dp" android:layout_alignParentStart="true" android:layout_centerVertical="true" app:rippleColor="@android:color/transparent" style="@style/Widget.Eve.Token.Card.Inner">
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivExamImage" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Exam image" android:scaleType="centerCrop" android:src="@drawable/ic_exam_placeholder" />
            <com.airbnb.lottie.LottieAnimationView android:id="@+id/lottieExamIcon" android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:visibility="gone" app:lottie_autoPlay="false" app:lottie_loop="false" app:lottie_rawRes="@raw/pencil_writing_on_book" android:layout_gravity="center" style="@style/Widget.Eve.Token.Lottie" />
        </com.eve.app.designsystem.DesignCardView>
        <ImageView android:id="@+id/ivPinned" android:layout_width="@dimen/design_icon_size" android:layout_height="@dimen/design_icon_size" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_marginStart="@dimen/design_card_gap" android:contentDescription="Pinned test" android:src="@drawable/ic_pin" app:tint="@color/text_secondary" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="@dimen/design_section_gap" android:layout_marginEnd="@dimen/design_card_gap" android:layout_toEndOf="@id/examIconContainer" android:layout_toStartOf="@id/ivPinned" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <TextView android:id="@+id/tvExamName" style="@style/TextAppearance.Eve.Telegram.ListTitle" android:tag="eve_telegram_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" />
            <TextView android:id="@+id/tvExamTime" style="@style/TextAppearance.Eve.Telegram.ListPreview" android:tag="eve_telegram_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/design_compact_gap" android:ellipsize="end" android:maxLines="1" />
        </LinearLayout>
    </RelativeLayout>
</com.eve.app.designsystem.DesignCardView>