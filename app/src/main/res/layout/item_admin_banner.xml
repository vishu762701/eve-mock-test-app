<?xml version='1.0' encoding='utf-8'?>
<com.eve.app.designsystem.DesignCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/design_card_gap" android:minHeight="@dimen/eve_list_row_min" style="@style/Widget.Eve.Token.Card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivBannerThumb" android:layout_width="@dimen/design_ring_size" android:layout_height="@dimen/design_input_height" android:adjustViewBounds="true" android:contentDescription="Banner thumbnail" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeCircle" />
        <LinearLayout android:layout_width="@dimen/design_zero" android:layout_height="wrap_content" android:layout_marginStart="@dimen/design_screen_margin" android:layout_weight="1" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Column">
            <TextView android:id="@+id/tvBannerOrder" style="@style/TextAppearance.Eve.Token.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Banner #1" />
            <TextView android:id="@+id/tvBannerDate" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Uploaded today" />
            <TextView android:id="@+id/tvBannerLink" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
        <ImageButton android:id="@+id/btnEditBannerLink" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:layout_marginEnd="2dp" android:contentDescription="Edit banner link" android:src="@drawable/ic_link" app:tint="@color/text_primary" style="@style/Widget.Eve.Token.IconButton" />
        <ImageButton android:id="@+id/btnMoveUp" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Move up" android:src="@drawable/ic_back" android:rotation="90" app:tint="@color/text_primary" style="@style/Widget.Eve.Token.IconButton" />
        <ImageButton android:id="@+id/btnMoveDown" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="2dp" android:contentDescription="Move down" android:src="@drawable/ic_back" android:rotation="270" app:tint="@color/text_primary" style="@style/Widget.Eve.Token.IconButton" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDeleteBanner" style="@style/Widget.Eve.Token.Button.Destructive" android:layout_width="wrap_content" android:layout_height="@dimen/design_touch_min" android:layout_marginStart="@dimen/design_row_gap" android:text="Delete" />
    </LinearLayout>
</com.eve.app.designsystem.DesignCardView>