<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/eve_card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/eve_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivBannerThumb"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:adjustViewBounds="true"
            android:background="@color/eve_surface_variant"
            android:contentDescription="Banner thumbnail"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeCircle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBannerOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="Banner #1"
                android:textColor="@color/eve_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvBannerDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins"
                android:text="Uploaded today"
                android:textColor="@color/eve_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Up / Down Reorder buttons -->
        <ImageButton
            android:id="@+id/btnMoveUp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Move up"
            android:src="@drawable/ic_back"
            android:rotation="90"
            app:tint="@color/eve_text" />

        <ImageButton
            android:id="@+id/btnMoveDown"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Move down"
            android:src="@drawable/ic_back"
            android:rotation="270"
            app:tint="@color/eve_text" />

        <!-- Delete button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteBanner"
            style="@style/Widget.Eve.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/poppins_medium"
            android:paddingHorizontal="10dp"
            android:text="Delete"
            android:textColor="@color/eve_red"
            android:textSize="11sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
