<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/Widget.Eve.Token.Screen">

    <!-- Existing Telegram-style Profile editor hierarchy; no custom overlay. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/design_touch_min"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        style="@style/Widget.Eve.Token.ToolbarRow">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/design_touch_min"
            android:layout_height="@dimen/design_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/telegram_type_primary" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            style="@style/TextAppearance.Eve.Telegram.NavigationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Bio" />

        <ImageButton
            android:id="@+id/btnDone"
            android:layout_width="@dimen/design_touch_min"
            android:layout_height="@dimen/design_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Save bio"
            android:src="@drawable/ic_ab_done"
            app:tint="@color/telegram_type_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp">

        <EditText
            android:id="@+id/etBio"
            style="@style/TextAppearance.Eve.Telegram.EditInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="96dp"
            android:gravity="top|start"
            android:background="@null"
            android:hint="Write a short bio"
            android:textColorHint="@color/telegram_type_secondary"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="160"
            android:minLines="3"
            android:maxLines="6"
            android:scrollbars="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent" />

        <TextView
            android:id="@+id/tvCount"
            style="@style/TextAppearance.Eve.Telegram.EditHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="8dp"
            android:text="0/160" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/TextAppearance.Eve.Telegram.EditHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:textColor="@color/telegram_text_red_bold" />

        <TextView
            style="@style/TextAppearance.Eve.Telegram.EditHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Your bio is optional. It is stored with your authenticated profile." />
    </LinearLayout>
</LinearLayout>
