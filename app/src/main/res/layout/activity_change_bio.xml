<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/Widget.Eve.Token.Screen">

    <!-- Telegram ActionBar (56dp height, 54dp back/done frames, 18dp title start) -->
    <com.eve.app.designsystem.TelegramActionBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/telegram_action_bar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            style="@style/Widget.Eve.Token.ToolbarRow">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/telegram_action_bar_back_width"
                android:layout_height="match_parent"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@color/telegram_type_primary"
                style="@style/Widget.Eve.Token.IconButton" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                style="@style/TextAppearance.Eve.Telegram.NavigationTitle"
                android:tag="eve_telegram_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/telegram_action_bar_title_start"
                android:layout_weight="1"
                android:text="Bio" />

            <ImageButton
                android:id="@+id/btnDone"
                android:layout_width="@dimen/telegram_action_bar_back_width"
                android:layout_height="match_parent"
                android:contentDescription="Save bio"
                android:src="@drawable/ic_ab_done"
                app:tint="@color/telegram_type_primary"
                style="@style/Widget.Eve.Token.IconButton" />
        </LinearLayout>
    </com.eve.app.designsystem.TelegramActionBar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="21dp"
        android:paddingTop="20dp">

        <EditText
            android:id="@+id/etBio"
            style="@style/TextAppearance.Eve.Telegram.EditInput"
            android:tag="eve_telegram_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:gravity="top|start"
            android:background="@null"
            android:hint="Write a short bio"
            android:textColorHint="@color/telegram_type_secondary"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:scrollbars="vertical" />

        <View
            android:id="@+id/lineBio"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent" />

        <TextView
            android:id="@+id/tvCount"
            style="@style/TextAppearance.Eve.Telegram.EditHelp"
            android:tag="eve_telegram_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="8dp"
            android:text="160" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/TextAppearance.Eve.Telegram.EditHelp"
            android:tag="eve_telegram_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:textColor="@color/telegram_text_red_bold" />

        <TextView
            style="@style/TextAppearance.Eve.Telegram.EditHelp"
            android:tag="eve_telegram_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:text="Your bio is optional. It is stored with your authenticated profile." />
    </LinearLayout>
</LinearLayout>
