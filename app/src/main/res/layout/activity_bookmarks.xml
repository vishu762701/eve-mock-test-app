<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/eve_system_grouped_background">

    <!-- Top App Bar -->
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:minHeight="56dp" android:background="@android:color/transparent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/design_screen_margin" android:paddingVertical="8dp">

        <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="?attr/eveLabelPrimary" style="@style/Widget.Eve.Token.IconButton"/>

        <View android:layout_width="@dimen/design_zero" android:layout_height="@dimen/design_zero" android:layout_weight="1"/></LinearLayout>
</com.eve.app.ui.common.EveGlassToolbar>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/design_screen_margin" android:paddingBottom="@dimen/design_section_gap"><TextView style="@style/TextAppearance.Eve.Token.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bookmarked Questions"/>

            <TextView android:id="@+id/tvBookmarkCount" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" tools:text="3 questions saved" tools:visibility="visible"/>
        </LinearLayout><TextView android:id="@+id/tvOfflineBanner" style="@style/TextAppearance.Eve.Test.OfflineBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/eve_offline_bg" android:gravity="center" android:paddingVertical="6dp" android:text="@string/offline_banner_text" android:textColor="@color/eve_offline_text" android:visibility="gone"/>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/eve_system_grouped_background" android:clipToPadding="false" android:clipChildren="false">

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvBookmarks" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:layoutAnimation="@anim/layout_enter" android:paddingTop="8dp" android:paddingBottom="16dp" android:background="@color/eve_system_grouped_background" android:clipChildren="false"/>

        <LinearLayout android:id="@+id/progressGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:visibility="gone">

            <ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <TextView style="@style/TextAppearance.Eve.Footnote" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Loading bookmarks…"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/messageGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:padding="24dp" android:visibility="gone">

            <com.airbnb.lottie.LottieAnimationView android:id="@+id/ivMessageIcon" android:layout_width="160dp" android:layout_height="160dp" android:background="@android:color/transparent" app:lottie_autoPlay="false" app:lottie_loop="false" app:lottie_rawRes="@raw/search"/>

            <TextView android:id="@+id/tvMessage" style="@style/TextAppearance.Eve.Headline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="No bookmarks yet"/>

            <TextView android:id="@+id/tvMessageSub" style="@style/TextAppearance.Eve.Footnote" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Questions bookmarked during tests will appear here for review."/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnRetry" style="@style/Widget.Eve.Button.Soft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Retry" android:visibility="gone"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>