<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ns2="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    style="@style/Widget.Eve.Token.Screen">

    <com.eve.app.ui.common.EveGlassToolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/telegram_action_bar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            style="@style/Widget.Eve.Token.ToolbarRow">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/telegram_action_bar_back_width"
                android:layout_height="match_parent"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@color/telegram_type_primary"
                style="@style/Widget.Eve.Token.IconButton" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.Eve.Telegram.NavigationTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/telegram_action_bar_title_start"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Premium"
                android:tag="eve_telegram_type" />
        </LinearLayout>
    </com.eve.app.ui.common.EveGlassToolbar>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false"
        style="@style/Widget.Eve.Token.Column">

        <com.eve.app.designsystem.TelegramRadialProgressView
            android:id="@+id/progressBar"
            android:layout_width="@dimen/design_ring_size"
            android:layout_height="@dimen/design_ring_size"
            android:layout_gravity="center"
            android:visibility="visible" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:clipChildren="false"
            style="@style/Widget.Eve.Token.Scroll">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                style="@style/Widget.Eve.Token.Column">

                <!-- Non-premium state (plan details + benefits + subscribe button) -->
                <LinearLayout
                    android:id="@+id/layoutNotPremium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    style="@style/Widget.Eve.Token.Column">

                    <!-- Header with Telegram Premium star icon and titles -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="16dp"
                        android:paddingBottom="12dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        style="@style/Widget.Eve.Token.Column">

                        <FrameLayout
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:clipToPadding="false"
                            android:clipChildren="false"
                            style="@style/Widget.Eve.Token.Column">

                            <ImageView
                                android:id="@+id/starViewNotPremium"
                                android:layout_width="@dimen/design_icon_size"
                                android:layout_height="@dimen/design_icon_size"
                                android:src="@drawable/ic_star_outline"
                                app:tint="@color/accent_icon"
                                android:layout_gravity="center" />
                        </FrameLayout>

                        <com.eve.app.designsystem.UiArcTextRevealView
                            android:id="@+id/tvPlanTitle"
                            style="@style/TextAppearance.Eve.Token.Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/design_card_gap"
                            android:text="EVE Premium" />

                        <TextView
                            android:id="@+id/tvPlanDescription"
                            style="@style/TextAppearance.Eve.Token.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            android:gravity="center"
                            android:text="Unlock all eligible tests &amp; unlimited reattempts without the 3-attempt restriction." />
                    </LinearLayout>

                    <!-- Section header per Telegram HeaderCell.java (21dp padding) -->
                    <TextView
                        style="@style/TextAppearance.Eve.Token.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="21dp"
                        android:paddingEnd="21dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="4dp"
                        android:text="Premium Benefits" />

                    <!-- Flat benefits list styled as Telegram PremiumFeatureCell -->
                    <LinearLayout
                        android:id="@+id/layoutBenefitsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        style="@style/Widget.Eve.Token.Column" />

                    <!-- Price & plan details -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="16dp"
                        android:paddingBottom="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        style="@style/Widget.Eve.Token.Column">

                        <TextView
                            android:id="@+id/tvPrice"
                            style="@style/TextAppearance.Eve.Token.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            ns2:text="₹99" />

                        <TextView
                            android:id="@+id/tvValidity"
                            style="@style/TextAppearance.Eve.Token.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            ns2:text="Validity: 30 Days" />

                        <TextView
                            android:id="@+id/tvPaymentMethodsNote"
                            style="@style/TextAppearance.Eve.Token.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Supported: QR Code • UPI App" />
                    </LinearLayout>

                    <!-- Telegram Premium Gradient Button per PremiumButtonView.java -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnBuyPremium"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginStart="21dp"
                        android:layout_marginEnd="21dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/telegram_premium_button_selector"
                        android:textColor="@color/white"
                        android:textAllCaps="false"
                        style="@style/TextAppearance.Eve.Token.Button"
                        android:text="Buy Premium" />
                </LinearLayout>

                <!-- Premium active state -->
                <LinearLayout
                    android:id="@+id/layoutPremiumActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    style="@style/Widget.Eve.Token.Column">

                    <!-- Active header with star -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="20dp"
                        android:paddingBottom="12dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        style="@style/Widget.Eve.Token.Column">

                        <FrameLayout
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:clipToPadding="false"
                            android:clipChildren="false"
                            style="@style/Widget.Eve.Token.Column">

                            <ImageView
                                android:id="@+id/starViewPremiumActive"
                                android:layout_width="@dimen/design_icon_size"
                                android:layout_height="@dimen/design_icon_size"
                                android:src="@drawable/ic_star_outline"
                                app:tint="@color/accent_icon"
                                android:layout_gravity="center" />
                        </FrameLayout>

                        <com.eve.app.designsystem.UiArcTextRevealView
                            android:id="@+id/tvActiveTitle"
                            style="@style/TextAppearance.Eve.Token.Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/design_screen_margin"
                            android:text="Premium Active" />

                        <TextView
                            android:id="@+id/tvActiveExpiry"
                            style="@style/TextAppearance.Eve.Token.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            ns2:text="Expires: 29 Oct 2026" />
                    </LinearLayout>

                    <!-- Active Entitlements header -->
                    <TextView
                        style="@style/TextAppearance.Eve.Token.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="21dp"
                        android:paddingEnd="21dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="4dp"
                        android:text="Active Entitlements" />

                    <!-- Active entitlements list -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="21dp"
                        android:paddingEnd="21dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        style="@style/Widget.Eve.Token.Column">

                        <TextView
                            style="@style/TextAppearance.Eve.Token.Body.green"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="✓ All eligible tests unlocked" />

                        <TextView
                            style="@style/TextAppearance.Eve.Token.Body.green"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="✓ Unlimited eligible test reattempts" />

                        <TextView
                            style="@style/TextAppearance.Eve.Token.Body.green"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp"
                            android:text="✓ 3-attempt restriction bypassed" />
                    </LinearLayout>

                    <!-- Extend plan button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnExtendPlan"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginStart="21dp"
                        android:layout_marginEnd="21dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/telegram_premium_button_selector"
                        android:textColor="@color/white"
                        android:textAllCaps="false"
                        style="@style/TextAppearance.Eve.Token.Button"
                        android:text="Extend Premium Plan" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
