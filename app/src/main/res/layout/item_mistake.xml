<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    style="@style/Widget.Eve.Card.Group"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:stateListAnimator="@animator/press_scale"
    android:minHeight="@dimen/eve_list_row_min">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Status Badge & Learned State -->
        <com.eve.app.ui.result.ResponsiveResultRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMistakeType"
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_mini"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Wrong Answer"
                android:textColor="@color/eve_status_error_text" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkLearned"
                style="@style/Widget.Eve.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:stateListAnimator="@animator/press_scale"
                android:text="Mark as learned" />
        </com.eve.app.ui.result.ResponsiveResultRow>

        <!-- Question Text -->
        <TextView
            android:id="@+id/tvQuestionText"
            style="@style/TextAppearance.Eve.Callout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/eve_text" />

        <!-- Your Answer Box (if answered) -->
        <LinearLayout
            android:id="@+id/layoutYourAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_stat_mini"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Answer:"
                android:textColor="@color/eve_status_error_text" />

            <TextView
                android:id="@+id/tvYourAnswer"
                style="@style/TextAppearance.Eve.Subheadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/eve_text" />
        </LinearLayout>

        <!-- Correct Answer Box -->
        <LinearLayout
            android:id="@+id/layoutCorrectAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_stat_mini"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correct Answer:"
                android:textColor="@color/eve_status_success_text" />

            <TextView
                android:id="@+id/tvCorrectAnswer"
                style="@style/TextAppearance.Eve.Subheadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/eve_text" />
        </LinearLayout>

        <!-- Explanation Section -->
        <LinearLayout
            android:id="@+id/layoutExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/TextAppearance.Eve.Footnote.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explanation:"
                android:textColor="?attr/eveLabelSecondary" />

            <TextView
                android:id="@+id/tvExplanation"
                style="@style/TextAppearance.Eve.Subheadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/eveLabelSecondary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
