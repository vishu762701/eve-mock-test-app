<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:stateListAnimator="@animator/press_scale"
    app:cardBackgroundColor="@color/eve_card_bg"
    app:cardCornerRadius="@dimen/eve_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/eve_separator"
    app:strokeWidth="@dimen/eve_stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Status Badge & Learned State -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMistakeType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_mini"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Wrong Answer"
                android:textColor="@color/eve_status_error"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkLearned"
                style="@style/Widget.Eve.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:stateListAnimator="@animator/press_scale"
                android:text="Mark as learned"
                android:textSize="14sp"
                app:strokeColor="@color/eve_stroke" />
        </LinearLayout>

        <!-- Question Text -->
        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <!-- Your Answer Box (if answered) -->
        <LinearLayout
            android:id="@+id/layoutYourAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_stat_mini"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Your Answer:"
                android:textColor="@color/eve_status_error"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/tvYourAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Correct Answer Box -->
        <LinearLayout
            android:id="@+id/layoutCorrectAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_stat_mini"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Correct Answer:"
                android:textColor="@color/eve_status_success"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/tvCorrectAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Explanation Section -->
        <LinearLayout
            android:id="@+id/layoutExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Explanation:"
                android:textColor="@color/eve_text_secondary"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/tvExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/eve_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
