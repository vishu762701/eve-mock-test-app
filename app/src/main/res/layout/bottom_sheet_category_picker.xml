<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" style="@style/Widget.Eve.Token.Sheet">
    <View android:layout_width="36dp" android:layout_height="5dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="@dimen/design_section_gap" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select Category" style="@style/TextAppearance.Eve.Token.Heading" />
