<?xml version="1.0" encoding="utf-8"?>
<com.eve.app.ui.result.ResponsiveResultRow
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_student_inset"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:minHeight="@dimen/eve_list_row_min">
    <TextView
        android:id="@+id/tvTopicName"
        style="@style/TextAppearance.Eve.Callout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />
    <TextView
        android:id="@+id/tvTopicResult"
        style="@style/TextAppearance.Eve.Footnote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp" />
</com.eve.app.ui.result.ResponsiveResultRow>
