<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/eve_system_grouped_background" android:orientation="vertical">

    <!-- Top App Bar -->
    <com.eve.app.ui.common.EveGlassToolbar android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/design_touch_min" android:background="@android:color/transparent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/design_screen_margin" android:paddingTop="12dp" android:paddingBottom="12dp">

        <ImageButton android:id="@+id/btnBack" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="?attr/eveLabelPrimary" style="@style/Widget.Eve.Token.IconButton"/>

        <View android:layout_width="@dimen/design_zero" android:layout_height="@dimen/design_zero" android:layout_weight="1"/></LinearLayout>
</com.eve.app.ui.common.EveGlassToolbar>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/design_screen_margin" android:paddingBottom="@dimen/design_section_gap"><TextView style="@style/TextAppearance.Eve.Token.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mistake Notebook"/>

            <TextView android:id="@+id/tvSubtitle" style="@style/TextAppearance.Eve.Token.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Review your incorrect and skipped questions"/>
        </LinearLayout><!-- Offline Banner -->
    <TextView android:id="@+id/tvOfflineBanner" style="@style/TextAppearance.Eve.Test.OfflineBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/eve_offline_bg" android:gravity="center" android:paddingVertical="6dp" android:text="You are offline. Showing cached mistakes." android:textColor="@color/eve_offline_text" android:visibility="gone"/>

    <!-- Filter Chips -->
    <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupFilters" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingVertical="8dp" app:singleSelection="true">

        <com.google.android.material.chip.Chip android:id="@+id/chipAll" style="@style/Widget.Eve.CategoryChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="All (0)"/>

        <com.google.android.material.chip.Chip android:id="@+id/chipWrong" style="@style/Widget.Eve.CategoryChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wrong (0)"/>

        <com.google.android.material.chip.Chip android:id="@+id/chipSkipped" style="@style/Widget.Eve.CategoryChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Skipped (0)"/>
    </com.google.android.material.chip.ChipGroup>

    <!-- Main Content Area -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/eve_system_grouped_background" android:clipToPadding="false" android:clipChildren="false">

        <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/>

        <!-- Empty State -->
        <LinearLayout android:id="@+id/messageGroup" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="32dp" android:visibility="gone">

            <ImageView android:id="@+id/ivEmpty" android:layout_width="120dp" android:layout_height="120dp" android:contentDescription="No mistakes" android:src="@drawable/illustration_empty_all_caught_up"/>

            <TextView android:id="@+id/tvEmptyTitle" style="@style/TextAppearance.Eve.M3.HeadlineSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="All Caught Up!" android:textColor="?attr/eveLabelPrimary" android:textStyle="bold"/>

            <TextView android:id="@+id/tvEmptySubtitle" style="@style/TextAppearance.Eve.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="No mistakes recorded. Questions you answer incorrectly or skip will automatically appear here." android:textColor="?attr/eveLabelSecondary"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMistakes" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutAnimation="@anim/layout_enter" android:clipToPadding="false" android:paddingVertical="8dp" android:background="@color/eve_system_grouped_background" android:clipChildren="false"/>
    </FrameLayout>
</LinearLayout>