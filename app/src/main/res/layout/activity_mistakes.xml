<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eve_canvas"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eve_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_translucent"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/eve_accent_text"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Eve.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mistake Notebook"
                android:textColor="?attr/eveLabelPrimary" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review your incorrect and skipped questions"
                android:textColor="?attr/eveLabelSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/eve_stroke" />

    <!-- Offline Banner -->
    <TextView
        android:id="@+id/tvOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/eve_offline_bg"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:text="You are offline. Showing cached mistakes."
        android:textColor="@color/eve_offline_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Filter Chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAll"
            style="@style/Widget.Eve.CategoryChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="All (0)" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipWrong"
            style="@style/Widget.Eve.CategoryChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wrong (0)" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSkipped"
            style="@style/Widget.Eve.CategoryChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skipped (0)" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/eve_system_grouped_background">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/messageGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivEmpty"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="No mistakes"
                android:src="@drawable/illustration_empty_all_caught_up" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                style="@style/TextAppearance.Eve.M3.HeadlineSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="All Caught Up!"
                android:textColor="?attr/eveLabelPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptySubtitle"
                style="@style/TextAppearance.Eve.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="No mistakes recorded. Questions you answer incorrectly or skip will automatically appear here."
                android:textColor="?attr/eveLabelSecondary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMistakes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutAnimation="@anim/layout_enter"
            android:clipToPadding="false"
            android:paddingVertical="8dp"
            android:background="@color/eve_system_grouped_background" />
    </FrameLayout>
</LinearLayout>
