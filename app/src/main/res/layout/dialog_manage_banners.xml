<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:clipToPadding="false">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Home Banner"
        android:textColor="@color/eve_text"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Publish image banners, manage their optional links, and reorder or remove them from the Home surface."
        android:textColor="@color/eve_text_secondary"
        android:textSize="12sp" />

    <!-- Upload Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickBannerImage"
            style="@style/Widget.Eve.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Banner Image (Max 5MB)"
            android:textSize="13sp" />

        <!-- Preview uses the same centralized footprint as the Home banner. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPreviewBanner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/eve_home_banner_height"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/eve_card_bg"
            app:cardCornerRadius="@dimen/eve_radius_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/eve_shape_border"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivPreviewBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="Banner live preview"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBannerLinkUrl"
            style="@style/Widget.Eve.TextInput.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Optional link URL">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBannerLinkUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLength="2048"
                android:maxLines="1"
                android:textColor="@color/eve_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBannerLinkLabel"
            style="@style/Widget.Eve.TextInput.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="CTA label"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBannerLinkLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="48"
                android:maxLines="1"
                android:textColor="@color/eve_text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvBannerUploadError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/eve_red"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBanner"
            style="@style/Widget.Eve.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save &amp; Publish Banner"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/eve_stroke" />

    <!-- Current Banners List -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Published banners in this Home surface"
        android:textColor="@color/eve_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvNoBanners"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="12dp"
        android:gravity="center"
        android:text="No banners uploaded yet."
        android:textColor="@color/eve_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminBanners"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="240dp"
        android:nestedScrollingEnabled="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseBannerDialog"
        style="@style/Widget.Eve.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Close" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
