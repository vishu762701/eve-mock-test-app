<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginVertical="6dp" app:cardBackgroundColor="@color/eve_card_bg" app:cardCornerRadius="@dimen/eve_radius_card" app:cardElevation="0dp" app:strokeWidth="1dp" android:minHeight="@dimen/eve_list_row_min">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

            <TextView android:id="@+id/tvExamName" style="@style/TextAppearance.Eve.Admin.ItemTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="SSC CGL 2026 Tier-1" android:textColor="@color/eve_text"/>

            <ImageButton android:id="@+id/btnMoreOptions" android:layout_width="@dimen/design_touch_min" android:layout_height="@dimen/design_touch_min" android:contentDescription="Options" android:src="@drawable/ic_more_vert" app:tint="@color/eve_text_secondary" style="@style/Widget.Eve.Token.IconButton"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">

            <TextView android:id="@+id/tvCategoryBadge" style="@style/TextAppearance.Eve.Admin.Badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_category_chip" android:paddingHorizontal="10dp" android:paddingVertical="3dp" android:text="SSC" android:textColor="@color/eve_accent_text"/>

            <TextView android:id="@+id/tvTimeLimit" style="@style/TextAppearance.Eve.Caption1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="⏱️ 60 mins" android:textColor="@color/eve_text_secondary"/>

            <TextView android:id="@+id/tvQuestionCount" style="@style/TextAppearance.Eve.Caption1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="📝 100 Qs" android:textColor="@color/eve_text_secondary"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="@color/eve_stroke"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

            <TextView android:id="@+id/tvAttemptCount" style="@style/TextAppearance.Eve.Caption1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📊 42 student attempts" android:textColor="@color/eve_text_secondary"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnQuickPreview" style="@style/Widget.Eve.TextButton" android:textAppearance="@style/TextAppearance.Eve.Caption1.Medium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="0dp" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:text="Preview"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnQuickEdit" style="@style/Widget.Eve.TextButton" android:textAppearance="@style/TextAppearance.Eve.Caption1.Medium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:minHeight="0dp" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:text="Edit"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>