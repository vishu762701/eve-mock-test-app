<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted translucent glass background with rounded right edge -->
    <item>
        <shape>
            <solid android:color="@color/eve_menu_glass_bg" />
            <corners
                android:topRightRadius="24dp"
                android:bottomRightRadius="24dp" />
        </shape>
    </item>
    <!-- Subtle 1dp glass rim highlight on outer right boundary -->
    <item
        android:left="-2dp"
        android:top="-2dp"
        android:bottom="-2dp">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/eve_menu_glass_border" />
            <corners
                android:topRightRadius="24dp"
                android:bottomRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
