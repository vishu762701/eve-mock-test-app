<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Opaque drawer surface with the shared fixed radius -->
    <item>
        <shape>
            <solid android:color="@color/eve_drawer_glass_base" />
            <corners
                android:topRightRadius="@dimen/eve_radius_card"
                android:bottomRightRadius="@dimen/eve_radius_card" />
        </shape>
    </item>
    <!-- Subtle decorative boundary on the outer right edge -->
    <item
        android:left="-2dp"
        android:top="-2dp"
        android:bottom="-2dp">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/eve_shape_border" />
            <corners
                android:topRightRadius="@dimen/eve_radius_card"
                android:bottomRightRadius="@dimen/eve_radius_card" />
        </shape>
    </item>
</layer-list>
