<?xml version="1.0" encoding="utf-8"?>
<!-- Apple iOS 26 Liquid Glass pill surface: translucent fill with light hairline highlight -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/eve_glass_card_fill" />
    <stroke
        android:width="0.5dp"
        android:color="@color/eve_glass_card_hairline" />
    <corners android:radius="@dimen/eve_radius_pill" />
</shape>
