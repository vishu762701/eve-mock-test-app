<?xml version="1.0" encoding="utf-8"?>
<!-- Apple iOS 26 Home Popup Menu Material: ~24dp blur on API 31+, ~75% tint, 1dp hairline border, 94% solid tint fallback -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/eve_radius_menu" />
    <solid android:color="@color/eve_home_menu_bg" />
    <stroke
        android:width="@dimen/eve_home_hairline_border"
        android:color="@color/eve_home_hairline_border" />
</shape>
