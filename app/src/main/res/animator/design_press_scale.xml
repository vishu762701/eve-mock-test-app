<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:duration="@integer/design_press_in_duration"
                android:valueTo="@dimen/design_press_scale" android:valueType="floatType" android:interpolator="@interpolator/design_ease_out" />
            <objectAnimator android:propertyName="scaleY" android:duration="@integer/design_press_in_duration"
                android:valueTo="@dimen/design_press_scale" android:valueType="floatType" android:interpolator="@interpolator/design_ease_out" />
        </set>
    </item>
    <item>
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:duration="@integer/design_press_out_duration"
                android:valueTo="1" android:valueType="floatType" android:interpolator="@interpolator/design_ease_out" />
            <objectAnimator android:propertyName="scaleY" android:duration="@integer/design_press_out_duration"
                android:valueTo="1" android:valueType="floatType" android:interpolator="@interpolator/design_ease_out" />
        </set>
    </item>
</selector>
