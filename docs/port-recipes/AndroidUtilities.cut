remove-statement "if (!TextUtils.isEmpty(SharedConfig.storageCacheDir)) {"

# Patches
patch-line "        if (activity == null || activity.isFinishing()) activity = LaunchActivity.instance;" "        if (activity == null || activity.isFinishing()) activity = findActivity(ApplicationLoader.applicationContext);" "fallback to applicationContext activity lookup"
patch-line "            return BitwiseUtils.hasFlag(flags, View.SYSTEM_UI_FLAG_LIGHT_NAVIGATION_BAR);" "            return (flags & View.SYSTEM_UI_FLAG_LIGHT_NAVIGATION_BAR) != 0;" "use standard bitwise check"
patch-line "        final int newFlags = BitwiseUtils.setFlag(oldFlags, flag, enable);" "        final int newFlags = enable ? (oldFlags | flag) : (oldFlags & ~flag);" "use standard bitwise check"
patch-line "            if (SharedConfig.useSystemBoldFont && Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {" "            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {" "decouple SharedConfig"
patch-line "        return ApplicationLoader.applicationContext != null && ApplicationLoader.applicationContext.getResources().getBoolean(R.bool.isTablet);" "        return false;" "phone default for tablet"
patch-line "        SharedConfig.updateTabletConfig();" "        // no-op" "decouple SharedConfig"
patch-line "        return isTabletInternal() && !SharedConfig.forceDisableTabletMode;" "        return isTabletInternal();" "decouple SharedConfig"

prune-imports
