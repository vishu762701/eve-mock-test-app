remove-statement "lockImageView.setAnimation(R.raw.tsv_setup_intro, 120, 120);"
remove-statement "lockImageView.setAutoRepeat(false);"
remove-statement "lockImageView.playAnimation();"
patch-line "private final RLottieImageView imageView;" "private final ImageView imageView;" "use ImageView in header holder without RLottie"
patch-line "imageView = new RLottieImageView(context);" "imageView = new ImageView(context); imageView.setImageResource(R.drawable.msg_pin_code); imageView.setColorFilter(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText4), PorterDuff.Mode.SRC_IN);" "show lock icon in settings header without RLottie"
remove-statement "imageView.setOnClickListener(v -> {"
remove-statement "holderView.imageView.setAnimation(R.raw.utyan_passcode, 100, 100);"
remove-statement "holderView.imageView.playAnimation();"

# Cut GramWallet rows (Telegram-only feature)
remove-statement "if (getMessagesController().config.walletAvailable.get()) {"
remove-statement "final GramWallet wallet = GramWallet.getInstance(currentAccount);" all
remove-statement "wallet.setNeedsPasscode(!wallet.needsPasscode());"
remove-statement "((TextCheckCell) view).setChecked(wallet.needsPasscode());"
remove-statement "final boolean isLocked = wallet.needsFingerprint();"
remove-statement "wallet.setNeedsFingerprint(!isLocked, success -> {"
remove-statement "textCell.setTextAndCheck(LocaleController.getString(R.string.WalletConfirmWithFingerprint), GramWallet.getInstance(currentAccount).canSend() && GramWallet.getInstance(currentAccount).needsFingerprint(), false);"
remove-statement "textCell.setTextAndCheck(LocaleController.getString(R.string.WalletConfirmWithPasscode), GramWallet.getInstance(currentAccount).needsPasscode(), false);"

# Persist settings via Eve SharedConfig bridge instead of UserConfig.saveConfig
remove-statement "UserConfig.getInstance(currentAccount).saveConfig(false);" all
patch-line "SharedConfig.useFingerprintLock = !SharedConfig.useFingerprintLock;" "SharedConfig.useFingerprintLock = !SharedConfig.useFingerprintLock; SharedConfig.saveConfig();" "persist fingerprint toggle via Eve SharedConfig bridge"
patch-line "SharedConfig.allowScreenCapture = !SharedConfig.allowScreenCapture;" "SharedConfig.allowScreenCapture = !SharedConfig.allowScreenCapture; SharedConfig.saveConfig();" "persist screen capture toggle via Eve SharedConfig bridge"
patch-line "listAdapter.notifyItemChanged(position);" "SharedConfig.saveConfig(); listAdapter.notifyItemChanged(position);" "persist auto-lock timeout via Eve SharedConfig bridge"

# Replace AlertsCreator with standard AlertDialog.Builder
patch-line "AlertsCreator.showSimpleAlert(PasscodeActivity.this, LocaleController.getString(R.string.ScreenCaptureAlert));" "new AlertDialog.Builder(getParentActivity()).setMessage(LocaleController.getString(R.string.ScreenCaptureAlert)).setPositiveButton(LocaleController.getString(R.string.OK), null).show();" "show simple alert without AlertsCreator"
patch-line "forgotPasswordButton.setOnClickListener(v -> AlertsCreator.createForgotPasscodeDialog(context).show());" "forgotPasswordButton.setOnClickListener(v -> new AlertDialog.Builder(context).setTitle(LocaleController.getString(R.string.ForgotPasscode)).setMessage(LocaleController.getString(R.string.PasscodeReinstallNotice)).setPositiveButton(LocaleController.getString(R.string.OK), null).show());" "show forgot passcode dialog without AlertsCreator"

# Save plaintext passcode into Eve PasscodeManager bridge before SharedConfig.saveConfig()
patch-line "SharedConfig.passcodeType = currentPasswordType;" "SharedConfig.passcodeType = currentPasswordType; SharedConfig.setPlainPasscodeForSave(firstPassword);" "pass plaintext PIN/password to Eve PasscodeManager bridge"

# Direct Theme colors without ThemeBind
remove-statement "ThemeBind.textColor(textCell.getTextView(), Theme.key_windowBackgroundWhiteGrayText7);" all
remove-statement "ThemeBind.textColor(textCell.getTextView(), Theme.key_windowBackgroundWhiteBlackText);" all
patch-line "textCell.setTag(Theme.key_windowBackgroundWhiteGrayText7);" "textCell.setTag(Theme.key_windowBackgroundWhiteGrayText7); textCell.getTextView().setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText7));" "direct gray text color without ThemeBind"
patch-line "textCell.setTextAndValue(LocaleController.getString(R.string.AutoLock), val, true);" "textCell.setTextAndValue(LocaleController.getString(R.string.AutoLock), val, true); textCell.getTextView().setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));" "direct auto-lock text color without ThemeBind"
patch-line "textCell.setText(LocaleController.getString(R.string.ChangePasscode), true);" "textCell.setText(LocaleController.getString(R.string.ChangePasscode), true); textCell.getTextView().setTextColor(Theme.getColor(SharedConfig.passcodeHash.isEmpty() ? Theme.key_windowBackgroundWhiteGrayText7 : Theme.key_windowBackgroundWhiteBlackText));" "direct change passcode text color without ThemeBind"
