patch-line "ThemeBind.actionBarItemsColor(actionBar, Theme.key_windowBackgroundWhiteBlackText, false);" "actionBar.setItemsColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText), false);" "direct actionBar items color without ThemeBind"
patch-line "ThemeBind.actionBarItemsBackgroundColor(actionBar, Theme.key_actionBarWhiteSelector, false);" "actionBar.setItemsBackgroundColor(Theme.getColor(Theme.key_actionBarWhiteSelector), false);" "direct actionBar selector without ThemeBind"
patch-line "ThemeBind.textColor(titleTextView, Theme.key_windowBackgroundWhiteBlackText);" "titleTextView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));" "direct title color without ThemeBind"
patch-line "ThemeBind.textColor(tv, Theme.key_windowBackgroundWhiteGrayText6);" "tv.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText6));" "direct description color without ThemeBind"
patch-line "ThemeBind.textColor(forgotPasswordButton, Theme.key_featuredStickers_addButton);" "forgotPasswordButton.setTextColor(Theme.getColor(Theme.key_featuredStickers_addButton));" "direct forgot button color without ThemeBind"
patch-line "ThemeBind.textColor(passcodesDoNotMatchTextView, Theme.key_windowBackgroundWhiteGrayText6);" "passcodesDoNotMatchTextView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText6));" "direct mismatch text color without ThemeBind"
patch-line "ThemeBind.textColor(passwordEditText, Theme.key_windowBackgroundWhiteBlackText);" "passwordEditText.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));" "direct password text color without ThemeBind"
patch-line "ThemeBind.cursorColor(passwordEditText, Theme.key_windowBackgroundWhiteInputFieldActivated);" "passwordEditText.setCursorColor(Theme.getColor(Theme.key_windowBackgroundWhiteInputFieldActivated));" "direct cursor color without ThemeBind"
patch-line "ThemeBind.colorFilter(passwordButton, Theme.key_windowBackgroundWhiteHintText, PorterDuff.Mode.SRC_ATOP);" "passwordButton.setColorFilter(Theme.getColor(Theme.key_windowBackgroundWhiteHintText), PorterDuff.Mode.SRC_ATOP);" "direct password toggle tint without ThemeBind"
patch-line "ThemeBind.selectorBackground(passwordButton, Theme.createSelectorDrawable(getThemedColor(Theme.key_listSelector), 1), null, ThemeBind.of(Theme.key_listSelector), getResourceProvider());" "passwordButton.setBackground(Theme.createSelectorDrawable(getThemedColor(Theme.key_listSelector), 1));" "direct password toggle selector without ThemeBind"
patch-line "ThemeBind.colorFilter(passwordButton, isPasswordShown.get() ? Theme.key_windowBackgroundWhiteInputFieldActivated : Theme.key_windowBackgroundWhiteHintText, PorterDuff.Mode.SRC_ATOP);" "passwordButton.setColorFilter(Theme.getColor(isPasswordShown.get() ? Theme.key_windowBackgroundWhiteInputFieldActivated : Theme.key_windowBackgroundWhiteHintText), PorterDuff.Mode.SRC_ATOP);" "direct password toggle active tint without ThemeBind"
