upstream org/telegram/ui/PasscodeActivity.java
to app/src/main/java/org/telegram/ui/PasscodeActivity.java

# Route SharedConfig to Eve CUT-INTERFACE adapter backed by PasscodeManager
patch-line "import org.telegram.messenger.SharedConfig;" "import com.eve.app.ui.settings.SharedConfig;" "bridge SharedConfig passcode state to Eve PasscodeManager"

# Remove NotificationCenter, simpleActionBar, glass, and onThemeColorsChanged methods
remove-method useSimpleActionBar
remove-method didReceivedNotification
remove-method onThemeColorsChanged
remove-method getListViewForSimpleGlass
remove-method addThemeColorKeys

# Remove NotificationCenterDelegate and wire Eve navigator override for presentFragment
patch-line "public class PasscodeActivity extends BaseFragment implements NotificationCenter.NotificationCenterDelegate {" "public class PasscodeActivity extends BaseFragment { public interface EvePasscodeNavigator { void openPasscodeMode(int mode); } private EvePasscodeNavigator eveNavigator; private View simpleActionBar; public void setEveNavigator(EvePasscodeNavigator nav) { this.eveNavigator = nav; } @Override public boolean presentFragment(BaseFragment fragment) { if (eveNavigator != null && fragment instanceof PasscodeActivity) { eveNavigator.openPasscodeMode(((PasscodeActivity) fragment).type); return true; } return super.presentFragment(fragment); } @Override public boolean presentFragment(BaseFragment fragment, boolean removeLast) { if (eveNavigator != null && fragment instanceof PasscodeActivity) { eveNavigator.openPasscodeMode(((PasscodeActivity) fragment).type); return true; } return super.presentFragment(fragment, removeLast); }" "remove NotificationCenterDelegate and route PasscodeActivity navigation through Eve host"
remove-statement "NotificationCenter.getGlobalInstance().addWeakObserver(this, NotificationCenter.didSetPasscode);"
remove-statement "NotificationCenter.getGlobalInstance().removeObserver(this, NotificationCenter.didSetPasscode);"
remove-statement "NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.didSetPasscode);" all
remove-statement "NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.didSetPasscode, false);"
remove-statement "getMediaDataController().buildShortcuts();" all

# Use standard BaseFragment ActionBar instead of simpleActionBar
remove-statement "if (simpleActionBar != null) {"
patch-line "View fragmentContentView;" "actionBar.setBackButtonImage(R.drawable.ic_ab_back); actionBar.setAllowOverlayTitle(false); actionBar.setActionBarMenuOnItemClick(onItemClick); View fragmentContentView;" "configure BaseFragment actionBar for all passcode modes"
remove-statement "setHasOwnBackground(true);"
patch-line "simpleActionBar.setTitle(LocaleController.getString(R.string.Passcode));" "actionBar.setTitle(LocaleController.getString(R.string.Passcode)); actionBar.setBackButtonImage(R.drawable.ic_ab_back); actionBar.setActionBarMenuOnItemClick(onItemClick);" "configure BaseFragment actionBar for settings mode"

# Replace SizeNotifierFrameLayout with FrameLayout (measureKeyboardHeight -> 0)
patch-line "SizeNotifierFrameLayout contentView = new SizeNotifierFrameLayout(context) {" "FrameLayout contentView = new FrameLayout(context) { private int measureKeyboardHeight() { return 0; } public void notifyHeightChanged() {}" "use FrameLayout without SizeNotifierFrameLayout"
remove-statement "        contentView.setDelegate((keyboardHeight, isWidthGreater) -> {"

