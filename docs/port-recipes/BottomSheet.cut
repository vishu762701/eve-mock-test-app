# Standard TextView instead of AnimatedEmojiSpan.TextViewEmojis & direct Theme colors without ThemeBind
patch-line "private AnimatedEmojiSpan.TextViewEmojis textView;" "private TextView textView;" "use standard TextView without AnimatedEmojiSpan"
patch-line "textView = new AnimatedEmojiSpan.TextViewEmojis(context);" "textView = new TextView(context); textView.setTextColor(getThemedColor(Theme.key_dialogTextBlack));" "use standard TextView with direct text color"
patch-line "public AnimatedEmojiSpan.TextViewEmojis getTextView() {" "public TextView getTextView() {" "use standard TextView"
patch-line "ThemeBind.colorFilter(imageView, Theme.key_dialogIcon, resourcesProvider, PorterDuff.Mode.MULTIPLY);" "imageView.setColorFilter(new PorterDuffColorFilter(getThemedColor(Theme.key_dialogIcon), PorterDuff.Mode.MULTIPLY));" "direct icon color filter without ThemeBind"
patch-line "ThemeBind.colorFilter(imageView2, Theme.key_radioBackgroundChecked, resourcesProvider, PorterDuff.Mode.SRC_IN);" "imageView2.setColorFilter(new PorterDuffColorFilter(getThemedColor(Theme.key_radioBackgroundChecked), PorterDuff.Mode.SRC_IN));" "direct icon2 color filter without ThemeBind"
remove-statement "ThemeBind.textColor(textView, Theme.key_dialogTextBlack, resourcesProvider);" all
patch-line "ThemeBind.textColor(textView, Theme.key_featuredStickers_buttonText, resourcesProvider);" "textView.setTextColor(getThemedColor(Theme.key_featuredStickers_buttonText));" "direct button text color without ThemeBind"
patch-line "ThemeBind.textColor(titleView, Theme.key_dialogTextBlack, resourcesProvider);" "titleView.setTextColor(getThemedColor(Theme.key_dialogTextBlack));" "direct title color without ThemeBind"
patch-line "ThemeBind.textColor(titleView, Theme.key_dialogTextGray2, resourcesProvider);" "titleView.setTextColor(getThemedColor(Theme.key_dialogTextGray2));" "direct title color without ThemeBind"

