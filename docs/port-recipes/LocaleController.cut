patch-line "        return localeInfo == null || TextUtils.isEmpty(localeInfo.name) ? getString(\"LanguageName\", R.string.LanguageName) : localeInfo.name;" "        return localeInfo == null || TextUtils.isEmpty(localeInfo.name) ? \"English\" : localeInfo.name;" "use default language name"
patch-line "            String value = BuildVars.USE_CLOUD_STRINGS ? getInstance().localizationExternal.getByResName(param) : null;" "            String value = getInstance().getStringInternal(param, key + \"_other\", 0);" "resolve plural with fallback from resources"
patch-line "                value = BuildVars.USE_CLOUD_STRINGS ? getInstance().localizationExternal.getByResName(key + \"_other\") : null;" "                // no-op" "skip cloud strings fallback"
patch-line "                    value = getInstance().getLocalizedString(param);" "                    // no-op" "skip internal localization lookup"
patch-line "                value = getInstance().getLocalizedString(key + \"_other\");" "                // no-op" "skip internal localization lookup"
