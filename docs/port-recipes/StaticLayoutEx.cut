upstream org/telegram/ui/Components/StaticLayoutEx.java
to app/src/main/java/org/telegram/ui/Components/StaticLayoutEx.java

patch-line ".setEllipsize(stringBuilder.getSpans(0, stringBuilder.length(), AnimatedEmojiSpan.class).length > 0 ? null : ellipsize)" ".setEllipsize(ellipsize)" "cut AnimatedEmojiSpan"
prune-imports
