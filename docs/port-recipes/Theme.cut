# Patches for Eve environment
patch-line "        SharedPreferences preferences = MessagesController.getGlobalMainSettings();" "        SharedPreferences preferences = ApplicationLoader.applicationContext != null ? ApplicationLoader.applicationContext.getSharedPreferences(\\"mainconfig\\", Context.MODE_PRIVATE) : null;" "use app shared preferences"
patch-line "    private static boolean[] loadingRemoteThemes = new boolean[UserConfig.MAX_ACCOUNT_COUNT];" "    private static boolean[] loadingRemoteThemes = new boolean[4];" "use fixed account count"
patch-line "        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {" "        for (int a = 0; a < 4; a++) {" "use fixed account count in static loop"
patch-line "public static class ThemeInfo implements NotificationCenter.NotificationCenterDelegate {" "public static class ThemeInfo {" "decouple NotificationCenter from ThemeInfo"
patch-line "            return SharedConfig.compactMode;" "            return false;" "decouple SharedConfig from isCompactMode"
patch-line "        return resourcesProvider != null ? resourcesProvider.isCompactMode() : SharedConfig.compactMode;" "        return resourcesProvider != null && resourcesProvider.isCompactMode();" "decouple SharedConfig"
patch-line "        if (SharedConfig.compactMode) {" "        if (false) {" "decouple SharedConfig from getColor"
patch-line "        if (drawable == null) {" "        if (drawable != null) { drawable.setColorFilter(new PorterDuffColorFilter(color, PorterDuff.Mode.MULTIPLY)); } if (drawable == null) {" "apply color filter to drawable"

