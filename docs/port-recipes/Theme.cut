patch-line "    public static int getColor(int key) {" "    public static void syncFromEvePalette(android.content.Context context) { if (currentTheme == null) { currentTheme = currentDayTheme != null ? currentDayTheme : defaultTheme; } if (context == null) return; try { com.eve.app.theme.TelegramThemeEngine.ResolvedPalette palette = com.eve.app.theme.TelegramThemeEngine.INSTANCE.resolveCurrentPalette(context); if (palette != null) { if (palette.isDark() && currentNightTheme != null) { currentTheme = currentNightTheme; } else if (currentDayTheme != null) { currentTheme = currentDayTheme; } else { currentTheme = defaultTheme; } currentColors.put(key_windowBackgroundGray, palette.getWindowBackground()); currentColors.put(key_windowBackgroundWhite, palette.getSurface()); currentColors.put(key_windowBackgroundWhiteBlackText, palette.getTextPrimary()); currentColors.put(key_windowBackgroundWhiteGrayText, palette.getTextSecondary()); currentColors.put(key_actionBarDefault, palette.getSurface()); currentColors.put(key_actionBarDefaultTitle, palette.getTextPrimary()); currentColors.put(key_actionBarDefaultIcon, palette.getTextPrimary()); currentColors.put(key_actionBarDefaultSelector, palette.getActionSelector()); currentColors.put(key_divider, palette.getHairline()); } } catch (Throwable ignored) {} if (dividerPaint == null) { dividerPaint = new Paint(); dividerPaint.setStrokeWidth(1); } dividerPaint.setColor(getColor(key_divider)); } public static int getColor(int key) {" "sync Telegram theme colors and active currentTheme from Eve palette"

