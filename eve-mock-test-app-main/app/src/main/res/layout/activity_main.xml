<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/eve_bg" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/eve_surface" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="20dp" android:paddingVertical="14dp">
        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivProfile" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_circle_translucent" android:contentDescription="Profile" android:padding="9dp" android:src="@drawable/ic_person" app:shapeAppearanceOverlay="@style/ShapeCircle" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eve" android:textColor="@color/eve_text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/tvWelcome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hi, Student" android:textColor="@color/eve_text" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout android:layout_width="42dp" android:layout_height="42dp" android:background="@color/eve_surface_variant">
            <ImageButton android:id="@+id/btnNotification" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Notifications" android:padding="10dp" android:src="@drawable/ic_bell" android:tint="@color/eve_text" />
            <View android:id="@+id/dotUnread" android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="top|end" android:layout_marginTop="8dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_dot_red" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
    <TextView android:id="@+id/tvOfflineBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/eve_offline_bg" android:gravity="center" android:paddingVertical="7dp" android:text="@string/offline_banner_text" android:textColor="@color/eve_offline_text" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Find your next test" android:textColor="@color/eve_text" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Choose a test or continue building your streak." android:textColor="@color/eve_text_secondary" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnHistory" style="@style/Widget.Eve.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="History" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPerformance" style="@style/Widget.Eve.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="Performance" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPractice" style="@style/Widget.Eve.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Practice" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPyq" style="@style/Widget.Eve.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="PYQ" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAdmin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Admin Dashboard" android:visibility="gone" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="20dp" android:paddingBottom="8dp" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" app:chipSpacingHorizontal="8dp" app:singleLine="true" app:singleSelection="true" />
    </HorizontalScrollView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvExams" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:layoutAnimation="@anim/layout_enter" android:paddingHorizontal="16dp" android:paddingBottom="24dp" />
        <LinearLayout android:id="@+id/progressGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:visibility="gone"><ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Exams load ho rahe hain…" android:textColor="@color/eve_text_secondary" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/messageGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:padding="28dp" android:visibility="gone"><ImageView android:id="@+id/ivMessageIcon" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_state_empty" /><TextView android:id="@+id/tvMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:textColor="@color/eve_text" android:textSize="17sp" android:textStyle="bold" /><TextView android:id="@+id/tvMessageSub" android:layout_width="260dp" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/eve_text_secondary" android:textSize="13sp" /><com.google.android.material.button.MaterialButton android:id="@+id/btnRetry" style="@style/Widget.Eve.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Try again" android:visibility="gone" /></LinearLayout>
    </FrameLayout>
</LinearLayout>
